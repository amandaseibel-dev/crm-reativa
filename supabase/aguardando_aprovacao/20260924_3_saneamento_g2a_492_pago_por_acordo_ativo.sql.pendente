  ('feb6e318-ffa1-4b2d-911d-d2af6bc18d77'::uuid, 'b931e8c7-4839-4f98-9fb8-5442984d7eaa'::uuid, 1422.42::numeric, 121924::bigint),
  ('fed78ca9-3b78-416f-a050-4a4527d226e5'::uuid, 'cd2aaa24-fe74-42e6-b2ac-99d9682195f0'::uuid, 1433.69::numeric, 122634::bigint),
  ('ff580331-eb3e-4bba-aa59-536440f2546e'::uuid, '19c9562a-e186-4640-b348-83e0e5d0f5d0'::uuid, 997.75::numeric, 141347::bigint),
  ('ffca2d79-7333-410c-905a-b27449d53f90'::uuid, '8c804f86-8ca1-4803-8122-d1963ed83f9a'::uuid, 1242.51::numeric, 121912::bigint)
;

-- ---------------------------------------------------------------------------
-- 2) GUARDS. As quatro evidencias sao RECALCULADAS aqui. Qualquer divergencia
--    aborta a transacao inteira -- nada fica pela metade.
-- ---------------------------------------------------------------------------
do $$
declare v_qtd int; v_soma numeric; v_falha int;
begin
  -- 2.1 a lista chegou inteira
  select count(*) into v_qtd from _g2a_lista;
  if v_qtd <> 492 then
    raise exception 'ABORTA: lista com % linhas, esperado 492', v_qtd;
  end if;

  -- 2.2 todo titulo existe
  select count(*) into v_falha from _g2a_lista l
   where not exists (select 1 from public.acordos_titulos t where t.id = l.titulo_id);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) da lista nao existem mais', v_falha;
  end if;

  -- 2.3 estado anterior esperado: PAGO / quitada
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where upper(coalesce(t.situacao,'')) <> 'PAGO' or lower(coalesce(t.status,'')) <> 'quitada';
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) nao estao mais PAGO/quitada', v_falha;
  end if;

  -- 2.4 acordo_id inalterado; nao e boleto do proprio acordo
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.acordo_id is distinct from l.acordo_id or coalesce(t.tipo_boleto,'') = 'Acordo';
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) trocaram de acordo ou sao boleto do proprio acordo', v_falha;
  end if;

  -- 2.5 vinculo vivo, UNICO, apontando para o MESMO acordo
  select count(*) into v_falha
    from _g2a_lista l
   where (select count(*) from public.acordo_titulo_vinculo v join public.acordos ac on ac.id = v.acordo_id
           where v.titulo_id = l.titulo_id and coalesce(v.ativo, true)
             and upper(coalesce(ac.status,'')) not in ('CANCELADO','CANCELADA')) <> 1
      or not exists (select 1 from public.acordo_titulo_vinculo v
                      where v.titulo_id = l.titulo_id and v.acordo_id = l.acordo_id
                        and coalesce(v.ativo, true));
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) sem vinculo vivo unico para o acordo esperado', v_falha;
  end if;

  -- 2.6 o acordo continua ATIVO (a negociacao segue em andamento)
  select count(*) into v_falha
    from (select distinct acordo_id from _g2a_lista) x
    join public.acordos a on a.id = x.acordo_id
   where upper(coalesce(a.status,'')) <> 'ATIVO';
  if v_falha > 0 then
    raise exception 'ABORTA: % acordo(s) nao estao mais ATIVO', v_falha;
  end if;

  -- 2.7 O EVENTO e o mesmo que foi auditado, e ainda e a ULTIMA entrada em PAGO
  select count(*) into v_falha
    from _g2a_lista l
   where not exists (select 1 from public.audit_log al
                      where al.id = l.audit_id_pago and al.tabela = 'acordos_titulos'
                        and al.registro_id = l.titulo_id::text
                        and upper(coalesce(al.dados_depois->>'situacao','')) = 'PAGO'
                        and upper(coalesce(al.dados_antes->>'situacao','')) <> 'PAGO')
      or exists (select 1 from public.audit_log al2
                  where al2.tabela='acordos_titulos' and al2.registro_id = l.titulo_id::text
                    and al2.id > l.audit_id_pago
                    and upper(coalesce(al2.dados_depois->>'situacao','')) = 'PAGO'
                    and upper(coalesce(al2.dados_antes->>'situacao','')) <> 'PAGO');
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) com evento de quitacao diferente do auditado', v_falha;
  end if;

  -- 2.8 EVIDENCIA 1 -- assinatura de conteudo: A1 (motivo nomeia este acordo)
  --     ou A2 (assinatura exata de titulos_por_status_acordo). Nada mais passa.
  select count(*) into v_falha
    from _g2a_lista l
    join public.audit_log al on al.id = l.audit_id_pago
    join public.acordos a on a.id = l.acordo_id
   where not (
     -- A1
     ((select array_to_string(array_agg(k order by k),',') from jsonb_each(al.dados_depois) e(k,v)
        where al.dados_antes->k is distinct from v) = 'atualizado_em,motivo_ajuste,situacao,status'
      and position('quitada junto com o acordo ' || a.numero_acordo::text
                   in coalesce(al.dados_depois->>'motivo_ajuste','')) > 0
      and position('quitada junto com o acordo ' || a.numero_acordo::text
                   in coalesce(al.dados_antes->>'motivo_ajuste','')) = 0)
     or
     -- A2
     ((select array_to_string(array_agg(k order by k),',') from jsonb_each(al.dados_depois) e(k,v)
        where al.dados_antes->k is distinct from v)
        in ('atualizado_em,situacao,status','atualizado_em,situacao')
      and coalesce(al.dados_antes->>'motivo_ajuste','') = coalesce(al.dados_depois->>'motivo_ajuste',''))
   );
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) sem assinatura A1 nem A2 no evento de quitacao', v_falha;
  end if;

  -- 2.9 EVIDENCIA 2 -- ordem: o evento do titulo cai na JANELA do seu acordo
  --     (depois do evento do proprio acordo e antes do proximo acordo quitado
  --      na mesma transacao). Descarta backfill em bloco.
  select count(*) into v_falha
    from _g2a_lista l
    join public.audit_log al on al.id = l.audit_id_pago
   where not exists (
           select 1 from public.audit_log la
            where la.tabela='acordos' and la.registro_id = l.acordo_id::text
              and la.criado_em = al.criado_em
              and upper(coalesce(la.dados_depois->>'status','')) = 'QUITADO'
              and la.id < al.id
              and not exists (
                select 1 from public.audit_log lb
                 where lb.tabela='acordos' and lb.criado_em = al.criado_em
                   and upper(coalesce(lb.dados_depois->>'status','')) = 'QUITADO'
                   and lb.registro_id <> l.acordo_id::text
                   and lb.id > la.id and lb.id < al.id));
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) fora da janela de gatilho do proprio acordo', v_falha;
  end if;

  -- 2.10 EVIDENCIA 3 -- nenhum valor tocado, nem no evento nem depois
  select count(*) into v_falha
    from _g2a_lista l
    join public.audit_log al on al.id = l.audit_id_pago
   where al.dados_antes->'saldo_corrigido' is distinct from al.dados_depois->'saldo_corrigido'
      or al.dados_antes->'valor_em_aberto' is distinct from al.dados_depois->'valor_em_aberto'
      or exists (select 1 from public.audit_log l3
                  where l3.tabela='acordos_titulos' and l3.registro_id = l.titulo_id::text
                    and l3.id > l.audit_id_pago
                    and (l3.dados_antes->'saldo_corrigido' is distinct from l3.dados_depois->'saldo_corrigido'
                      or l3.dados_antes->'valor_em_aberto' is distinct from l3.dados_depois->'valor_em_aberto'));
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) tiveram valor mexido (quitacao manual) -- NAO reabrir', v_falha;
  end if;

  -- 2.11 EVIDENCIA 4 -- nenhum registro independente de pagamento
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.origem_liquidacao is not null
      or t.origem_encerramento is not null
      or exists (select 1 from public.pagamentos pg
                  where coalesce(pg.titulo_numero,'') <> ''
                    and regexp_replace(coalesce(t.documento,''),'\D','','g') <> ''
                    and regexp_replace(pg.titulo_numero,'\D','','g')
                        = regexp_replace(coalesce(t.documento,''),'\D','','g'))
      or exists (select 1 from public.conferencia_pagamentos cp
                  where coalesce(cp.titulo_numero,'') <> ''
                    and regexp_replace(coalesce(t.documento,''),'\D','','g') <> ''
                    and regexp_replace(cp.titulo_numero,'\D','','g')
                        = regexp_replace(coalesce(t.documento,''),'\D','','g'))
      or exists (select 1 from public.solicitacoes_confirmacao_pagamento s where s.titulo_id = t.id);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) tem registro independente de pagamento -- NAO reabrir', v_falha;
  end if;

  -- 2.12 soma financeira e valor por titulo identicos aos validados
  select round(sum(coalesce(t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0)), 2) into v_soma
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id;
  if v_soma <> 830042.13 then
    raise exception 'ABORTA: soma % diferente da validada 830042.13', v_soma;
  end if;

  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where round(coalesce(t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0), 2)
         <> round(l.valor_esperado, 2);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) mudaram de valor desde a validacao', v_falha;
  end if;

  -- 2.13 a populacao FORA da lista continua sendo exatamente as excecoes
  select count(*) into v_falha
    from public.acordos_titulos t join public.acordos a on a.id = t.acordo_id
   where upper(coalesce(t.situacao,''))='PAGO' and upper(coalesce(a.status,''))='ATIVO'
     and t.id not in (select titulo_id from _g2a_lista);
  if v_falha <> 46 then
    raise exception 'ABORTA: fora da lista ha % titulos PAGO em acordo ATIVO, esperado 46 (C 17 + D 21 + E1 5 + E2 3)', v_falha;
  end if;

  raise notice 'GUARDS OK: 492 titulos, R$ 830.042,13, 145 acordos ATIVO; 4 evidencias de causalidade conferidas; 46 excecoes preservadas';
end $$;

-- ---------------------------------------------------------------------------
-- 3) BACKUP POR ID -- registro completo antes, vinculos, acordo, motivo
-- ---------------------------------------------------------------------------
create table if not exists public._backup_saneamento_g2a_20260924 (
  titulo_id uuid primary key,
  registro_anterior jsonb not null,
  vinculos_anteriores jsonb not null,
  acordo_id uuid,
  acordo_numero text,
  acordo_status_no_backup text,
  situacao_anterior text,
  status_anterior text,
  acordo_id_anterior uuid,
  origem_liquidacao_anterior text,
  origem_liquidacao_ref_anterior text,
  origem_liquidacao_em_anterior timestamptz,
  origem_encerramento_anterior text,
  quitacao_origem_anterior text,
  quitacao_origem_acordo_id_anterior uuid,
  motivo_ajuste_anterior text,
  audit_id_pago bigint,
  prova_auditoria_em timestamptz,
  prova_assinatura text,
  motivo_correcao text not null,
  feito_em timestamptz not null default now()
);

insert into public._backup_saneamento_g2a_20260924 (
  titulo_id, registro_anterior, vinculos_anteriores, acordo_id, acordo_numero,
  acordo_status_no_backup, situacao_anterior, status_anterior, acordo_id_anterior,
  origem_liquidacao_anterior, origem_liquidacao_ref_anterior, origem_liquidacao_em_anterior,
  origem_encerramento_anterior, quitacao_origem_anterior, quitacao_origem_acordo_id_anterior,
  motivo_ajuste_anterior, audit_id_pago, prova_auditoria_em, prova_assinatura, motivo_correcao)
select t.id, to_jsonb(t),
       coalesce((select jsonb_agg(to_jsonb(v)) from public.acordo_titulo_vinculo v where v.titulo_id = t.id), '[]'::jsonb),
       a.id, a.numero_acordo::text, a.status,
       t.situacao, t.status, t.acordo_id,
       t.origem_liquidacao, t.origem_liquidacao_ref, t.origem_liquidacao_em,
       t.origem_encerramento, t.quitacao_origem, t.quitacao_origem_acordo_id,
       t.motivo_ajuste, l.audit_id_pago, al.criado_em,
       (select array_to_string(array_agg(k order by k),',') from jsonb_each(al.dados_depois) e(k,v)
         where al.dados_antes->k is distinct from v),
       'G2-A 24/09/2026: quitada por consequencia do acordo (assinatura da funcao + janela de gatilho + zero mexida em valor + zero registro independente de pagamento); o acordo voltou a ATIVO e a negociacao segue em andamento. Devolvida a NEGOCIADO/vinculada pelo motor titulo_reavaliar.'
  from _g2a_lista l
  join public.acordos_titulos t on t.id = l.titulo_id
  join public.acordos a on a.id = l.acordo_id
  join public.audit_log al on al.id = l.audit_id_pago
on conflict (titulo_id) do nothing;

do $$
declare v_qtd int;
begin
  select count(*) into v_qtd from public._backup_saneamento_g2a_20260924;
  if v_qtd <> 492 then
    raise exception 'ABORTA: backup com % linhas, esperado 492', v_qtd;
  end if;
end $$;

-- ---------------------------------------------------------------------------
-- 3b) FOTO DAS PARCELAS ANTES -- para provar, no passo 5, que nenhuma parcela
--     de acordo foi tocada
-- ---------------------------------------------------------------------------
create temporary table _g2a_parcelas_antes on commit drop as
select p.id, p.acordo_id, p.status, p.valor, p.pago_em
  from public.parcelas p
 where p.acordo_id in (select distinct acordo_id from _g2a_lista);

-- ---------------------------------------------------------------------------
-- 4) A CORRECAO
--    4a) grava a proveniencia comprovada
--    4b) deixa o motor oficial decidir o que fazer com ela
-- ---------------------------------------------------------------------------
update public.acordos_titulos t
   set quitacao_origem = 'ACORDO',
       quitacao_origem_acordo_id = l.acordo_id,
       quitacao_origem_em = b.prova_auditoria_em,
       atualizado_em = now()
  from _g2a_lista l
  join public._backup_saneamento_g2a_20260924 b on b.titulo_id = l.titulo_id
 where t.id = l.titulo_id;

do $$
declare v_id uuid; v_n int := 0;
begin
  for v_id in select titulo_id from _g2a_lista order by titulo_id loop
    perform public.titulo_reavaliar(v_id);
    v_n := v_n + 1;
  end loop;
  raise notice 'titulo_reavaliar executado em % titulos', v_n;
end $$;

-- ---------------------------------------------------------------------------
-- 5) VALIDACAO AUTOMATICA
-- ---------------------------------------------------------------------------
do $$
declare v_ok int; v_falha int;
begin
  -- 5.1 os 492 ficaram NEGOCIADO/vinculada
  select count(*) into v_ok
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where upper(coalesce(t.situacao,'')) = 'NEGOCIADO' and lower(coalesce(t.status,'')) = 'vinculada';
  if v_ok <> 492 then
    raise exception 'ABORTA: % de 492 ficaram NEGOCIADO/vinculada', v_ok;
  end if;

  -- 5.2 vinculo e acordo_id preservados
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.acordo_id is distinct from l.acordo_id;
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) perderam o acordo_id', v_falha;
  end if;

  select count(*) into v_falha
    from _g2a_lista l
   where not exists (select 1 from public.acordo_titulo_vinculo v
                      where v.titulo_id = l.titulo_id and v.acordo_id = l.acordo_id
                        and coalesce(v.ativo, true));
  if v_falha > 0 then
    raise exception 'ABORTA: % vinculo(s) sumiram', v_falha;
  end if;

  -- 5.3 proveniencia limpa (ela so vale enquanto o titulo esta pago)
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.quitacao_origem is not null;
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) ficaram com proveniencia pendurada', v_falha;
  end if;

  -- 5.4 nenhum valor mexido
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where round(coalesce(t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0), 2)
         <> round(l.valor_esperado, 2);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) tiveram valor alterado', v_falha;
  end if;

  -- 5.5 nenhuma marca de pagamento criada ou apagada
  select count(*) into v_falha
    from _g2a_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.origem_liquidacao is not null or t.origem_encerramento is not null;
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) ganharam marca de liquidacao/encerramento', v_falha;
  end if;

  -- 5.6 nenhuma parcela dos 145 acordos foi tocada -- diferenca simetrica
  --     (EXCEPT nos dois sentidos) contra a foto do passo 3b
  select count(*) into v_falha from (
      select id, acordo_id, status, valor, pago_em from _g2a_parcelas_antes
      except
      select id, acordo_id, status, valor, pago_em from public.parcelas
       where acordo_id in (select distinct acordo_id from _g2a_lista)
  ) d;
  if v_falha > 0 then
    raise exception 'ABORTA: % parcela(s) sumiram ou mudaram durante a correcao', v_falha;
  end if;

  select count(*) into v_falha from (
      select id, acordo_id, status, valor, pago_em from public.parcelas
       where acordo_id in (select distinct acordo_id from _g2a_lista)
      except
      select id, acordo_id, status, valor, pago_em from _g2a_parcelas_antes
  ) d;
  if v_falha > 0 then
    raise exception 'ABORTA: % parcela(s) novas ou alteradas durante a correcao', v_falha;
  end if;

  -- 5.7 nenhum acordo mudou de status
  select count(*) into v_falha
    from (select distinct acordo_id from _g2a_lista) x
    join public.acordos a on a.id = x.acordo_id
   where upper(coalesce(a.status,'')) <> 'ATIVO';
  if v_falha > 0 then
    raise exception 'ABORTA: % acordo(s) mudaram de status', v_falha;
  end if;

  -- 5.8 as excecoes continuam intactas: 46 titulos PAGO em acordo ATIVO
  select count(*) into v_falha
    from public.acordos_titulos t join public.acordos a on a.id = t.acordo_id
   where upper(coalesce(t.situacao,'')) = 'PAGO' and upper(coalesce(a.status,'')) = 'ATIVO';
  if v_falha <> 46 then
    raise exception 'ABORTA: sobraram % titulos PAGO em acordo ATIVO, esperado 46 (C 17 + D 21 + E1 5 + E2 3)', v_falha;
  end if;

  raise notice 'VALIDACAO OK: 492 NEGOCIADO/vinculada; vinculos, valores, parcelas e acordos intactos; 46 excecoes preservadas';
end $$;


-- ---------------------------------------------------------------------------
-- 5) FOTOGRAFIA DO ESTADO DEIXADO -- o que o rollback vai conferir depois
-- ---------------------------------------------------------------------------
-- Sem isto, o rollback so consegue perguntar "o titulo esta no estado que eu
-- esperava deixar?", e essa pergunta e fraca: outra coisa pode ter reescrito o
-- registro e chegado no mesmo par (situacao, status) com motivo, acordo ou
-- proveniencia diferentes -- e o rollback sobrescreveria por cima.
--
-- Aqui, ainda DENTRO da transacao da correcao, gravamos:
--   . o registro inteiro depois (`registro_pos`) e cada campo que o rollback
--     vai sobrescrever (`*_pos`);
--   . a MARCA-D'AGUA do audit_log (`audit_log_id_pos`): o maior audit_log.id
--     deste titulo neste instante. Os eventos da propria correcao ja estao
--     gravados, entao qualquer id MAIOR que este veio depois de nos.
--
-- O rollback exige os dois: igualdade campo a campo E ausencia de evento
-- posterior relevante. Se `audit_log_id_pos` vier nulo, ele aborta inteiro em
-- vez de cair no teste fraco.
alter table public._backup_saneamento_g2a_20260924
  add column if not exists registro_pos jsonb,
  add column if not exists situacao_pos text,
  add column if not exists status_pos text,
  add column if not exists acordo_id_pos uuid,
  add column if not exists motivo_ajuste_pos text,
  add column if not exists quitacao_origem_pos text,
  add column if not exists quitacao_origem_acordo_id_pos uuid,
  add column if not exists quitacao_origem_em_pos timestamptz,
  add column if not exists origem_liquidacao_pos text,
  add column if not exists origem_encerramento_pos text,
  add column if not exists saldo_corrigido_pos numeric,
  add column if not exists valor_em_aberto_pos numeric,
  add column if not exists audit_log_id_pos bigint,
  add column if not exists fotografado_em timestamptz;

update public._backup_saneamento_g2a_20260924 b
   set registro_pos = to_jsonb(t),
       situacao_pos = t.situacao,
       status_pos = t.status,
       acordo_id_pos = t.acordo_id,
       motivo_ajuste_pos = t.motivo_ajuste,
       quitacao_origem_pos = t.quitacao_origem,
       quitacao_origem_acordo_id_pos = t.quitacao_origem_acordo_id,
       quitacao_origem_em_pos = t.quitacao_origem_em,
       origem_liquidacao_pos = t.origem_liquidacao,
       origem_encerramento_pos = t.origem_encerramento,
       saldo_corrigido_pos = t.saldo_corrigido,
       valor_em_aberto_pos = t.valor_em_aberto,
       audit_log_id_pos = (
         select max(l.id) from public.audit_log l
          where l.tabela = 'acordos_titulos' and l.registro_id = t.id::text),
       fotografado_em = now()
  from public.acordos_titulos t
 where t.id = b.titulo_id;

do $$
declare v_sem int;
begin
  select count(*) into v_sem from public._backup_saneamento_g2a_20260924
   where registro_pos is null or audit_log_id_pos is null;
  if v_sem > 0 then
    raise exception 'ABORTA: % linha(s) do backup ficaram sem fotografia posterior -- o rollback nao teria com o que comparar', v_sem;
  end if;
  raise notice 'fotografia posterior gravada para % titulo(s)', (select count(*) from public._backup_saneamento_g2a_20260924);
end $$;

commit;
