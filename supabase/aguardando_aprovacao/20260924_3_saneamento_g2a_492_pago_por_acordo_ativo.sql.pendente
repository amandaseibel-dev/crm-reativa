-- ============================================================================
-- 3/4 -- SANEAMENTO G2-A: 492 mensalidades quitadas POR CONSEQUENCIA de acordo
--        que depois voltou a ficar ATIVO. Só o grupo A. C, D, E1 e E2 ficam.
-- ============================================================================
-- NAO APLICAR SEM APROVACAO. Exige o arquivo 1 (estrutural) ja aplicado.
--
-- ---------------------------------------------------------------------------
-- OS 538 "PAGO em acordo ATIVO", SEPARADOS POR PROVA DE CAUSALIDADE
-- ---------------------------------------------------------------------------
--   A1  173 | 57 acordos | R$ 173.773,28  motivo do titulo NOMEIA este acordo
--   A2  319 | 88 acordos | R$ 656.268,85  assinatura exata de titulos_por_status_acordo
--   ----------------------------------------------------------------
--   A   492 | 145 acordos | 145 alunos | R$ 830.042,13   <= SO ESTE ENTRA
--
--   B     0                                  pagamento/baixa propria (nao existe)
--   C    17 | 14 acordos | R$ 6.030,79       boleto do proprio acordo
--   D    21 | 10 acordos | R$ 8.181,97       quitado pela liquidacao Prime (portador 195)
--   E1    5 |  1 acordo  | R$ 0,00           quitacao manual que zerou o valor
--   E2    3 |  1 acordo  | R$ 0,00           intervencao posterior mexeu no valor
--   ----------------------------------------------------------------
--       538 titulos | R$ 844.254,89
--
-- ---------------------------------------------------------------------------
-- POR QUE "MESMA TRANSACAO" NAO BASTA -- E O QUE FOI FEITO NO LUGAR
-- ---------------------------------------------------------------------------
-- `audit_log.criado_em` tem DEFAULT now(), que em Postgres e o timestamp da
-- TRANSACAO. Timestamp igual prova que os dois UPDATEs estao na mesma
-- transacao -- e SO ISSO. Nao diz qual causou qual, e nao exclui um terceiro
-- processo que tenha escrito os dois. A primeira versao desta correcao parava
-- aqui e teria levado junto 8 titulos que NAO foram quitados pelo acordo.
--
-- O que sustenta cada titulo do grupo A sao QUATRO evidencias, todas exigidas
-- ao mesmo tempo, e todas recalculadas como guard na hora da execucao:
--
--  (1) CONTEUDO: o conjunto exato de campos que aquele UPDATE alterou casa com
--      a assinatura de UMA funcao conhecida, e so uma:
--        A1 -> (atualizado_em, motivo_ajuste, situacao, status) e o motivo
--              GANHOU o texto 'quitada junto com o acordo <N>' com <N> sendo o
--              numero DESTE acordo. A funcao escreve o numero do acordo que
--              disparou -- a propria linha diz quem a causou.
--        A2 -> (atualizado_em, situacao, status) ou (atualizado_em, situacao),
--              com motivo INALTERADO. E a assinatura de
--              `titulos_por_status_acordo`, a unica funcao que quita titulo
--              escrevendo so `situacao` (o `status` vem do gatilho de coerencia
--              `_titulo_situacao_e_status_coerentes`; nas linhas de agosto,
--              anteriores a esse gatilho, o status nem mudou). E o WHERE dela e
--              literalmente `v.acordo_id = new.id`: ela so toca titulo vinculado
--              AO ACORDO QUE ACABOU DE VIRAR QUITADO.
--
--  (2) ORDEM / IDENTIFICADORES: `audit_log.id` e sequencial. O evento do titulo
--      esta DEPOIS do evento do seu acordo e ANTES do evento do PROXIMO acordo
--      quitado na mesma transacao -- a "janela" do seu acordo. E o padrao de
--      gatilho: o UPDATE do titulo roda dentro dos AFTER triggers do UPDATE
--      daquele acordo. Um backfill em bloco (`update acordos...; update
--      acordos_titulos...`) colocaria TODOS os titulos depois de TODOS os
--      acordos. Medido: 0 titulo fora da janela, 0 titulo escrito antes do seu
--      acordo. (Varias dessas transacoes quitaram 78, 111 e 140 acordos de uma
--      vez -- lote de rotina; a intercalacao e o que prova que quem escreveu o
--      titulo foi o gatilho de cada acordo, e nao o lote.)
--
--  (3) NENHUM VALOR FOI TOCADO, nem naquele evento nem depois. Quitacao manual
--      pela tela (`quitar_e_encerrar_caso`) zera `saldo_corrigido` e
--      `valor_em_aberto` no mesmo UPDATE -- assinatura inconfundivel. Quem tem
--      qualquer mexida em valor, no evento ou em qualquer evento posterior,
--      esta FORA (grupos E1 e E2).
--
--  (4) NENHUM REGISTRO INDEPENDENTE DE LIQUIDACAO: `origem_liquidacao` e
--      `origem_encerramento` nulas, nenhum casamento em `pagamentos.titulo_numero`
--      nem em `conferencia_pagamentos.titulo_numero`, nenhuma linha em
--      `solicitacoes_confirmacao_pagamento.titulo_id`. Vale para os 538.
--
-- Nao sobrou nenhum titulo com assinatura desconhecida: 538 = 492 + 46, sem
-- resto. Se sobrasse, estaria listado como excecao, nao dentro do lote.
--
-- ---------------------------------------------------------------------------
-- AS EXCECOES, NOMEADAS
-- ---------------------------------------------------------------------------
-- C (17) -- boleto do proprio acordo, `tipo_boleto = 'Acordo'`. Nao e
--   mensalidade. `_titulo_quita_com_o_acordo` ja os exclui desde 20260831140000;
--   entraram porque `titulos_por_status_acordo` nao tinha o filtro (corrigido no
--   arquivo 1). Documentos todos no padrao 05xxxxxxxxxx, saldo_corrigido 0,00.
--
-- D (21) -- quitados em 09/09/2026 12:44:23.75972 UTC, todos na mesma
--   transacao, com `acordo_id` sendo GRAVADO no mesmo UPDATE e motivo
--   "vinculado pelo Prime: liquidado no portador 195 junto com as outras
--   mensalidades". NAO existe evento de acordo->QUITADO nessa transacao: nao
--   foi o acordo que os quitou, foi a regra de liquidacao da Prime. Evidencia
--   independente de pagamento -- exatamente o que nao se pode desfazer aqui.
--
-- E1 (5) -- Sandra Thalyta Barros de Melo, acordo 2922, 24/08/2026 13:09:05.
--   O UPDATE zerou `saldo_corrigido` (de R$ 1.409,30 / 1.409,32 / 1.043,94 para
--   0,00) e o motivo termina em "(reconciliacao 24/08: quitar tudo havia
--   falhado por timeout) por amanda.seibel@aelbra.com.br". Foi decisao de
--   reconciliacao, nao consequencia do acordo.
--   e375b5f2-ed46-471a-8e32-722112955878  doc 4206257
--   3db898c6-4b07-413c-b0bf-73bd350ed9b9  doc 4206258
--   79fc2b94-c0e5-442a-b3f3-2afc4713a68d  doc 4206259
--   caa68f25-17c9-4f49-a50e-1111ee7ceb08  doc 4206260
--   5bc36b6c-199f-4ab7-a51e-922ee9d56642  doc 4206261
--
-- E2 (3) -- Gabriel Rocha Mota, acordo 2681. O titulo virou PAGO pelo acordo,
--   mas em 31/08/2026 um evento POSTERIOR (amanda.seibel) gravou
--   status='quitada' zerando `saldo_corrigido` e `valor_em_aberto`. O estado de
--   hoje tem duas causas sobrepostas; reabrir devolveria uma mensalidade
--   negociada com valor zero. Fica para decisao separada.
--   e1127398-25c3-43b7-b588-61baadf0691f  doc 4302176
--   6e05eb54-089e-4be7-b8a2-644a7cf2d33b  doc 4302177
--   9c78e1e8-0da7-42ec-b0b5-61032e8b475c  doc 4302178
--
-- ---------------------------------------------------------------------------
-- COMO A CORRECAO E FEITA: gravando a prova e deixando o motor decidir
-- ---------------------------------------------------------------------------
--   1) grava em cada titulo a proveniencia comprovada (`quitacao_origem`,
--      `quitacao_origem_acordo_id`, `quitacao_origem_em` = o instante do evento);
--   2) chama `public.titulo_reavaliar(id)` -- o motor oficial do arquivo 1 --
--      que ve proveniencia de acordo + acordo nao quitado e devolve o titulo
--      para NEGOCIADO/vinculada, limpando a proveniencia.
-- Nenhum UPDATE de situacao escrito a mao. Se o motor discordar de um so, a
-- validacao aborta a transacao inteira.
--
-- EFEITO NO SALDO: NENHUM. PAGO esta fora do saldo; NEGOCIADO com vinculo vivo
-- tambem (as duas funcoes de saldo excluem por NOT EXISTS de vinculo vivo).
-- Muda o rotulo na ficha e muda `carteira_2026_1_classificar`, onde
-- situacao = 'PAGO' conta como EFETIVIDADE -- R$ 830.042,13 saem de "pago" e
-- voltam para "negociado".
--
-- ROLLBACK: 20260924_3_saneamento_g2a_..._rollback.sql (mesma pasta)
-- ============================================================================

begin;

-- ---------------------------------------------------------------------------
-- 0) PRE-REQUISITO: o arquivo 1 tem de estar aplicado
-- ---------------------------------------------------------------------------
do $$
begin
  if not exists (select 1 from information_schema.columns
                  where table_schema='public' and table_name='acordos_titulos'
                    and column_name='quitacao_origem') then
    raise exception 'ABORTA: rode antes o arquivo 1 (estrutural) -- coluna quitacao_origem nao existe';
  end if;
  if (select pg_get_functiondef(p.oid) from pg_proc p join pg_namespace n on n.oid=p.pronamespace
       where n.nspname='public' and p.proname='titulo_reavaliar') not like '%quitacao_origem%' then
    raise exception 'ABORTA: titulo_reavaliar ainda e a versao antiga -- rode o arquivo 1 primeiro';
  end if;
end $$;

-- ---------------------------------------------------------------------------
-- 1) A LISTA. Fechada, conferida por ID em 24/09/2026. 492 linhas.
--    A 4a coluna e o `audit_log.id` do evento que levou o titulo a PAGO --
--    a prova fica amarrada ao EVENTO, nao so ao titulo.
-- ---------------------------------------------------------------------------
create temporary table _g2a_lista (
  titulo_id uuid primary key,
  acordo_id uuid not null,
  valor_esperado numeric not null,
  audit_id_pago bigint not null
) on commit drop;

