-- =====================================================================
-- WHATSAPP: CONTINUIDADE v2 — ancorada no HISTÓRICO REAL DE MENSAGENS
-- Preparada em 09/11/2026. NÃO APLICADA. Aguarda aprovação da Amanda.
--
-- Substitui a abordagem da v1 (20261030090000), que ancorava em
-- whatsapp_abordagens e por isso NÃO cobria o caso real: `RESPOSTA`
-- retorna ANTES do INSERT naquela tabela, então conversa que estava viva
-- como resposta e esfriou não tem linha de abordagem nenhuma.
-- Medido: a v1 cobriria 1 de 5 casos de 09/11 e ~9% dos últimos 7 dias.
--
-- A v2 lê whatsapp_mensagens: envio anterior do MESMO operador na MESMA
-- conversa, qualquer que tenha sido a classificação dele.
--
-- -----------------------------------------------------------------
-- REGRA: CONTINUIDADE exige as CINCO condições, todas:
--   1. existe SAIDA anterior do mesmo operador nesta conversa
--      (whatsapp_mensagens, qualquer classificação, inclusive RESPOSTA)
--   2. o aluno já respondeu ao menos uma vez nesta conversa
--   3. a última ENTRADA do aluno está dentro de continuidade_janela_horas
--      -> ÂNCORA NÃO RENOVÁVEL: o operador não consegue criar uma ENTRADA
--   4. o operador fez MENOS de continuidade_max_sem_resposta envios desde
--      a última ENTRADA -> teto de insistência
--   5. a conversa não está arquivada E não está ENCERRADO
--      -> arquivamento e encerramento são EIXOS INDEPENDENTES neste schema:
--         whatsapp_arquivar_conversa não toca status;
--         whatsapp_reabrir_conversa não toca arquivada_em.
--         Checar só um dos dois deixaria um furo.
--
-- HIERARQUIA (CONTINUIDADE entra após FORA_DA_JANELA):
--   MODO_PAUSADO -> INTERVALO_MINIMO -> RESPOSTA(24h) ->
--   SOMENTE_RESPOSTAS -> FORA_DA_JANELA -> CONTINUIDADE -> NOVA_ABORDAGEM
--   Restrições do canal continuam prevalecendo sobre continuidade.
--
-- CONCORRÊNCIA: o `SELECT ... FOR UPDATE` na linha do canal, no topo da
--   função, é mantido INTACTO e permanece ANTES de qualquer contagem e do
--   INSERT. Toda checagem de cadência do mesmo canal serializa nele, então
--   dois envios simultâneos não podem ambos passar do limite. CONTINUIDADE
--   retorna antes do INSERT mas DEPOIS do lock — também serializada.
--
-- O QUE NÃO MUDA, DE PROPÓSITO:
--   * resposta_janela_horas segue 24 (decisão da Amanda em 09/11)
--   * limite_abordagens_operador e teto_abordagens_operador NÃO são tocados
--     (a v1 embutia 2->5 e 3->5; fica fora: é decisão separada)
--   * intervalo mínimo 60s, janela 08:00-20:00, teto global do canal
--   * whatsapp_cadencia_liberacoes e as cotas individuais
--   * modo SOMENTE_RESPOSTAS e sua semântica
--   * UNIQUE (canal_id, conversa_id, dia) em whatsapp_abordagens
--
-- IMPACTO SIMULADO sobre dados reais (233 abordagens / 30 dias, Comercial),
-- aplicando as CINCO condições:
--   CONTINUIDADE (isenta de cota) ............................  12  (5,2%)
--   NOVA_ABORDAGEM — cond.1, operador nunca enviou ...........  176
--   NOVA_ABORDAGEM — cond.3, resposta do aluno há mais de 72h .  22
--   NOVA_ABORDAGEM — cond.2, aluno nunca respondeu ...........  15
--   NOVA_ABORDAGEM — cond.4, teto de insistência .............   4
--   NOVA_ABORDAGEM — cond.5, arquivada ou encerrada ..........   4
--
-- Os 22 da cond.3 são as "conversas antigas": seguem consumindo cota.
-- Em 09/11, 3 dos 5 casos relatados viram CONTINUIDADE. O percentual de 30
-- dias é baixo porque 176 das 233 são abordagens genuinamente novas — mas com
-- cota base de 2, isentar 1 ou 2 por operador por dia é a diferença entre
-- trabalhar e travar.
--
-- RESSALVA da simulação: a cond.5 foi avaliada com o estado ATUAL de
-- arquivada_em/status, não com o estado no instante de cada abordagem —
-- o schema não guarda histórico desses dois campos.
--
-- IDEMPOTENTE E FALHA FECHADO.
-- Rollback versionado ao lado.
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. Parâmetros em whatsapp_config
-- ---------------------------------------------------------------------
ALTER TABLE public.whatsapp_config
  ADD COLUMN IF NOT EXISTS continuidade_janela_horas integer NOT NULL DEFAULT 72;

ALTER TABLE public.whatsapp_config
  ADD COLUMN IF NOT EXISTS continuidade_max_sem_resposta integer NOT NULL DEFAULT 3;

ALTER TABLE public.whatsapp_config
  DROP CONSTRAINT IF EXISTS ck_whatsapp_config_continuidade_janela;
ALTER TABLE public.whatsapp_config
  ADD CONSTRAINT ck_whatsapp_config_continuidade_janela
  CHECK (continuidade_janela_horas >= 0);

ALTER TABLE public.whatsapp_config
  DROP CONSTRAINT IF EXISTS ck_whatsapp_config_continuidade_max;
ALTER TABLE public.whatsapp_config
  ADD CONSTRAINT ck_whatsapp_config_continuidade_max
  CHECK (continuidade_max_sem_resposta >= 0);

COMMENT ON COLUMN public.whatsapp_config.continuidade_janela_horas IS
  'Horas, contadas da ULTIMA MENSAGEM DO ALUNO (ENTRADA.timestamp_wa), dentro das quais o re-envio do mesmo operador na mesma conversa e CONTINUIDADE (isento de cota). Ancora nao renovavel: o operador nao cria ENTRADA. 0 desliga a classificacao. Padrao 72.';

COMMENT ON COLUMN public.whatsapp_config.continuidade_max_sem_resposta IS
  'Maximo de envios do operador, na mesma conversa, desde a ultima ENTRADA do aluno, que ainda contam como CONTINUIDADE. Atingido o valor, o proximo envio volta a ser NOVA_ABORDAGEM e consome cota. 0 desliga a continuidade. Padrao 3.';

-- ---------------------------------------------------------------------
-- 2. INTERVALO_MINIMO na constraint de motivo dos bloqueios
--    O motivo já é levantado pela função desde 25/08/2026 e a constraint
--    atual o recusa — o log falha calado.
-- ---------------------------------------------------------------------
ALTER TABLE public.whatsapp_cadencia_bloqueios
  DROP CONSTRAINT IF EXISTS ck_whatsapp_bloqueio_motivo;
ALTER TABLE public.whatsapp_cadencia_bloqueios
  ADD CONSTRAINT ck_whatsapp_bloqueio_motivo CHECK (motivo IN (
    'MODO_PAUSADO', 'MODO_SOMENTE_RESPOSTAS', 'FORA_DA_JANELA',
    'LIMITE_OPERADOR', 'LIMITE_CANAL', 'INTERVALO_MINIMO'));

-- ---------------------------------------------------------------------
-- 3. whatsapp_cadencia_checar com CONTINUIDADE v2
--    Corpo integral, lido da definição viva em produção em 09/11/2026.
-- ---------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.whatsapp_cadencia_checar(
  p_canal_id    uuid,
  p_conversa_id uuid,
  p_operador    text)
RETURNS text
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $function$
DECLARE
  v_canal          public.whatsapp_canais%ROWTYPE;
  v_agora          timestamptz := now();
  v_hoje           date        := (v_agora AT TIME ZONE 'America/Sao_Paulo')::date;
  v_hora           time        := (v_agora AT TIME ZONE 'America/Sao_Paulo')::time;
  v_resposta       boolean;
  v_op             integer;
  v_ch             integer;
  v_extra          integer := 0;
  v_limite_op      integer;
  v_intervalo      integer;
  v_janela_h       integer;
  v_cont_h         integer;
  v_cont_max       integer;
  v_ultimo         timestamptz;
  v_faltam         integer;
  v_ult_entrada    timestamptz;
  v_tem_saida_dele boolean;
  v_sem_resposta   integer;
  v_conv_bloqueada boolean;
BEGIN
  -- Lock da linha do canal: serializa toda a cadência deste canal.
  -- Fica ANTES de qualquer contagem, de CONTINUIDADE e do INSERT.
  SELECT * INTO v_canal FROM public.whatsapp_canais WHERE id = p_canal_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'canal inexistente'; END IF;

  IF v_canal.modo = 'PAUSADO' THEN
    RAISE EXCEPTION 'o numero % esta pausado: nenhuma mensagem sai por ele', v_canal.apelido
      USING ERRCODE = '42501', DETAIL = 'MODO_PAUSADO';
  END IF;

  SELECT COALESCE(intervalo_minimo_envio_seg, 60),
         COALESCE(resposta_janela_horas, 24),
         COALESCE(continuidade_janela_horas, 72),
         COALESCE(continuidade_max_sem_resposta, 3)
    INTO v_intervalo, v_janela_h, v_cont_h, v_cont_max
    FROM public.whatsapp_config LIMIT 1;
  v_intervalo := COALESCE(v_intervalo, 60);
  v_janela_h  := COALESCE(v_janela_h, 24);
  v_cont_h    := COALESCE(v_cont_h, 72);
  v_cont_max  := COALESCE(v_cont_max, 3);

  -- RITMO: vale para abordagem E resposta, porque o WhatsApp olha o ritmo
  -- do numero, nao a nossa classificacao. Mesma conversa nao conta.
  IF v_intervalo > 0 THEN
    SELECT max(m.criado_em) INTO v_ultimo
      FROM public.whatsapp_mensagens m
      JOIN public.whatsapp_conversas cv ON cv.id = m.conversa_id
     WHERE m.direcao = 'SAIDA'
       AND lower(m.enviado_por_email) = lower(p_operador)
       AND cv.canal_id = p_canal_id
       AND m.conversa_id IS DISTINCT FROM p_conversa_id
       AND m.criado_em > v_agora - make_interval(secs => v_intervalo);

    IF v_ultimo IS NOT NULL THEN
      v_faltam := ceil(extract(epoch from (v_ultimo + make_interval(secs => v_intervalo) - v_agora)));
      RAISE EXCEPTION 'espere % segundos antes de falar com outro aluno neste numero', GREATEST(v_faltam, 1)
        USING ERRCODE = '42501', DETAIL = 'INTERVALO_MINIMO';
    END IF;
  END IF;

  -- RESPOSTA: aluno escreveu nas ultimas v_janela_h horas (24h, inalterado)
  v_resposta := p_conversa_id IS NOT NULL AND EXISTS (
    SELECT 1 FROM public.whatsapp_mensagens m
    WHERE m.conversa_id = p_conversa_id
      AND m.direcao = 'ENTRADA'
      AND m.timestamp_wa >= v_agora - make_interval(hours => v_janela_h)
  );
  IF v_resposta THEN RETURN 'RESPOSTA'; END IF;

  -- Restricoes do canal prevalecem sobre continuidade.
  IF v_canal.modo = 'SOMENTE_RESPOSTAS' THEN
    RAISE EXCEPTION 'o numero % so responde quem escreveu nas ultimas %h', v_canal.apelido, v_janela_h
      USING ERRCODE = '42501', DETAIL = 'MODO_SOMENTE_RESPOSTAS';
  END IF;

  IF v_canal.janela_inicio IS NOT NULL AND v_canal.janela_fim IS NOT NULL
     AND (v_hora < v_canal.janela_inicio OR v_hora >= v_canal.janela_fim) THEN
    RAISE EXCEPTION 'novas conversas so entre % e %, horario de Brasilia',
      to_char(v_canal.janela_inicio, 'HH24:MI'), to_char(v_canal.janela_fim, 'HH24:MI')
      USING ERRCODE = '42501', DETAIL = 'FORA_DA_JANELA';
  END IF;

  -- ===================================================================
  -- CONTINUIDADE v2 — cinco condicoes, todas obrigatorias.
  -- Nenhuma delas e renovavel por acao do operador.
  -- ===================================================================
  IF v_cont_h > 0 AND v_cont_max > 0 AND p_conversa_id IS NOT NULL THEN

    -- cond. 5: conversa nao arquivada E nao encerrada (eixos independentes)
    SELECT (cv.arquivada_em IS NOT NULL OR cv.status = 'ENCERRADO')
      INTO v_conv_bloqueada
      FROM public.whatsapp_conversas cv
     WHERE cv.id = p_conversa_id;

    IF COALESCE(v_conv_bloqueada, true) = false THEN

      -- cond. 1: existe SAIDA anterior DESTE operador nesta conversa,
      -- qualquer classificacao (e o que a v1 nao enxergava)
      SELECT EXISTS (
        SELECT 1 FROM public.whatsapp_mensagens m
        WHERE m.conversa_id = p_conversa_id
          AND m.direcao = 'SAIDA'
          AND lower(m.enviado_por_email) = lower(p_operador)
      ) INTO v_tem_saida_dele;

      -- cond. 2 e 3: aluno ja respondeu, e a ultima resposta esta na janela.
      -- ANCORA NAO RENOVAVEL: timestamp_wa de ENTRADA. O operador nao
      -- consegue produzir uma ENTRADA, logo nenhum envio dele estende isto.
      SELECT max(m.timestamp_wa) INTO v_ult_entrada
        FROM public.whatsapp_mensagens m
       WHERE m.conversa_id = p_conversa_id
         AND m.direcao = 'ENTRADA';

      IF v_tem_saida_dele
         AND v_ult_entrada IS NOT NULL
         AND v_ult_entrada >= v_agora - make_interval(hours => v_cont_h)
      THEN
        -- cond. 4: teto de insistencia desde a ultima ENTRADA do aluno
        SELECT count(*) INTO v_sem_resposta
          FROM public.whatsapp_mensagens m
         WHERE m.conversa_id = p_conversa_id
           AND m.direcao = 'SAIDA'
           AND lower(m.enviado_por_email) = lower(p_operador)
           AND m.criado_em > v_ult_entrada;

        IF v_sem_resposta < v_cont_max THEN
          -- Retorna ANTES do INSERT: nao consome cota e nao cria registro,
          -- portanto nao realimenta nenhuma janela.
          RETURN 'CONTINUIDADE';
        END IF;
      END IF;
    END IF;
  END IF;

  INSERT INTO public.whatsapp_abordagens (canal_id, conversa_id, operador_email, dia)
  VALUES (p_canal_id, p_conversa_id, lower(p_operador), v_hoje)
  ON CONFLICT (canal_id, conversa_id, dia) DO NOTHING;

  SELECT count(*) INTO v_op FROM public.whatsapp_abordagens
   WHERE canal_id = p_canal_id AND operador_email = lower(p_operador) AND dia = v_hoje;
  SELECT count(*) INTO v_ch FROM public.whatsapp_abordagens
   WHERE canal_id = p_canal_id AND dia = v_hoje;

  SELECT COALESCE(l.extra, 0) INTO v_extra FROM public.whatsapp_cadencia_liberacoes l
   WHERE l.canal_id = p_canal_id AND l.operador_email = lower(p_operador) AND l.dia = v_hoje;
  v_extra := COALESCE(v_extra, 0);
  v_limite_op := v_canal.limite_abordagens_operador + v_extra;

  IF v_canal.limite_abordagens_operador IS NOT NULL
     AND v_op > v_limite_op THEN
    RAISE EXCEPTION 'voce ja iniciou % conversas novas hoje neste numero. Responder quem escreveu nas ultimas %h continua liberado',
      v_limite_op, v_janela_h
      USING ERRCODE = '42501', DETAIL = 'LIMITE_OPERADOR';
  END IF;

  IF v_canal.limite_abordagens_canal IS NOT NULL
     AND v_ch > v_canal.limite_abordagens_canal THEN
    RAISE EXCEPTION 'o numero % ja iniciou % conversas novas hoje. Nenhum operador inicia novas ate amanha',
      v_canal.apelido, v_canal.limite_abordagens_canal
      USING ERRCODE = '42501', DETAIL = 'LIMITE_CANAL';
  END IF;

  RETURN 'NOVA_ABORDAGEM';
END;
$function$;

-- CREATE OR REPLACE restaura grants padrao: reconferir explicitamente.
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) FROM anon;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) FROM authenticated;
GRANT EXECUTE ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) TO service_role;

-- ---------------------------------------------------------------------
-- 4. Verificacao final: falha fechado se o estado nao ficou como esperado
-- ---------------------------------------------------------------------
DO $verifica$
DECLARE
  v_h integer; v_m integer; v_tem boolean; v_resp integer;
BEGIN
  SELECT continuidade_janela_horas, continuidade_max_sem_resposta, resposta_janela_horas
    INTO v_h, v_m, v_resp FROM public.whatsapp_config LIMIT 1;

  IF v_h IS NULL OR v_m IS NULL THEN
    RAISE EXCEPTION 'parametros de continuidade nao gravados' USING ERRCODE = '22023';
  END IF;

  IF v_resp IS DISTINCT FROM 24 THEN
    RAISE EXCEPTION 'resposta_janela_horas deveria seguir 24 e esta %', v_resp
      USING ERRCODE = '22023';
  END IF;

  SELECT prosrc ILIKE '%CONTINUIDADE%' INTO v_tem
    FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
   WHERE n.nspname = 'public' AND p.proname = 'whatsapp_cadencia_checar';

  IF NOT COALESCE(v_tem, false) THEN
    RAISE EXCEPTION 'funcao nao contem a clausula CONTINUIDADE' USING ERRCODE = '22023';
  END IF;

  IF has_function_privilege('authenticated',
        'public.whatsapp_cadencia_checar(uuid, uuid, text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'authenticated ganhou EXECUTE em whatsapp_cadencia_checar (proibido)' USING ERRCODE = '42501';
  END IF;

  RAISE NOTICE 'continuidade v2: janela=%h, max_sem_resposta=%, resposta=%h (inalterada)',
    v_h, v_m, v_resp;
END $verifica$;
