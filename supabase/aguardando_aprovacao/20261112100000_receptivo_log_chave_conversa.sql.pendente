-- =====================================================================
-- RECEPTIVO: chave do log passa a distinguir a CONVERSA
-- =====================================================================
-- Empilhada sobre a cota 10 (20261111150000): depende da RPC
-- fila_receptivo_registrar_atendimento que ela redefine. Aplicar DEPOIS da
-- cota 10 (a pre-condicao abaixo recusa rodar sem ela).
--
-- O PROBLEMA
--   A chave de idempotencia era (operador_email, responsavel_desde). Duas
--   conversas diferentes atribuidas ao MESMO operador com o MESMO instante
--   (mesma transacao) colidiam: a segunda era descartada e a fila nao andava.
--   Em producao nenhum caminho atual atribui duas conversas numa transacao,
--   mas a chave nao diz o que deveria dizer: conversa, operador e ciclo.
--
-- A IDENTIDADE NOVA
--   (operador_email, conversa_id, responsavel_desde), so para linhas WHATSAPP
--   com conversa e ciclo conhecidos.
--     * conversas diferentes, mesmo instante  -> contam separadamente
--     * resposta repetida/simultanea no ciclo -> conta uma vez
--     * novo ciclo (responsavel_desde novo)   -> conta de novo
--
-- HISTORICO (preservado; nada e apagado; conversa_id NAO e inventado)
--   * linhas antigas ganham conversa_id so quando o ciclo casa com UMA
--     conversa atual (candidato unico). As demais ficam com conversa_id NULL.
--   * linhas com conversa_id NULL seguem protegidas pela chave antiga, agora
--     restrita a elas (indice legado parcial).
--
-- TRANSICAO (uma transacao: tudo ou nada)
--   Log de 195 linhas: DDL dentro de uma transacao, lock curto e sob
--   lock_timeout. Sem CONCURRENTLY, que nao cabe numa transacao e nao se
--   justifica nesse volume. Escritores que esperarem mais que o lock_timeout
--   fazem a migration falhar inteira, sem estado parcial.
--   Ordem: coluna -> indices -> backfill -> funcao -> drop do indice antigo.
--   A funcao so troca de alvo de ON CONFLICT depois que o indice novo existe,
--   e o indice antigo so sai depois que nenhuma funcao depende dele.
-- =====================================================================

BEGIN;

-- 0. pre-condicao: cota 10 aplicada
DO $pre$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
     WHERE n.nspname = 'public' AND p.proname = 'whatsapp_cadencia_sem_limite_individual') THEN
    RAISE EXCEPTION 'cota 10 (20261111150000) nao esta aplicada: aplicar antes desta migration'
      USING ERRCODE = '22023';
  END IF;
END $pre$;

SET LOCAL lock_timeout = '5s';

-- 1. coluna nova (sem default: so metadado, sem reescrita da tabela)
ALTER TABLE public.receptivo_atendimentos_log
  ADD COLUMN IF NOT EXISTS conversa_id uuid NULL;

ALTER TABLE public.receptivo_atendimentos_log
  DROP CONSTRAINT IF EXISTS receptivo_atendimentos_log_conversa_fkey;
ALTER TABLE public.receptivo_atendimentos_log
  ADD CONSTRAINT receptivo_atendimentos_log_conversa_fkey
  FOREIGN KEY (conversa_id) REFERENCES public.whatsapp_conversas(id) ON DELETE SET NULL;

COMMENT ON COLUMN public.receptivo_atendimentos_log.conversa_id IS
  'Conversa do atendimento WhatsApp. NULL em linhas MANUAL e em linhas antigas '
  'cujo ciclo nao casa com uma unica conversa (nao e inventado).';

-- 2. backfill conservador: so ciclo que casa com UMA conversa atual
UPDATE public.receptivo_atendimentos_log l
   SET conversa_id = c.id
  FROM public.whatsapp_conversas c
 WHERE l.fonte = 'WHATSAPP'
   AND l.conversa_id IS NULL
   AND l.responsavel_desde IS NOT NULL
   AND lower(c.responsavel_email) = l.operador_email
   AND c.responsavel_desde = l.responsavel_desde
   AND (SELECT count(*) FROM public.whatsapp_conversas c2
         WHERE lower(c2.responsavel_email) = l.operador_email
           AND c2.responsavel_desde = l.responsavel_desde) = 1;

-- 3. indices
-- 3a. legado: so linhas SEM conversa (historico que nao se consegue distinguir)
CREATE UNIQUE INDEX IF NOT EXISTS uq_receptivo_log_operador_ciclo_legado
  ON public.receptivo_atendimentos_log (operador_email, responsavel_desde)
  WHERE responsavel_desde IS NOT NULL AND conversa_id IS NULL;

-- 3b. nova chave: conversa + operador + ciclo
CREATE UNIQUE INDEX IF NOT EXISTS uq_receptivo_log_operador_conversa_ciclo
  ON public.receptivo_atendimentos_log (operador_email, conversa_id, responsavel_desde)
  WHERE conversa_id IS NOT NULL AND responsavel_desde IS NOT NULL;

-- 4. funcao: registra com conversa_id e usa a chave nova
CREATE OR REPLACE FUNCTION public.fila_receptivo_registrar_atendimento(
  p_email text, p_conversa_id uuid DEFAULT NULL::uuid)
RETURNS boolean
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $function$
declare
  v_hoje           date := (now() at time zone 'America/Sao_Paulo')::date;
  v_nome           text;
  v_resp_desde     timestamptz;
  v_rows           integer;
begin
  if p_conversa_id is not null then
    select responsavel_desde into v_resp_desde
      from public.whatsapp_conversas
     where id = p_conversa_id
       and lower(responsavel_email) = lower(p_email);

    if not found or v_resp_desde is null then
      return false;
    end if;
  end if;

  select nome into v_nome from public.fila_receptivo where email = p_email;
  if not found then return false; end if;

  insert into public.receptivo_atendimentos_log
    (operador_email, operador_nome, atendido_em, responsavel_desde, fonte, conversa_id)
  values (
    p_email,
    v_nome,
    now(),
    v_resp_desde,
    case when p_conversa_id is not null then 'WHATSAPP' else 'MANUAL' end,
    p_conversa_id
  )
  on conflict (operador_email, conversa_id, responsavel_desde)
  where conversa_id is not null and responsavel_desde is not null
  do nothing;

  get diagnostics v_rows = row_count;

  if v_rows > 0 then
    update public.fila_receptivo
       set atendimentos_hoje = case when data_referencia = v_hoje then atendimentos_hoje + 1 else 1 end,
           data_referencia   = v_hoje,
           ultimo_atendimento = now(),
           online_em          = now()
     where email = p_email;
  end if;

  return v_rows > 0;
end;
$function$;

REVOKE ALL ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) FROM anon;
REVOKE ALL ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) FROM authenticated;
GRANT EXECUTE ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) TO service_role;

-- 5. a RPC publica (fila_receptivo_marcar_atendido) chama a funcao acima;
--    nada muda nela. Grants reconferidos por CREATE OR REPLACE nao aplicavel.

-- 6. o indice antigo sai SO agora: nenhuma funcao usa mais o alvo antigo
DROP INDEX IF EXISTS public.uq_receptivo_log_operador_ciclo;

-- 7. verificacao final: falha fechado
DO $verifica$
DECLARE
  v_antigo integer; v_dup integer; v_bf integer; v_src text;
BEGIN
  SELECT count(*) INTO v_antigo FROM pg_indexes
   WHERE tablename = 'receptivo_atendimentos_log' AND indexname = 'uq_receptivo_log_operador_ciclo';
  IF v_antigo <> 0 THEN
    RAISE EXCEPTION 'indice antigo ainda existe' USING ERRCODE = '22023';
  END IF;
  SELECT count(*) INTO v_dup FROM (
    SELECT operador_email, conversa_id, responsavel_desde FROM public.receptivo_atendimentos_log
     WHERE conversa_id IS NOT NULL AND responsavel_desde IS NOT NULL
     GROUP BY 1,2,3 HAVING count(*) > 1) x;
  IF v_dup <> 0 THEN
    RAISE EXCEPTION 'duplicidade na chave nova: % grupos', v_dup USING ERRCODE = '23505';
  END IF;
  SELECT prosrc INTO v_src FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
   WHERE n.nspname = 'public' AND p.proname = 'fila_receptivo_registrar_atendimento';
  IF v_src NOT ILIKE '%conversa_id, responsavel_desde%' THEN
    RAISE EXCEPTION 'registrar nao usa a chave nova' USING ERRCODE = '22023';
  END IF;
  SELECT count(*) INTO v_bf FROM public.receptivo_atendimentos_log WHERE conversa_id IS NOT NULL;
  RAISE NOTICE 'receptivo log: chave por conversa ativa; linhas com conversa_id=%', v_bf;
END $verifica$;

COMMIT;
