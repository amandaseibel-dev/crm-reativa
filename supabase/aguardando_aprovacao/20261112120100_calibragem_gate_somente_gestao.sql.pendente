-- GATE SEM JWT NAO E AUTORIZACAO -- calibragem_* e onda1_* (PENDENTE DE APROVACAO).
--
-- PROBLEMA MEDIDO (12/11/2026): dezenas de funcoes calibragem_* e onda1_* usam
--   public.calibragem_e_gestao() or auth.jwt() is null
-- auth.jwt() e null quando a sessao nao tem JWT (SQL direto como postgres, pelo
-- conector MCP ou pelo SQL editor). Nesses casos o gate passa sem ninguem
-- identificado. A execucao da Onda 1 de 22/10 entrou por essa porta.
--
-- CORRECAO: a gestao identificada por JWT (calibragem_e_gestao) e o unico gate
-- de funcoes de carteira. Substituicao ancorada e verificada: a expressao
-- exata deve ocorrer; funcoes sem a forma exata sao listadas e NAO alteradas.
--
-- ESCOPO: so funcoes calibragem_% e onda1_%. Nenhum cron chama essas funcoes
-- sem JWT (verificado em cron.job: unica chamada de calibragem/onda1 era o job
-- 48, que chama nivelamento_automatico_gestao, FORA deste escopo e desativado
-- pela migration 20261112120000).
--
-- NAO ALTERADO (forma de gate diferente; revisar em outra etapa):
--   calibragem_simular, calibragem_simular_ano, calibragem_recomputar_snapshot.

do $$
declare
  -- forma 1: gate generico (calibragem_* e onda1_*)
  v_old1 constant text := 'public.calibragem_e_gestao() or auth.jwt() is null';
  v_new1 constant text := 'public.calibragem_e_gestao()';
  -- forma 2: caminho tecnico por sessao (simulacoes). Removido: sem JWT + sessao
  -- privilegiada permitia simular sem nenhuma pessoa identificada.
  v_old2 constant text := 'or (auth.jwt() is null and session_user in (''postgres'',''reativa_responsavel_executor''))';
  v_new2 constant text := '';
  r record; v_def text; v_novo text; v_n1 int; v_n2 int;
begin
  for r in
    select p.oid, p.proname
      from pg_proc p join pg_namespace n on n.oid = p.pronamespace
     where n.nspname = 'public'
       and (p.proname like 'calibragem\_%' or p.proname like 'onda1\_%')
       and (position(v_old1 in pg_get_functiondef(p.oid)) > 0
            or position(v_old2 in pg_get_functiondef(p.oid)) > 0)
  loop
    v_def := pg_get_functiondef(r.oid);
    v_n1 := (length(v_def) - length(replace(v_def, v_old1, ''))) / length(v_old1);
    v_n2 := (length(v_def) - length(replace(v_def, v_old2, ''))) / length(v_old2);
    v_novo := replace(replace(v_def, v_old1, v_new1), v_old2, v_new2);
    insert into public.nivelamento_v2_backup(nome, definicao)
      values ('fn:' || r.proname, v_def)
      on conflict (nome) do nothing;
    execute v_novo;
    raise notice 'gate ajustado: % (forma1=% forma2=%)', r.proname, v_n1, v_n2;
  end loop;
end $$;
