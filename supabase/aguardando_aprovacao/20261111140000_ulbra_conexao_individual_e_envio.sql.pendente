-- =============================================================================
-- ULBRA — conexão INDIVIDUAL do operador (OAuth por pessoa), prévia registrada
-- no servidor e registro de envios de TEXTO LIVRE.
-- PENDENTE. NÃO APLICAR sem autorização expressa da gestão.
-- Substitui a proposta 20261109170000 (nunca aplicada).
--
-- Tabelas com RLS ligada e SEM política para authenticated/anon: só service_role
-- (as Edge Functions) lê e escreve. Tokens ficam CIFRADOS (AES-256-GCM) com
-- chave que mora fora do banco (secret `ULBRA_TOKENS_CHAVE` da função).
--
-- Nenhuma linha é criada aqui. Nada existente é tocado.
-- Templates NÃO fazem parte desta migration.
-- =============================================================================

-- Guarda: se qualquer objeto desta migration já existir, aborta sem alterar nada.
-- Sem isso, "if not exists" trataria uma tabela homônima como criada por esta migration, e o
-- rollback a apagaria.
do $$
begin
  if to_regclass('public.ulbra_conexoes_pedidos') is not null
     or to_regclass('public.ulbra_conexoes_operador') is not null
     or to_regclass('public.ulbra_envio_previas') is not null
     or to_regclass('public.ulbra_envios') is not null
     or to_regclass('public.ulbra_envios_atendimento_idx') is not null
     or to_regclass('public.ulbra_envios_texto_em_aberto_unica') is not null
     or to_regprocedure('public.ulbra_conferir_envio(text,text,text,text,text,jsonb)') is not null then
    raise exception 'MIGRATION_20261111140000: objeto já existe; não aplicar sobre estado desconhecido';
  end if;
end $$;

-- Pedido de conexão em andamento: nasce no clique "Conectar", morre no retorno
-- do navegador (ou em 10 min). Guarda o verifier do PKCE, nunca token.
create table public.ulbra_conexoes_pedidos (
  state            text primary key,
  operador_email   text not null,
  verifier         text not null,
  criado_em        timestamptz not null default now(),
  constraint ulbra_conexoes_pedidos_email_minusculo check (operador_email = lower(operador_email))
);
alter table public.ulbra_conexoes_pedidos enable row level security;
revoke all on public.ulbra_conexoes_pedidos from public, anon, authenticated;
grant select, insert, update, delete on public.ulbra_conexoes_pedidos to service_role;

create table public.ulbra_conexoes_operador (
  operador_email        text primary key,
  access_token_cifrado  text,
  refresh_token_cifrado text,
  expira_em             timestamptz,
  -- quem a Mensageria diz que é a pessoa do token (meu_acesso), para provar autoria
  pessoa_nome           text,
  pessoa_id             text,
  escopos               jsonb,
  so_leitura            boolean,
  conectada_em          timestamptz not null default now(),
  revogada_em           timestamptz,
  revogada_no_provedor  boolean,
  atualizado_em         timestamptz not null default now(),
  constraint ulbra_conexoes_email_minusculo check (operador_email = lower(operador_email))
);
alter table public.ulbra_conexoes_operador enable row level security;
revoke all on public.ulbra_conexoes_operador from public, anon, authenticated;
grant select, insert, update, delete on public.ulbra_conexoes_operador to service_role;

-- Prévia registrada no servidor. NÃO é a prévia da Mensageria: é a validação feita
-- pelo ReATIVA, com o conteúdo exato (hash) e validade curta. Consumo único: a
-- confirmação marca `consumida_em` uma vez; a unicidade em ulbra_envios.previa_id
-- impede dois envios a partir da mesma prévia.
create table public.ulbra_envio_previas (
  id                uuid primary key default gen_random_uuid(),
  operador_email    text not null,
  atendimento_id    text not null,
  ulbra_cliente_id  text not null,
  conteudo_hash     text not null,
  expira_em         timestamptz not null,
  consumida_em      timestamptz,
  criado_em         timestamptz not null default now(),
  constraint ulbra_envio_previas_email_minusculo check (operador_email = lower(operador_email)),
  constraint ulbra_envio_previas_atendimento_formato check (atendimento_id ~ '^[a-f0-9]{24}$'),
  constraint ulbra_envio_previas_hash_formato check (conteudo_hash ~ '^[0-9a-f]{64}$'),
  constraint ulbra_envio_previas_validade check (expira_em > criado_em),
  -- validade máxima de 10 min no banco, mesmo que o código erre (a função usa 5 min)
  constraint ulbra_envio_previas_validade_maxima check (expira_em <= criado_em + interval '10 minutes')
  -- Sem CHECK de consumida_em >= criado_em: consumida_em vem do relógio do Edge Function e criado_em
  -- também do relógio da função (não do now()); a precisão diferente faz o CHECK falhar sem necessidade. O consumo único
  -- é garantido pelo UPDATE ... WHERE consumida_em IS NULL (teste de concorrência).
);
alter table public.ulbra_envio_previas enable row level security;
revoke all on public.ulbra_envio_previas from public, anon, authenticated;
grant select, insert, update on public.ulbra_envio_previas to service_role;

create table public.ulbra_envios (
  id                   uuid primary key default gen_random_uuid(),
  chave                text not null,
  operador_email       text not null,
  atendimento_id       text not null,
  texto                text not null,
  status               text not null check (status in ('PENDENTE','ENVIANDO','ENVIADO','RECUSADO','FALHA_INCERTA','CONFIRMADO_ENVIADO','CONFIRMADO_NAO_ENVIADO')),
  ulbra_mensagem_id    text,
  motivo               text,
  -- a prévia que autorizou este envio. Unique: uma prévia gera no máximo um envio.
  previa_id            uuid references public.ulbra_envio_previas (id),
  -- 0 = envio comum. >0 = nova mensagem intencional com o mesmo texto (ação explícita e nova chave).
  repeticao            integer not null default 0 check (repeticao >= 0),
  criado_em            timestamptz not null default now(),
  atualizado_em        timestamptz not null default now(),
  constraint ulbra_envios_chave_unica unique (operador_email, chave),
  constraint ulbra_envios_previa_unica unique (previa_id),
  constraint ulbra_envios_texto_limite check (char_length(texto) between 1 and 4096),
  constraint ulbra_envios_chave_limite check (char_length(chave) between 8 and 80),
  constraint ulbra_envios_atendimento_formato check (atendimento_id ~ '^[a-f0-9]{24}$')
);
create index ulbra_envios_atendimento_idx on public.ulbra_envios (atendimento_id, criado_em desc);
-- No máximo UM envio em aberto (PENDENTE, ENVIANDO ou FALHA_INCERTA) por atendimento e texto,
-- entre todos os operadores. Fecha a corrida entre requisições concorrentes com chaves diferentes.
create unique index ulbra_envios_texto_em_aberto_unica on public.ulbra_envios (atendimento_id, md5(texto), repeticao)
  where status in ('PENDENTE','ENVIANDO','FALHA_INCERTA','CONFIRMADO_ENVIADO');
alter table public.ulbra_envios enable row level security;
revoke all on public.ulbra_envios from public, anon, authenticated;
grant select, insert, update on public.ulbra_envios to service_role;

-- Conferência administrativa: grava a decisão e a auditoria NA MESMA transação.
-- Uma chamada desta função é uma transação: se a auditoria falhar, a decisão é desfeita.
-- Só altera envio em aberto (PENDENTE, ENVIANDO ou FALHA_INCERTA). Nunca reenvia.
create function public.ulbra_conferir_envio(
  p_operador text, p_chave text, p_decisao text, p_motivo text, p_conferido_por text, p_detalhes jsonb
) returns jsonb
language plpgsql
security invoker
set search_path = public
as $$
declare
  v_status text;
begin
  if p_decisao not in ('CONFIRMADO_ENVIADO', 'CONFIRMADO_NAO_ENVIADO') then
    return jsonb_build_object('situacao', 'BLOQUEADO', 'motivos', jsonb_build_array('DECISAO_INVALIDA'));
  end if;
  if length(trim(coalesce(p_motivo, ''))) < 10 then
    return jsonb_build_object('situacao', 'BLOQUEADO', 'motivos', jsonb_build_array('MOTIVO_OBRIGATORIO'));
  end if;
  -- trava a linha: conferências concorrentes sobre o mesmo envio se enfileiram
  select status into v_status from public.ulbra_envios
   where operador_email = p_operador and chave = p_chave for update;
  if not found then
    return jsonb_build_object('situacao', 'BLOQUEADO', 'motivos', jsonb_build_array('ENVIO_NAO_ENCONTRADO'));
  end if;
  if v_status not in ('PENDENTE', 'ENVIANDO', 'FALHA_INCERTA') then
    return jsonb_build_object('situacao', 'BLOQUEADO', 'motivos', jsonb_build_array('ENVIO_JA_RESOLVIDO_OU_FECHADO'));
  end if;
  -- PENDENTE = chamada nunca começou (ENVIANDO é gravado antes da chamada e a transição é condicionada).
  -- Não pode ser declarado enviado.
  if v_status = 'PENDENTE' and p_decisao = 'CONFIRMADO_ENVIADO' then
    return jsonb_build_object('situacao', 'BLOQUEADO', 'motivos', jsonb_build_array('PENDENTE_NUNCA_CHAMADO_NAO_PODE_SER_ENVIADO'));
  end if;
  update public.ulbra_envios
     set status = p_decisao,
         motivo = 'conferido por ' || p_conferido_por || ': ' || trim(p_motivo) || ' (status anterior: ' || v_status || ')',
         atualizado_em = now()
   where operador_email = p_operador and chave = p_chave;
  insert into public.auditoria (usuario, acao, tabela_afetada, registro_id, detalhes)
  values (p_conferido_por, 'ULBRA_ENVIO_CONFERIDO', 'ulbra_envios', null,
          jsonb_build_object('chave', p_chave, 'operador_alvo', p_operador, 'decisao', p_decisao,
                             'status_anterior', v_status) || coalesce(p_detalhes, '{}'::jsonb));
  return jsonb_build_object('situacao', 'RESOLVIDO', 'status_anterior', v_status);
end
$$;

revoke all on function public.ulbra_conferir_envio(text, text, text, text, text, jsonb) from public, anon, authenticated;
grant execute on function public.ulbra_conferir_envio(text, text, text, text, text, jsonb) to service_role;
