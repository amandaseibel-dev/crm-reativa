-- =============================================================================
-- ULBRA — conexão INDIVIDUAL do operador (OAuth por pessoa) e registro de envios.
-- PENDENTE. NÃO APLICAR sem autorização expressa da gestão.
-- Substitui a proposta 20261109170000 (nunca aplicada): acrescenta o pedido de
-- conexão (state + verifier do PKCE), quem é a pessoa conectada e os escopos.
--
-- Tabelas com RLS ligada e SEM política para authenticated/anon: só service_role
-- (as Edge Functions) lê e escreve. Tokens ficam CIFRADOS (AES-256-GCM) com
-- chave que mora fora do banco (secret `ULBRA_TOKENS_CHAVE` da função).
-- Operador e gestão nunca leem token por esta via.
--
-- Nenhuma linha é criada aqui. Nada existente é tocado.
-- =============================================================================

-- Pedido de conexão em andamento: nasce no clique "Conectar", morre no retorno
-- do navegador (ou em 10 min). Guarda o verifier do PKCE, nunca token.
create table if not exists public.ulbra_conexoes_pedidos (
  state            text primary key,
  operador_email   text not null,
  verifier         text not null,
  criado_em        timestamptz not null default now(),
  constraint ulbra_conexoes_pedidos_email_minusculo check (operador_email = lower(operador_email))
);
alter table public.ulbra_conexoes_pedidos enable row level security;
revoke all on public.ulbra_conexoes_pedidos from public, anon, authenticated;
grant select, insert, update, delete on public.ulbra_conexoes_pedidos to service_role;

create table if not exists public.ulbra_conexoes_operador (
  operador_email        text primary key,
  access_token_cifrado  text,
  refresh_token_cifrado text,
  expira_em             timestamptz,
  -- quem a Mensageria diz que é a pessoa do token (meu_acesso), para provar autoria
  pessoa_nome           text,
  pessoa_id             text,
  escopos               jsonb,
  so_leitura            boolean,
  conectada_em          timestamptz not null default now(),
  revogada_em           timestamptz,
  revogada_no_provedor  boolean,
  atualizado_em         timestamptz not null default now(),
  constraint ulbra_conexoes_email_minusculo check (operador_email = lower(operador_email))
);
alter table public.ulbra_conexoes_operador enable row level security;
revoke all on public.ulbra_conexoes_operador from public, anon, authenticated;
grant select, insert, update, delete on public.ulbra_conexoes_operador to service_role;

create table if not exists public.ulbra_envios (
  id                   uuid primary key default gen_random_uuid(),
  chave                text not null,
  operador_email       text not null,
  atendimento_id       text not null,
  texto                text not null,
  status               text not null check (status in ('PENDENTE','ENVIANDO','ENVIADO','RECUSADO','FALHA_INCERTA')),
  ulbra_mensagem_id    text,
  motivo               text,
  -- o que a PRÉVIA da Mensageria disse antes da confirmação (custo em US$, janela)
  previa_custo_usd     numeric(10,4),
  previa_janela_aberta boolean,
  previa_em            timestamptz,
  criado_em            timestamptz not null default now(),
  atualizado_em        timestamptz not null default now(),
  constraint ulbra_envios_chave_unica unique (operador_email, chave),
  constraint ulbra_envios_texto_limite check (char_length(texto) between 1 and 4096),
  constraint ulbra_envios_chave_limite check (char_length(chave) between 8 and 80),
  constraint ulbra_envios_atendimento_formato check (atendimento_id ~ '^[a-f0-9]{24}$')
);
create index if not exists ulbra_envios_atendimento_idx on public.ulbra_envios (atendimento_id, criado_em desc);
alter table public.ulbra_envios enable row level security;
revoke all on public.ulbra_envios from public, anon, authenticated;
grant select, insert, update on public.ulbra_envios to service_role;
