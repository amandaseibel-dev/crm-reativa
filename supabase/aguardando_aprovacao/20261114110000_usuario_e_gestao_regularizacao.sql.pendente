-- REGULARIZAÇÃO de public.usuario_e_gestao() — PENDENTE, NÃO APLICADA.
--
-- Por que existe: a função está em produção sem migration que a crie (evidência de leitura em
-- docs/seguranca/evidencias/catalogo_usuario_e_gestao_20261116.md). A migration
-- 20261114120000 a chama, então um banco novo não reproduz a instalação.
--
-- Referência (produção, somente leitura): corpo em docs/seguranca/evidencias/prod_usuario_e_gestao.sql,
-- md5(prosrc) = 889cfa4a82e9046b4322e8c85ee07b7d, dono postgres, SECURITY DEFINER, STABLE,
-- search_path=public, ACL sem PUBLIC e sem anon.
--
-- Regras:
--   1. Se a função NÃO existe: cria com o corpo de referência e concede EXECUTE a authenticated e
--      service_role (e a reativa_responsavel_executor somente se o papel existir neste banco).
--      Revoga PUBLIC e anon.
--   2. Se a função EXISTE e diverge da referência (corpo, dono, SECURITY DEFINER, STABLE, search_path,
--      ou EXECUTE para PUBLIC/anon): ABORTA com exceção. Nada é alterado. NUNCA sobrescreve.
--   3. Se existe e confere: não altera nada (idempotente).
--
-- Não usa CREATE OR REPLACE (restauraria grants padrão). Não altera o alcance de cobranca07 nem
-- as permissões de reativa_responsavel_executor: a lista de e-mails é a de produção, copiada como está.

begin;

do $$
declare
  v_md5 text;
  v_secdef boolean;
  v_vol "char";
  v_cfg text[];
  v_owner text;
  v_acl aclitem[];
begin
  select md5(p.prosrc), p.prosecdef, p.provolatile, p.proconfig, pg_get_userbyid(p.proowner),
         coalesce(p.proacl, acldefault('f', p.proowner))
    into v_md5, v_secdef, v_vol, v_cfg, v_owner, v_acl
    from pg_proc p join pg_namespace n on n.oid = p.pronamespace
   where n.nspname = 'public' and p.proname = 'usuario_e_gestao' and p.pronargs = 0;

  if v_md5 is null then
    execute $f$
      create function public.usuario_e_gestao() returns boolean
      language sql stable security definer set search_path to 'public'
      as $body$
  select lower(coalesce(auth.jwt()->>'email','')) in (
    'amanda.seibel@aelbra.com.br',
    'cobranca04@aelbra.com.br',
    'cobranca07@aelbra.com.br'
  );
$body$
    $f$;
    revoke all on function public.usuario_e_gestao() from public, anon;
    grant execute on function public.usuario_e_gestao() to authenticated, service_role;
    if exists (select 1 from pg_roles where rolname = 'reativa_responsavel_executor') then
      grant execute on function public.usuario_e_gestao() to reativa_responsavel_executor;
    else
      raise notice 'regularização: papel reativa_responsavel_executor ausente neste banco; EXECUTE para ele não concedido aqui';
    end if;
    raise notice 'regularização: usuario_e_gestao() criada a partir da referência';
    return;
  end if;

  if v_md5 <> '889cfa4a82e9046b4322e8c85ee07b7d'
     or not v_secdef
     or v_vol <> 's'
     or v_cfg is distinct from array['search_path=public']
     or v_owner <> 'postgres' then
    raise exception 'regularização ABORTADA: usuario_e_gestao() existe e diverge da referência (md5=%, secdef=%, volatilidade=%, config=%, dono=%). Nada foi alterado.',
      v_md5, v_secdef, v_vol, v_cfg, v_owner;
  end if;

  if exists (select 1 from aclexplode(v_acl) a where a.grantee = 0 and a.privilege_type = 'EXECUTE')
     or exists (select 1 from aclexplode(v_acl) a join pg_roles r on r.oid = a.grantee
                 where r.rolname = 'anon' and a.privilege_type = 'EXECUTE') then
    raise exception 'regularização ABORTADA: usuario_e_gestao() tem EXECUTE para PUBLIC ou anon. Nada foi alterado.';
  end if;

  raise notice 'regularização: usuario_e_gestao() já existe e confere com a referência; nada alterado';
end
$$;

commit;
