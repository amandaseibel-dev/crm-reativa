-- REVOKE de TRUNCATE de `authenticated` nas 545 tabelas `_backup_pos_import_*`
-- Autorização da gestão: 07/11/2026. PREPARADA, NÃO APLICADA.
--
-- O QUE FAZ: um único `revoke truncate` sobre uma lista explícita de 545
-- tabelas. Nada mais.
--
-- O QUE **NÃO** FAZ: não mexe em RLS, não cria nem remove policy, não toca
-- dado, não apaga tabela, não reprocessa o Borderô 333, e não retira nenhum
-- outro privilégio -- `SELECT`, `INSERT`, `UPDATE`, `DELETE`, `REFERENCES`,
-- `TRIGGER` e `MAINTAIN` de `authenticated` seguem exatamente como estão.
--
-- POR QUÊ: as 548 tabelas `_backup_pos_import_*` têm RLS habilitada e **zero
-- policy**, o que bloqueia leitura e escrita linha a linha. Mas `TRUNCATE`
-- **não passa por RLS** -- é governado só pelo privilégio de tabela. Com
-- `TRUNCATE` concedido a `authenticated`, o lastro de desfazer de ação
-- financeira (11.645 linhas em 335 dessas tabelas) está esvaziável por
-- privilégio, e PITR **não está habilitado** neste projeto.
--
-- ORIGEM DO GRANT: default privileges do schema `public`
--   `postgres` -> `r :: authenticated=arwdDxtm/postgres`
-- Toda tabela criada ali nasce com `arwdDxtm` para `authenticated`, e `D` é
-- TRUNCATE. Não houve concessão deliberada: é herança do default.
--
-- ALVO: 545, não 548. Três tabelas nunca receberam grant a `authenticated`
-- e ficam de fora porque não há o que revogar nelas:
--   _backup_pos_import_20260831225215
--   _backup_pos_import_20260831232000
--   _backup_pos_import_20260901085846
-- Nelas o ACL já é só `postgres` + `service_role`.
--
-- PRIVILÉGIOS EFETIVOS CONFERIDOS EM PROD (07/11/2026, somente leitura):
--   · `authenticated` tem TRUNCATE em 545/548 (`has_table_privilege`)
--   · `anon` tem TRUNCATE em 0/548
--   · `PUBLIC` não aparece em nenhum ACL das 548
--   · `service_role` tem TRUNCATE em 548/548 -- **mantido de propósito**: é o
--     papel de backend/Edge Function, nunca vai ao navegador (premissa §5)
--   · ACL idêntico nas 545: `authenticated=arwdDxtm/postgres`
--   · herança: só `authenticator` (inherit=false, precisa `set role`) e
--     `postgres` (inherit=true, bypassrls=true) são membros de
--     `authenticated`; `authenticated` é NOLOGIN
--
-- ROTINA LEGÍTIMA QUE DEPENDA DISSO: nenhuma.
--   · nenhuma função do schema `public` executa TRUNCATE (varredura em
--     `pg_proc.prosrc`)
--   · nenhum dos 60 jobs do `cron` cita TRUNCATE ou essas tabelas
--   · nenhum trigger não-interno nelas
--   · a única função que as cita é `acordos_pos_importacao`, que as **cria**
--     (`create table if not exists ... as` + `enable row level security`) e é
--     `SECURITY DEFINER` com owner `postgres` -- roda com os privilégios do
--     owner, não com os de `authenticated`. O revoke não a afeta.
--
-- PRIVILÉGIO SQL **NÃO É** EXPLORAÇÃO PELA API -- a diferença, medida:
--   · PostgREST não tem verbo TRUNCATE. Nenhuma rota REST executa TRUNCATE.
--   · `DELETE` pela REST existe, mas RLS sem policy devolve 0 linha.
--   · Nenhuma RPC executa TRUNCATE, então não há atalho por `/rpc/`.
--   · A única função `SECURITY INVOKER` com SQL dinâmico alcançável por
--     `authenticated` é `prime_liquidacao_evidencias`, e o dinâmico dela é
--     string estática com parâmetro `$1` -- não interpola entrada.
--   · `authenticated` é NOLOGIN: não há conexão direta com esse papel. Quem
--     conecta é `authenticator` (com senha do banco, não com JWT) e precisa
--     `set role`.
--   Conclusão honesta: **o privilégio está indevidamente aberto no SQL, e não
--   há caminho conhecido de exploração pela API hoje.** O risco real é de
--   quem já tenha credencial de banco, de uma RPC futura que execute TRUNCATE,
--   ou de SQL dinâmico injetável criado depois. Fechar o privilégio é fechar a
--   porta antes de existir a chave -- não é resposta a incidente.
--
-- ACESSO EQUIVALENTE QUE **CONTINUA** DEPOIS DESTE REVOKE (registrado, não
-- corrigido aqui, porque está fora da autorização):
--   1. `service_role` segue com TRUNCATE nas 548. É por desenho.
--   2. `postgres` é membro de `authenticated` com `inherit=true` e
--      `bypassrls=true`. Quem tem `postgres` tem tudo, revoke ou não.
--   3. **O default privilege do schema `public` não é alterado por esta
--      migration.** Qualquer tabela nova em `public` nasce de novo com
--      `arwdDxtm` para `authenticated`.
--   4. `acordos_pos_importacao` é `SECURITY DEFINER` e tem `EXECUTE` para
--      `authenticated`: qualquer token autenticado pode chamá-la e **criar**
--      uma `_backup_pos_import_*` nova, que nasce com TRUNCATE aberto outra
--      vez. O cron que a disparava está `active=false` e a última tabela é de
--      24/09/2026, então o estoque parou de crescer -- mas a porta existe.
--   AJUSTE PROPOSTO para 3 e 4, em migration separada e com autorização
--   própria: `alter default privileges in schema public revoke truncate on
--   tables from authenticated`, ou um `revoke truncate` ao final do próprio
--   corpo de `acordos_pos_importacao`. Nenhum dos dois entra aqui.
--
-- ROLLBACK: `20261107200000_revoke_truncate_backup_pos_import.rollback.sql`,
-- com a mesma lista explícita e `grant truncate`, restaurando o ACL original
-- `arwdDxtm` exatamente como está hoje.
--
-- GUARDA DE CONJUNTO: a lista foi fechada em 07/11/2026 com assinatura
-- md5 `e9368e7cd2d8095423234387ace01018` sobre os 545 nomes em ordem. A
-- migration **recusa rodar** se o conjunto tiver mudado -- tabela nova criada
-- depois, ou tabela já removida.

begin;

-- Guarda 1: o conjunto é exatamente o que foi auditado?
do $guarda$
declare
  v_total integer;
  v_md5   text;
begin
  select count(*), md5(string_agg(c.relname, ',' order by c.relname))
    into v_total, v_md5
    from pg_class c
    join pg_namespace n on n.oid = c.relnamespace
   where n.nspname = 'public'
     and c.relkind = 'r'
     and c.relname like '\_backup\_pos\_import\_%'
     and has_table_privilege('authenticated', c.oid, 'TRUNCATE');

  if v_total <> 545 or v_md5 <> 'e9368e7cd2d8095423234387ace01018' then
    raise exception
      'conjunto divergente: % tabelas com TRUNCATE para authenticated, md5 %. Esperado 545 / e9368e7cd2d8095423234387ace01018. Reaudite antes de aplicar.',
      v_total, v_md5;
  end if;
end
$guarda$;

-- Guarda 2: nenhuma rotina do schema public executa TRUNCATE.
do $guarda$
declare
  v_funcs text;
begin
  select string_agg(n.nspname || '.' || p.proname, ', ')
    into v_funcs
    from pg_proc p
    join pg_namespace n on n.oid = p.pronamespace
   where n.nspname = 'public'
     and p.prosrc ~* '(^|[^a-z_])truncate[[:space:]]';

  if v_funcs is not null then
    raise exception
      'funcao do schema public executa TRUNCATE (%); reavalie a dependencia antes de revogar.',
      v_funcs;
  end if;
end
$guarda$;

