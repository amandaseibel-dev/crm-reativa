  public."_backup_pos_import_20260924164031",
  public."_backup_pos_import_20260924174025"
from authenticated;

-- Conferência posterior, dentro da mesma transação: se algo saiu do alvo,
-- a transação não comita.
do $confere$
declare
  v_ainda_truncate integer;
  v_acl_errado     integer;
  v_rls_desligada  integer;
  v_fora_do_alvo   integer;
begin
  -- (a) nenhuma das 545 pode seguir com TRUNCATE para authenticated
  select count(*) into v_ainda_truncate
    from pg_class c
    join pg_namespace n on n.oid = c.relnamespace
   where n.nspname = 'public'
     and c.relkind = 'r'
     and c.relname like '\_backup\_pos\_import\_%'
     and has_table_privilege('authenticated', c.oid, 'TRUNCATE');

  if v_ainda_truncate <> 0 then
    raise exception 'revoke incompleto: % tabelas ainda com TRUNCATE para authenticated', v_ainda_truncate;
  end if;

  -- (b) o ACL de authenticated tem de ser exatamente arwdxtm (arwdDxtm sem o D)
  select count(*) into v_acl_errado
    from pg_class c
    join pg_namespace n on n.oid = c.relnamespace
   where n.nspname = 'public'
     and c.relkind = 'r'
     and c.relname like '\_backup\_pos\_import\_%'
     and c.relacl is not null
     and exists (select 1 from aclexplode(c.relacl) x
                  join pg_roles r on r.oid = x.grantee
                 where r.rolname = 'authenticated')
     and not exists (select 1 from unnest(c.relacl) a
                      where a::text = 'authenticated=arwdxtm/postgres');

  if v_acl_errado <> 0 then
    raise exception 'ACL fora do esperado em % tabelas: authenticated deveria ficar arwdxtm', v_acl_errado;
  end if;

  -- (c) RLS segue habilitada nas 548 -- esta migration não mexe em RLS
  select count(*) into v_rls_desligada
    from pg_class c
    join pg_namespace n on n.oid = c.relnamespace
   where n.nspname = 'public'
     and c.relkind = 'r'
     and c.relname like '\_backup\_pos\_import\_%'
     and c.relrowsecurity = false;

  if v_rls_desligada <> 0 then
    raise exception 'RLS desligada em % tabelas -- esta migration nao deveria tocar RLS', v_rls_desligada;
  end if;

  -- (d) nenhuma tabela FORA do padrão _backup_pos_import_ perdeu TRUNCATE:
  --     conta quantas tabelas de public ainda têm TRUNCATE para authenticated.
  --     Antes do revoke eram todas menos as 3; depois, todas menos as 548.
  select count(*) into v_fora_do_alvo
    from pg_class c
    join pg_namespace n on n.oid = c.relnamespace
   where n.nspname = 'public'
     and c.relkind = 'r'
     and c.relname not like '\_backup\_pos\_import\_%'
     and not has_table_privilege('authenticated', c.oid, 'TRUNCATE');

  raise notice 'conferencia OK: 545 revogadas; tabelas fora do padrao sem TRUNCATE para authenticated: % (informativo, nao bloqueia)', v_fora_do_alvo;
end
$confere$;

commit;

