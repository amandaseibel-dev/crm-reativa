-- Guarda: a função precisa existir como trigger, no estado esperado. Senão, aborta sem alterar nada.
do $$
begin
  if to_regprocedure('public._titulo_em_confirmacao_protegido()') is null then
    raise exception 'AUDITORIA_INSERT_20261114120000: função do trigger não existe; não aplicar sobre estado desconhecido';
  end if;
end $$;

alter function public._titulo_em_confirmacao_protegido() security definer set search_path = public;

revoke insert on public.auditoria from authenticated, anon;
