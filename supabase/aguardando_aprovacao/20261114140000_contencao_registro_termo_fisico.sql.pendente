-- CONTENÇÃO B1 (PENDENTE, NÃO APLICADA). Única alteração: liga a flag contencao_ativa.
-- Pré-condições: tabela termo_fisico_contencao e sua linha id=true existem (migração 20261114120000).
-- Não toca grants, função, trigger, histórico, catálogo nem barreira. Idempotente.
BEGIN;
do $$
begin
  if not exists (select 1 from public.termo_fisico_contencao where id) then
    raise exception 'pré-condição: linha de contenção ausente. Nada alterado.' using errcode = 'P0001';
  end if;
end $$;
update public.termo_fisico_contencao set contencao_ativa = true, alterado_em = clock_timestamp(), alterado_por = 'contencao_b1' where id;
COMMIT;
