-- TRUNCATE para authenticated:
--
-- select relname, array_to_string(relacl,' | ')
--   from pg_class c join pg_namespace n on n.oid=c.relnamespace
--  where n.nspname='public' and relname like '\_backup\_pos\_import\_%'
--  order by relname desc limit 1;
