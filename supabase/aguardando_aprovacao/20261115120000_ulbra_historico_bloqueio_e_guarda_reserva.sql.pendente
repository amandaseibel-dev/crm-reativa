-- =============================================================================
-- PENDENTE. NÃO APLICAR sem autorização expressa da gestão.
-- Versão instalada da reserva: 20261112111006 (ledger). NÃO é reaplicada aqui.
--
-- 1) Bloqueio compartilhado após 429 (colunas em ulbra_sync_estado).
--    Sem Retry-After, historico_bloqueado_sem_prazo = true: não há prazo inventado; a gestão libera.
-- 2) Guarda de chamador dentro da reserva (SECURITY DEFINER): só o papel de serviço reserva.
--    O grant já era só service_role; a guarda faz a regra valer dentro da função também.
-- Grants: recriados depois do CREATE OR REPLACE (que restaura o padrão). Nada é ampliado.
-- =============================================================================

do $$
begin
  if to_regclass('public.ulbra_sync_estado') is null or to_regclass('public.ulbra_historico_uso') is null then
    raise exception 'HISTORICO_BLOQUEIO_20261115: pré-requisitos ausentes; não aplicar sobre estado desconhecido';
  end if;
end $$;

alter table public.ulbra_sync_estado
  add column if not exists historico_bloqueado_ate timestamptz,
  add column if not exists historico_bloqueado_sem_prazo boolean not null default false;

create or replace function public.ulbra_historico_reservar(
  p_operador text,
  p_dia date,
  p_quantidade integer,
  p_teto_operador integer,
  p_teto_global integer
)
returns table (permitido boolean, usadas_operador integer, usadas_global integer)
language plpgsql
security definer
set search_path = public, pg_temp
as $$
declare
  uo integer;
  ug integer;
begin
  -- Contexto do chamador: JSON de claims (formato atual) ou chave legada. Qualquer outro valor é recusado.
  if coalesce(nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'role',
              current_setting('request.jwt.claim.role', true), '') <> 'service_role' then
    raise exception 'RESERVA_NAO_AUTORIZADA';
  end if;
  if p_quantidade is null or p_quantidade < 1 then
    raise exception 'quantidade inválida';
  end if;
  perform pg_advisory_xact_lock(hashtext('ulbra_historico_' || p_dia::text));
  insert into public.ulbra_historico_uso (escopo, dia)
       values (p_operador, p_dia), ('*', p_dia)
  on conflict do nothing;
  select usadas into uo from public.ulbra_historico_uso where escopo = p_operador and dia = p_dia;
  select usadas into ug from public.ulbra_historico_uso where escopo = '*' and dia = p_dia;
  if uo + p_quantidade > p_teto_operador or ug + p_quantidade > p_teto_global then
    return query select false, uo, ug;
    return;
  end if;
  update public.ulbra_historico_uso
     set usadas = usadas + p_quantidade
   where dia = p_dia and escopo in (p_operador, '*');
  return query select true, uo + p_quantidade, ug + p_quantidade;
end;
$$;

revoke all on function public.ulbra_historico_reservar(text, date, integer, integer, integer) from public, anon, authenticated;
grant execute on function public.ulbra_historico_reservar(text, date, integer, integer, integer) to service_role;
