-- Mapeamento operador ReATIVA ↔ atendente ULBRA (configuração no servidor).
-- PENDENTE: não aplicar em produção sem aprovação. Restrito à gestão.
--
-- Os 11 vínculos vêm da conferência da gestão em 08/11/2026.
-- João Silva e Marketing NÃO entram: ficam sem vínculo.
-- Este mapeamento identifica operadores. Não substitui o consentimento OAuth
-- individual e não autoriza envio pela credencial central.

create table if not exists public.ulbra_operadores_vinculo (
  id            uuid primary key default gen_random_uuid(),
  id_ulbra      text not null unique check (id_ulbra ~ '^[0-9a-f]{24}$'),
  email_reativa text not null unique,
  nome_ulbra    text not null,
  ativo         boolean not null default true,
  criado_em     timestamptz not null default now()
);

alter table public.ulbra_operadores_vinculo enable row level security;

-- Grants: nada para anon; authenticated só lê, e só a gestão.
revoke all on table public.ulbra_operadores_vinculo from public, anon, authenticated;
grant select on table public.ulbra_operadores_vinculo to authenticated;
-- Escrita só pelo servidor (service_role), sem TRUNCATE para authenticated.

drop policy if exists ulbra_operadores_vinculo_gestao_le on public.ulbra_operadores_vinculo;
create policy ulbra_operadores_vinculo_gestao_le
  on public.ulbra_operadores_vinculo
  for select to authenticated
  using (public.usuario_e_gestao());

