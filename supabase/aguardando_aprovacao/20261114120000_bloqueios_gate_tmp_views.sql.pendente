-- ============================================================================
-- BLOQUEIOS DO SECURITY GATE (14/11/2026) -- PENDENTE, NAO APLICADA
--
-- O que muda, e so isto:
--   1. public._tmp_fila2: revoga TODOS os privilegios de anon, authenticated e
--      PUBLIC. NAO apaga a tabela e NAO apaga linhas (186 linhas de pagamento).
--   2. As cinco views do gate: security_invoker = true. Elas passam a respeitar a
--      RLS de QUEM CONSULTA, em vez de rodar com o dono e contornar a RLS.
--   3. As cinco views: authenticated fica so com SELECT (revoga tudo, inclusive
--      MAINTAIN, que aparece na ACL medida: supabase/audits/bloqueios_acl_e_gestao_20261114_SAIDA.json). Mantem SELECT (filtrado).
--   4. public.pagamento_suspeita_duplicidade tem RLS e ZERO policies: depois do
--      item 2, nem a gestao leria a view que a consulta. Cria uma policy de
--      SELECT SO para usuario_e_gestao(). Operador continua sem ver nada dela.
--
-- O que NAO muda: tv-imagens (decisao da gestao, documentada em docs/seguranca),
-- policies das tabelas-base, funcoes, dados.
--
-- Rollback: 20261114120000_bloqueios_gate_tmp_views.rollback.sql (exato).
-- ============================================================================
begin;

-- 1. _tmp_fila2: sem acesso de cliente, linhas preservadas
revoke all on table public._tmp_fila2 from public, anon, authenticated;

-- 2. views respeitam a RLS de quem consulta
alter view public.vw_extracao_calibragem         set (security_invoker = true);
alter view public.vw_extracao_observabilidade    set (security_invoker = true);
alter view public.vw_extracao_validacao_trilha   set (security_invoker = true);
alter view public.vw_pagamento_suspeita_pendente set (security_invoker = true);
alter view public.vw_titulo_presenca_historico   set (security_invoker = true);

-- 3. authenticated fica so com SELECT nas views (revoga tudo, inclusive MAINTAIN)
revoke all
  on public.vw_extracao_calibragem,
     public.vw_extracao_observabilidade,
     public.vw_extracao_validacao_trilha,
     public.vw_pagamento_suspeita_pendente,
     public.vw_titulo_presenca_historico
  from authenticated;
grant select
  on public.vw_extracao_calibragem,
     public.vw_extracao_observabilidade,
     public.vw_extracao_validacao_trilha,
     public.vw_pagamento_suspeita_pendente,
     public.vw_titulo_presenca_historico
  to authenticated;

-- 4. a gestao continua vendo a suspeita de duplicidade (so a gestao)
create policy pagamento_suspeita_leitura_gestao
  on public.pagamento_suspeita_duplicidade
  for select to authenticated
  using (public.usuario_e_gestao());

commit;
