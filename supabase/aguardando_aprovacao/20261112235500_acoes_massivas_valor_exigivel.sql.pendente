-- ACOES MASSIVAS: o valor da previa e do filtro passa a ser o VALOR EXIGIVEL do
-- recorte, e nao o saldo do caso.
--
-- PROBLEMA (medido em producao, leitura, 12/11/2026)
-- O universo devolve em `valor` -- e usa no filtro de valor minimo/maximo --
-- casos.total_em_aberto. Esse saldo fica zerado ou defasado quando o titulo
-- entra sem recalculo do caso. Nos dois lotes de 12/11:
--   lote 14:38 (500 alunos): caso R$ 266.596,29 x titulos R$ 730.153,71; 380 divergem;
--   lote 15:20 (100 alunos, filtro de 0 a 300): caso R$ 86,57 x titulos vencidos
--     R$ 295.474,95; 97 com caso zerado ou sem caso. O filtro "ate R$ 300"
--     selecionou quem aparecia com zero, nao quem devia pouco.
--
-- O QUE MUDA em public.acoes_massivas_universo
--   * `valor` = mensalidades VENCIDAS (dia de Brasilia) e nao incorporadas em
--     acordo nao cancelado; ou, para quem tem acordo vencido no recorte, a soma
--     das parcelas VENCIDAS de acordo ATIVO do responsavel escolhido. Os dois
--     nunca sao somados para o mesmo aluno.
--   * o filtro de faixa (valor minimo/maximo) usa esse valor;
--   * quem nao tem nada exigivel (valor zero) fica indisponivel pelo motivo ja
--     existente `valor_fora_da_faixa`.
-- Os predicados dos titulos sao os que o proprio universo ja usa (ABERTO ou
-- NEGOCIADO, nao quitada, nao e boleto de acordo, valor > 0) e o criterio de
-- vinculo e o de acoes_massivas_tipo_cobranca_alunos e de
-- aluno_saldo_pendente_detalhe ("mensalidade so sai se vinculada").
--
-- O QUE NAO MUDA: quem entra na base, tipo de cobranca, responsavel pelo caso e
-- pelo acordo, fidelizacao, retorno futuro, liquidado no Prime, confirmacao
-- pendente, guard de zerados, previa, exportacao, registro, grants e search_path.
-- Nenhum titulo, caso, parcela ou saldo e alterado: e leitura.
--
-- Parte da DEFINICAO PUBLICADA apos 20261112210000 (MD5 8f94a168...).
-- Executar em UMA transacao (BEGIN; ... COMMIT;). Rollback no arquivo ao lado.

-- 0. GUARDA
DO $g$
BEGIN
  IF (SELECT md5(pg_get_functiondef(p.oid)) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'public' AND p.proname = 'acoes_massivas_universo') <> '8f94a1687f0f3d13765ecf86db1d1e19' THEN
    RAISE EXCEPTION 'Universo publicado mudou desde a validacao (esperado 8f94a168...). Nada aplicado.';
  END IF;
END $g$;

-- 1. tit: valor do titulo e marca de exigivel
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a1$    select t.aluno_id, extract(year from t.vencimento)::int as ano
      from public.acordos_titulos t$a1$,
$n1$    select t.aluno_id, extract(year from t.vencimento)::int as ano,
           coalesce(t.valor_cobranca_ajustado, t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0) as v,
           -- exigivel = ja venceu (dia de Brasilia) e NAO esta incorporado em acordo
           -- nao cancelado (mesmo criterio de "tem mensalidade" do tipo de cobranca)
           (t.vencimento <= v_hoje
            and not exists (
              select 1 from public.acordo_titulo_vinculo vv
                join public.acordos av on av.id = vv.acordo_id
               where vv.titulo_id = t.id and coalesce(vv.ativo, true)
                 and upper(coalesce(av.status, '')) not in ('CANCELADO', 'CANCELADA'))) as exig
      from public.acordos_titulos t$n1$, 1);

-- 2. parc: valor da parcela vencida e dono do acordo
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a2$    select a.aluno_id, extract(year from p.vencimento)::int as ano
      from public.acordos a$a2$,
$n2$    select a.aluno_id, extract(year from p.vencimento)::int as ano,
           coalesce(p.valor, 0) as v,
           (v_ra is null
            or lower(coalesce(a.operador_responsavel_email,'')) = any(v_ra)
            or (nullif(btrim(coalesce(a.operador_responsavel_email,'')),'') is null
                and 'sem_responsavel' = any(v_ra))) as dono_ok
      from public.acordos a$n2$, 1);

-- 3. val_mens e val_acordo: soma por aluno
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a3$  parc_dono as materialized ($a3$,
$n3$  -- VALOR EXIGIVEL do recorte, no lugar do saldo do caso (casos.total_em_aberto
  -- fica zerado ou defasado quando o titulo entra sem recalculo do caso).
  --   val_mens   -> mensalidades vencidas e nao incorporadas em acordo;
  --   val_acordo -> parcelas VENCIDAS de acordo ATIVO do responsavel escolhido.
  -- Os dois NUNCA sao somados para o mesmo aluno: quem tem acordo vencido no
  -- recorte mostra so o acordo (47% dos acordos ativos nao tem titulo vinculado
  -- e somar contaria a mesma divida duas vezes).
  val_mens as materialized (
    select tit.aluno_id, sum(tit.v) as v from tit where tit.exig group by tit.aluno_id
  ),
  val_acordo as materialized (
    select parc.aluno_id, sum(parc.v) as v from parc where parc.dono_ok group by parc.aluno_id
  ),
  parc_dono as materialized ($n3$, 1);

-- 4. valor do recorte no lugar do saldo do caso
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a4$           c.v as valor_caso,$a4$,
$n4$           case when va.aluno_id is not null then coalesce(va.v, 0)
                else coalesce(vm.v, 0) end as valor_caso,$n4$, 1);

-- 5. sai a leitura de casos.total_em_aberto
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a5$      left join lateral (
        select c2.total_em_aberto as v
          from public.casos c2
         where c2.aluno_id = p.id
         order by (v_op not in ('todos', 'livres') and c2.operador_email is not distinct from v_op) desc,
                  c2.total_em_aberto desc nulls last
         limit 1
      ) c on true$a5$,
$n5$      left join val_mens vm on vm.aluno_id = p.id
      left join val_acordo va on va.aluno_id = p.id$n5$, 1);

-- 6. filtro de faixa: valor zero fica sempre fora
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a6$           (coalesce(k.valor_caso, 0) < v_min$a6$,
$n6$           -- sem nada exigivel (valor zero) fica sempre fora da faixa
           (coalesce(k.valor_caso, 0) < greatest(v_min, 0.01)$n6$, 1);

-- 7. MD5 FINAL
DO $m$
BEGIN
  IF (SELECT md5(pg_get_functiondef(p.oid)) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'public' AND p.proname = 'acoes_massivas_universo') <> 'a44af07e4e52dd68f5632977d99352dc' THEN
    RAISE EXCEPTION 'MD5 final do universo diferente do validado.';
  END IF;
END $m$;
