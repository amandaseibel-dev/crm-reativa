-- =====================================================================
-- WHATSAPP: COTA DE 10 ABORDAGENS ATIVAS POR OPERADOR + RECEPTIVO NA FILA
-- Preparada em 11/11/2026. NÃO APLICADA. Aguarda aprovação da Amanda.
--
-- DEPENDE DA CONTINUIDADE v2 (20261109120000, PR #894) JÁ APLICADA.
-- A pré-condição abaixo recusa rodar sem ela: esta migration reescreve
-- whatsapp_cadencia_checar a partir do corpo da v2, e aplicar sem a v2
-- apagaria a regra de CONTINUIDADE em vez de preservá-la.
--
-- -----------------------------------------------------------------
-- REGRA FINAL (decisão da Amanda, 11/11/2026) — DUAS COISAS SEPARADAS
--
-- 1) COTA = só ABORDAGEM ATIVA
--    As 10 novas conversas diárias são exclusivamente abordagens ATIVAS
--    iniciadas pelo operador (classificação NOVA_ABORDAGEM). Contador:
--    whatsapp_abordagens, o mesmo de sempre, SEM mudança de estrutura —
--    só NOVA_ABORDAGEM grava nele, então ele já é "só ATIVA".
--      operador (e qualquer perfil fora da lista abaixo, inclusive
--        diretoria): 10 por dia por canal + liberação extra do dia
--      gerencia, supervisor, administrativo: SEM limite individual diário;
--        a abordagem deles segue gravada e segue no teto do canal
--    Não gastam cota: RESPOSTA, CONTINUIDADE v2 e o receptivo inteiro.
--
-- 2) RECEPTIVO = FILA, não cota
--    Assumir a conversa NÃO conta. A PRIMEIRA resposta ENVIADA com sucesso
--    pelo responsável, no ciclo de responsabilidade, conta UM atendimento e
--    move a posição na fila (fila_receptivo.atendimentos_hoje e
--    ultimo_atendimento), uma única vez. Segunda resposta, reenvio, recarga
--    e envio FALHOU não contam. Envio de quem não é o responsável não conta
--    para ninguém. Troca de responsável abre ciclo novo.
--    Idempotência REAPROVEITADA: o mesmo caminho de
--    fila_receptivo_marcar_atendido -> receptivo_atendimentos_log ->
--    uq_receptivo_log_operador_ciclo (operador_email, responsavel_desde).
--    Nenhuma contagem nova.
--
-- ONDE A MARCAÇÃO DA FILA MORA: trigger no banco, ao gravar a saída
-- ENVIADO. Motivos:
--   * "com sucesso" é status ENVIADO, que a Edge whatsapp-send só grava
--     DEPOIS de o gateway confirmar; FALHOU não dispara nada;
--   * o registro é INSERT ... ON CONFLICT (wamid) DO NOTHING: reenvio do
--     mesmo wamid não dispara de novo (idempotência que já existe);
--   * não depende da tela: recarga, aba duplicada ou tela antiga não
--     contam nem deixam de contar;
--   * não exige publicar Edge Function.
-- A tela deixa de marcar no ASSUMIR (mesma PR).
--
-- fila_receptivo_marcar_atendido exige o JWT do próprio operador (ou de
-- gestão), e o trigger roda sem JWT. Por isso o corpo dela, depois da
-- trava de autenticação, vira a função interna
-- fila_receptivo_registrar_atendimento — SEM grant para authenticated —
-- e a RPC pública passa a ser: trava + chamada da interna. Comportamento
-- da RPC idêntico (o botão "Marcar" da FilaReceptivo segue igual).
--
-- TETO GLOBAL (limite_abordagens_canal): continua contando só abordagem
-- ATIVA (é o único tipo que grava em whatsapp_abordagens) e vale para
-- TODOS os perfis — é proteção do número. Valores (Comercial 60, Cobrança
-- 40) NÃO são alterados aqui: decisão da Amanda (7 operadores x 10 = 70).
-- whatsapp_config.teto_abordagens_operador 3 -> 10: é a trava da tela de
-- cadência; com 3, ninguém grava 10 pela tela.
--
-- O QUE NÃO MUDA: CONTINUIDADE v2 (corpo idêntico), intervalo mínimo
-- (60s, vale para a gestão), RESPOSTA 24h, janela, PAUSADO,
-- SOMENTE_RESPOSTAS, lock da linha do canal, travas de conexão/remetente,
-- whatsapp_cadencia_liberacoes, estrutura de whatsapp_abordagens,
-- whatsapp_cadencia_indicadores, whatsapp_registrar_mensagem,
-- whatsapp_assumir_conversa, whatsapp_transferir_conversa, Edge
-- whatsapp-send.
--
-- GRANTS: whatsapp_cadencia_checar volta ao estado de PRODUÇÃO (só
-- service_role). A v2 concede EXECUTE a authenticated, que produção nunca
-- teve; esta migration revoga.
--
-- IDEMPOTENTE E FALHA FECHADO. Rollback versionado ao lado.
-- =====================================================================

-- ---------------------------------------------------------------------
-- 0. Pré-condições
-- ---------------------------------------------------------------------
DO $pre$
DECLARE
  v_tem_v2 boolean;
  v_cols   integer;
  v_teto   integer;
  r        record;
BEGIN
  SELECT count(*) INTO v_cols FROM information_schema.columns
   WHERE table_schema = 'public' AND table_name = 'whatsapp_config'
     AND column_name IN ('continuidade_janela_horas', 'continuidade_max_sem_resposta');

  SELECT p.prosrc ILIKE '%CONTINUIDADE%' INTO v_tem_v2
    FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
   WHERE n.nspname = 'public' AND p.proname = 'whatsapp_cadencia_checar';

  IF v_cols <> 2 OR NOT COALESCE(v_tem_v2, false) THEN
    RAISE EXCEPTION 'CONTINUIDADE v2 (20261109120000) nao esta aplicada: aplicar a v2 antes desta migration'
      USING ERRCODE = '55000';
  END IF;

  IF to_regclass('public.fila_receptivo') IS NULL
     OR to_regclass('public.receptivo_atendimentos_log') IS NULL
     OR to_regclass('public.uq_receptivo_log_operador_ciclo') IS NULL THEN
    RAISE EXCEPTION 'estrutura da fila do receptivo ausente (fila_receptivo / receptivo_atendimentos_log / uq_receptivo_log_operador_ciclo)'
      USING ERRCODE = '55000';
  END IF;

  -- Fotografia de 11/11/2026. Valor diferente = alguém mexeu depois da
  -- revisão: parar e revisar de novo, não sobrescrever. 10 = já aplicada.
  SELECT teto_abordagens_operador INTO v_teto FROM public.whatsapp_config LIMIT 1;
  IF v_teto IS DISTINCT FROM 3 AND v_teto IS DISTINCT FROM 10 THEN
    RAISE EXCEPTION 'teto_abordagens_operador = %, esperado 3 (fotografia de 11/11) ou 10', v_teto
      USING ERRCODE = '55000';
  END IF;

  FOR r IN
    SELECT k.apelido, k.limite_abordagens_operador AS atual, f.esperado
      FROM public.whatsapp_canais k
      JOIN (VALUES ('b8f00c75-aee3-4d22-83b7-f0041be0ef71'::uuid, 2),   -- Comercial
                   ('9f5fc202-3a22-4b24-8794-65fd92858e31'::uuid, 15),  -- Cobrança
                   ('3628d3fd-ab44-4c47-bf42-3d344c1e9336'::uuid, 3))   -- Piloto
           AS f(id, esperado) ON f.id = k.id
  LOOP
    IF r.atual IS DISTINCT FROM r.esperado AND r.atual IS DISTINCT FROM 10 THEN
      RAISE EXCEPTION 'canal % com limite_abordagens_operador = %, esperado % (fotografia de 11/11) ou 10',
        r.apelido, r.atual, r.esperado USING ERRCODE = '55000';
    END IF;
  END LOOP;
END $pre$;

-- ---------------------------------------------------------------------
-- 1. Limite 10 por operador e trava da tela
-- ---------------------------------------------------------------------
UPDATE public.whatsapp_config
   SET teto_abordagens_operador = 10
 WHERE teto_abordagens_operador IS DISTINCT FROM 10;

UPDATE public.whatsapp_canais
   SET limite_abordagens_operador = 10
 WHERE limite_abordagens_operador IS DISTINCT FROM 10;

-- ---------------------------------------------------------------------
-- 2. Quem não tem limite individual
--    Lê o perfil do cadastro, não o JWT: a cadência avalia o operador do
--    ENVIO, que chega por parâmetro.
-- ---------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.whatsapp_cadencia_sem_limite_individual(p_email text)
RETURNS boolean
LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM public.usuarios u
     WHERE lower(u.email) = lower(p_email)
       AND u.ativo IS TRUE
       AND u.perfil IN ('gerencia', 'supervisor', 'administrativo')
  );
$function$;

REVOKE ALL ON FUNCTION public.whatsapp_cadencia_sem_limite_individual(text) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_sem_limite_individual(text) FROM anon;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_sem_limite_individual(text) FROM authenticated;
GRANT EXECUTE ON FUNCTION public.whatsapp_cadencia_sem_limite_individual(text) TO service_role;

-- ---------------------------------------------------------------------
-- 3. whatsapp_cadencia_checar = corpo da v2 + isenção por perfil
--    Única diferença em relação à v2: perfis sem limite individual não
--    passam pelo LIMITE_OPERADOR. INSERT, contagens, teto do canal,
--    intervalo, modos, janela e CONTINUIDADE: idênticos à v2.
-- ---------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.whatsapp_cadencia_checar(
  p_canal_id    uuid,
  p_conversa_id uuid,
  p_operador    text)
RETURNS text
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $function$
DECLARE
  v_canal          public.whatsapp_canais%ROWTYPE;
  v_agora          timestamptz := now();
  v_hoje           date        := (v_agora AT TIME ZONE 'America/Sao_Paulo')::date;
  v_hora           time        := (v_agora AT TIME ZONE 'America/Sao_Paulo')::time;
  v_resposta       boolean;
  v_op             integer;
  v_ch             integer;
  v_extra          integer := 0;
  v_limite_op      integer;
  v_intervalo      integer;
  v_janela_h       integer;
  v_cont_h         integer;
  v_cont_max       integer;
  v_ultimo         timestamptz;
  v_faltam         integer;
  v_ult_entrada    timestamptz;
  v_tem_saida_dele boolean;
  v_sem_resposta   integer;
  v_conv_bloqueada boolean;
  v_sem_limite     boolean;
BEGIN
  -- Lock da linha do canal: serializa toda a cadência deste canal.
  -- Fica ANTES de qualquer contagem, de CONTINUIDADE e do INSERT.
  SELECT * INTO v_canal FROM public.whatsapp_canais WHERE id = p_canal_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'canal inexistente'; END IF;

  IF v_canal.modo = 'PAUSADO' THEN
    RAISE EXCEPTION 'o numero % esta pausado: nenhuma mensagem sai por ele', v_canal.apelido
      USING ERRCODE = '42501', DETAIL = 'MODO_PAUSADO';
  END IF;

  SELECT COALESCE(intervalo_minimo_envio_seg, 60),
         COALESCE(resposta_janela_horas, 24),
         COALESCE(continuidade_janela_horas, 72),
         COALESCE(continuidade_max_sem_resposta, 3)
    INTO v_intervalo, v_janela_h, v_cont_h, v_cont_max
    FROM public.whatsapp_config LIMIT 1;
  v_intervalo := COALESCE(v_intervalo, 60);
  v_janela_h  := COALESCE(v_janela_h, 24);
  v_cont_h    := COALESCE(v_cont_h, 72);
  v_cont_max  := COALESCE(v_cont_max, 3);

  -- RITMO: vale para abordagem E resposta, porque o WhatsApp olha o ritmo
  -- do numero, nao a nossa classificacao. Mesma conversa nao conta.
  IF v_intervalo > 0 THEN
    SELECT max(m.criado_em) INTO v_ultimo
      FROM public.whatsapp_mensagens m
      JOIN public.whatsapp_conversas cv ON cv.id = m.conversa_id
     WHERE m.direcao = 'SAIDA'
       AND lower(m.enviado_por_email) = lower(p_operador)
       AND cv.canal_id = p_canal_id
       AND m.conversa_id IS DISTINCT FROM p_conversa_id
       AND m.criado_em > v_agora - make_interval(secs => v_intervalo);

    IF v_ultimo IS NOT NULL THEN
      v_faltam := ceil(extract(epoch from (v_ultimo + make_interval(secs => v_intervalo) - v_agora)));
      RAISE EXCEPTION 'espere % segundos antes de falar com outro aluno neste numero', GREATEST(v_faltam, 1)
        USING ERRCODE = '42501', DETAIL = 'INTERVALO_MINIMO';
    END IF;
  END IF;

  -- RESPOSTA: aluno escreveu nas ultimas v_janela_h horas (24h, inalterado)
  v_resposta := p_conversa_id IS NOT NULL AND EXISTS (
    SELECT 1 FROM public.whatsapp_mensagens m
    WHERE m.conversa_id = p_conversa_id
      AND m.direcao = 'ENTRADA'
      AND m.timestamp_wa >= v_agora - make_interval(hours => v_janela_h)
  );
  IF v_resposta THEN RETURN 'RESPOSTA'; END IF;

  -- Restricoes do canal prevalecem sobre continuidade.
  IF v_canal.modo = 'SOMENTE_RESPOSTAS' THEN
    RAISE EXCEPTION 'o numero % so responde quem escreveu nas ultimas %h', v_canal.apelido, v_janela_h
      USING ERRCODE = '42501', DETAIL = 'MODO_SOMENTE_RESPOSTAS';
  END IF;

  IF v_canal.janela_inicio IS NOT NULL AND v_canal.janela_fim IS NOT NULL
     AND (v_hora < v_canal.janela_inicio OR v_hora >= v_canal.janela_fim) THEN
    RAISE EXCEPTION 'novas conversas so entre % e %, horario de Brasilia',
      to_char(v_canal.janela_inicio, 'HH24:MI'), to_char(v_canal.janela_fim, 'HH24:MI')
      USING ERRCODE = '42501', DETAIL = 'FORA_DA_JANELA';
  END IF;

  -- ===================================================================
  -- CONTINUIDADE v2 — cinco condicoes, todas obrigatorias.
  -- Nenhuma delas e renovavel por acao do operador.
  -- ===================================================================
  IF v_cont_h > 0 AND v_cont_max > 0 AND p_conversa_id IS NOT NULL THEN

    -- cond. 5: conversa nao arquivada E nao encerrada (eixos independentes)
    SELECT (cv.arquivada_em IS NOT NULL OR cv.status = 'ENCERRADO')
      INTO v_conv_bloqueada
      FROM public.whatsapp_conversas cv
     WHERE cv.id = p_conversa_id;

    IF COALESCE(v_conv_bloqueada, true) = false THEN

      -- cond. 1: existe SAIDA anterior DESTE operador nesta conversa,
      -- qualquer classificacao (e o que a v1 nao enxergava)
      SELECT EXISTS (
        SELECT 1 FROM public.whatsapp_mensagens m
        WHERE m.conversa_id = p_conversa_id
          AND m.direcao = 'SAIDA'
          AND lower(m.enviado_por_email) = lower(p_operador)
      ) INTO v_tem_saida_dele;

      -- cond. 2 e 3: aluno ja respondeu, e a ultima resposta esta na janela.
      -- ANCORA NAO RENOVAVEL: timestamp_wa de ENTRADA. O operador nao
      -- consegue produzir uma ENTRADA, logo nenhum envio dele estende isto.
      SELECT max(m.timestamp_wa) INTO v_ult_entrada
        FROM public.whatsapp_mensagens m
       WHERE m.conversa_id = p_conversa_id
         AND m.direcao = 'ENTRADA';

      IF v_tem_saida_dele
         AND v_ult_entrada IS NOT NULL
         AND v_ult_entrada >= v_agora - make_interval(hours => v_cont_h)
      THEN
        -- cond. 4: teto de insistencia desde a ultima ENTRADA do aluno
        SELECT count(*) INTO v_sem_resposta
          FROM public.whatsapp_mensagens m
         WHERE m.conversa_id = p_conversa_id
           AND m.direcao = 'SAIDA'
           AND lower(m.enviado_por_email) = lower(p_operador)
           AND m.criado_em > v_ult_entrada;

        IF v_sem_resposta < v_cont_max THEN
          -- Retorna ANTES do INSERT: nao consome cota e nao cria registro,
          -- portanto nao realimenta nenhuma janela.
          RETURN 'CONTINUIDADE';
        END IF;
      END IF;
    END IF;
  END IF;

  -- NOVA_ABORDAGEM: abordagem ATIVA. Gravada para TODOS os perfis — sem
  -- ela o teto do canal não veria a abordagem da gestão.
  INSERT INTO public.whatsapp_abordagens (canal_id, conversa_id, operador_email, dia)
  VALUES (p_canal_id, p_conversa_id, lower(p_operador), v_hoje)
  ON CONFLICT (canal_id, conversa_id, dia) DO NOTHING;

  SELECT count(*) INTO v_op FROM public.whatsapp_abordagens
   WHERE canal_id = p_canal_id AND operador_email = lower(p_operador) AND dia = v_hoje;
  SELECT count(*) INTO v_ch FROM public.whatsapp_abordagens
   WHERE canal_id = p_canal_id AND dia = v_hoje;

  v_sem_limite := public.whatsapp_cadencia_sem_limite_individual(p_operador);

  SELECT COALESCE(l.extra, 0) INTO v_extra FROM public.whatsapp_cadencia_liberacoes l
   WHERE l.canal_id = p_canal_id AND l.operador_email = lower(p_operador) AND l.dia = v_hoje;
  v_extra := COALESCE(v_extra, 0);
  v_limite_op := v_canal.limite_abordagens_operador + v_extra;

  -- Gerência, supervisão e administrativo: sem limite individual diário.
  IF NOT v_sem_limite
     AND v_canal.limite_abordagens_operador IS NOT NULL
     AND v_op > v_limite_op THEN
    RAISE EXCEPTION 'voce ja iniciou % conversas novas hoje neste numero. Responder quem escreveu nas ultimas %h continua liberado',
      v_limite_op, v_janela_h
      USING ERRCODE = '42501', DETAIL = 'LIMITE_OPERADOR';
  END IF;

  -- Teto do número: vale para todos os perfis (proteção do provedor).
  IF v_canal.limite_abordagens_canal IS NOT NULL
     AND v_ch > v_canal.limite_abordagens_canal THEN
    RAISE EXCEPTION 'o numero % ja iniciou % conversas novas hoje. Nenhum operador inicia novas ate amanha',
      v_canal.apelido, v_canal.limite_abordagens_canal
      USING ERRCODE = '42501', DETAIL = 'LIMITE_CANAL';
  END IF;

  RETURN 'NOVA_ABORDAGEM';
END;
$function$;

-- Estado de PRODUÇÃO: só service_role (e o owner). preparar_envio e
-- preparar_envio_novo a chamam como owner (SECURITY DEFINER).
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) FROM anon;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) FROM authenticated;
GRANT EXECUTE ON FUNCTION public.whatsapp_cadencia_checar(uuid, uuid, text) TO service_role;

-- ---------------------------------------------------------------------
-- 4. whatsapp_cadencia_consumo: o que a tela mostra
--    Ganha duas colunas no FIM (as antigas mantêm nome, tipo e ordem):
--      limite_operador_canal  valor configurado no canal, sem extra. É o
--                             que o formulário de edição deve pré-preencher
--                             (antes lia o limite somado ao extra do dia).
--      sem_limite_individual  true para gerencia/supervisor/administrativo.
--    usadas_operador e usadas_canal: inalterados (whatsapp_abordagens só
--    tem abordagem ATIVA). Mudança de tipo de retorno exige DROP.
-- ---------------------------------------------------------------------
DROP FUNCTION IF EXISTS public.whatsapp_cadencia_consumo();

CREATE FUNCTION public.whatsapp_cadencia_consumo()
RETURNS TABLE(canal_id uuid, canal_apelido text, modo text, limite_operador integer,
              usadas_operador integer, limite_canal integer, usadas_canal integer,
              janela_inicio time without time zone, janela_fim time without time zone,
              dentro_da_janela boolean,
              limite_operador_canal integer, sem_limite_individual boolean)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public'
AS $function$
  WITH agora AS (
    SELECT (now() AT TIME ZONE 'America/Sao_Paulo')::date AS hoje,
           (now() AT TIME ZONE 'America/Sao_Paulo')::time AS hora
  )
  SELECT k.id, k.apelido, k.modo,
         CASE WHEN k.limite_abordagens_operador IS NULL THEN NULL
              ELSE k.limite_abordagens_operador + COALESCE((
                SELECT l.extra FROM public.whatsapp_cadencia_liberacoes l, agora g
                 WHERE l.canal_id = k.id AND l.dia = g.hoje
                   AND l.operador_email = lower(public.app_email())), 0)
         END,
         (SELECT count(*)::integer FROM public.whatsapp_abordagens a, agora g
           WHERE a.canal_id = k.id AND a.dia = g.hoje
             AND a.operador_email = public.app_email() AND a.origem = 'ATIVA'),
         k.limite_abordagens_canal,
         (SELECT count(*)::integer FROM public.whatsapp_abordagens a, agora g
           WHERE a.canal_id = k.id AND a.dia = g.hoje),
         k.janela_inicio, k.janela_fim,
         (SELECT k.janela_inicio IS NULL OR k.janela_fim IS NULL
                 OR (g.hora >= k.janela_inicio AND g.hora < k.janela_fim) FROM agora g),
         k.limite_abordagens_operador,
         public.whatsapp_cadencia_sem_limite_individual(public.app_email())
  FROM public.whatsapp_canais k
  WHERE public.app_usuario_ativo() AND k.ativo
  ORDER BY k.apelido;
$function$;

REVOKE ALL ON FUNCTION public.whatsapp_cadencia_consumo() FROM PUBLIC;
REVOKE ALL ON FUNCTION public.whatsapp_cadencia_consumo() FROM anon;
GRANT EXECUTE ON FUNCTION public.whatsapp_cadencia_consumo() TO authenticated;
GRANT EXECUTE ON FUNCTION public.whatsapp_cadencia_consumo() TO service_role;

-- ---------------------------------------------------------------------
-- 5. Fila do receptivo: corpo de fila_receptivo_marcar_atendido (lido de
--    produção em 11/11/2026) separado em trava + registro
-- ---------------------------------------------------------------------

-- 5a. Registro: o corpo da RPC DEPOIS da trava de autenticação, sem
--     nenhuma mudança de regra. Interno: sem grant para authenticated.
--     Devolve true quando o atendimento foi contado.
CREATE OR REPLACE FUNCTION public.fila_receptivo_registrar_atendimento(
  p_email text, p_conversa_id uuid DEFAULT NULL::uuid)
RETURNS boolean
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $function$
declare
  v_hoje           date := (now() at time zone 'America/Sao_Paulo')::date;
  v_nome           text;
  v_resp_desde     timestamptz;
  v_rows           integer;
begin
  -- Para chamadas WhatsApp: lê responsavel_desde da conversa para chave de
  -- idempotência. Se a conversa não está com este operador, retorna sem registrar.
  if p_conversa_id is not null then
    select responsavel_desde into v_resp_desde
      from public.whatsapp_conversas
     where id = p_conversa_id
       and lower(responsavel_email) = lower(p_email);

    if not found or v_resp_desde is null then
      return false;
    end if;
  end if;

  select nome into v_nome from public.fila_receptivo where email = p_email;
  if not found then return false; end if;

  -- INSERT primeiro: ON CONFLICT DO NOTHING se mesmo ciclo já foi registrado
  insert into public.receptivo_atendimentos_log
    (operador_email, operador_nome, atendido_em, responsavel_desde, fonte)
  values (
    p_email,
    v_nome,
    now(),
    v_resp_desde,
    case when p_conversa_id is not null then 'WHATSAPP' else 'MANUAL' end
  )
  on conflict (operador_email, responsavel_desde)
  where responsavel_desde is not null
  do nothing;

  get diagnostics v_rows = row_count;

  -- Incrementa atendimentos_hoje SOMENTE se o INSERT foi efetivo.
  -- Chamadas manuais/telefônicas (p_conversa_id NULL, v_resp_desde NULL)
  -- sempre incrementam porque o conflito parcial não as alcança (v_rows = 1).
  if v_rows > 0 then
    update public.fila_receptivo
       set atendimentos_hoje = case when data_referencia = v_hoje then atendimentos_hoje + 1 else 1 end,
           data_referencia   = v_hoje,
           ultimo_atendimento = now(),
           online_em          = now()
     where email = p_email;
  end if;

  return v_rows > 0;
end;
$function$;

REVOKE ALL ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) FROM anon;
REVOKE ALL ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) FROM authenticated;
GRANT EXECUTE ON FUNCTION public.fila_receptivo_registrar_atendimento(text, uuid) TO service_role;

-- 5b. A RPC pública: a MESMA trava de antes + o registro. Assinatura,
--     retorno (void) e grants de produção preservados.
CREATE OR REPLACE FUNCTION public.fila_receptivo_marcar_atendido(
  p_email text, p_conversa_id uuid DEFAULT NULL::uuid, p_canal text DEFAULT NULL::text)
RETURNS void
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $function$
begin
  -- Guard de autenticação: operador só registra o próprio atendimento.
  -- usuario_e_gestao_fila() cobre: allowlist de gestão + perfis gerencia,
  -- supervisor e administrativo em public.usuarios (inclui supervisão).
  -- Preserva: FilaReceptivo botão "Marcar" na linha alheia, usado por gestão/supervisão.
  if lower(p_email) <> lower(coalesce(auth.email(), '')) then
    if not coalesce(public.usuario_e_gestao_fila(), false) then
      raise exception 'não autorizado: somente gestão ou supervisão pode registrar atendimento para outro operador'
        using errcode = '42501';
    end if;
  end if;

  perform public.fila_receptivo_registrar_atendimento(p_email, p_conversa_id);
end;
$function$;

REVOKE ALL ON FUNCTION public.fila_receptivo_marcar_atendido(text, uuid, text) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.fila_receptivo_marcar_atendido(text, uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.fila_receptivo_marcar_atendido(text, uuid, text) TO authenticated;
GRANT EXECUTE ON FUNCTION public.fila_receptivo_marcar_atendido(text, uuid, text) TO service_role;

-- ---------------------------------------------------------------------
-- 6. Trigger: primeira resposta ENVIADA no ciclo -> 1 atendimento na fila
--
--    Conta quando, todas:
--      * a saída é ENVIADO, TEMPO_REAL, com operador (cláusula WHEN);
--      * quem enviou é o responsável atual da conversa (o ciclo é
--        (conversa, responsavel_email, responsavel_desde));
--      * a conversa estava AGUARDANDO RESPOSTA do aluno — o mesmo critério
--        que a tela usava no assumir (aguardando_resposta); conversa que o
--        operador abriu por abordagem ativa não é receptivo;
--      * é a PRIMEIRA saída ENVIADO dele no ciclo. Isso também impede que
--        conversa que ele já vinha atendendo antes da publicação conte no
--        dia da publicação.
--    "Uma vez por ciclo" é garantido pela chave existente
--    uq_receptivo_log_operador_ciclo, inclusive entre duas respostas
--    simultâneas e entre este trigger e a RPC antiga.
--
--    NOME COM "a0": gatilhos AFTER do mesmo evento disparam em ordem
--    alfabética. Este precisa rodar ANTES de trg_whatsapp_aguardando, que
--    zera aguardando_resposta quando a saída é gravada.
--
--    FALHA ABERTO, de propósito: quando ele roda, a mensagem já saiu para o
--    aluno. Erro aqui não pode desfazer o registro da mensagem; vira
--    WARNING no log e o atendimento deixa de ser contado.
-- ---------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.whatsapp_receptivo_atendimento_na_resposta()
RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $function$
DECLARE
  v_op         text := lower(NEW.enviado_por_email);
  v_resp       text;
  v_desde      timestamptz;
  v_aguardando boolean;
BEGIN
  BEGIN
    SELECT lower(cv.responsavel_email), cv.responsavel_desde, cv.aguardando_resposta
      INTO v_resp, v_desde, v_aguardando
      FROM public.whatsapp_conversas cv
     WHERE cv.id = NEW.conversa_id;

    IF v_desde IS NULL OR v_resp IS DISTINCT FROM v_op OR NOT COALESCE(v_aguardando, false) THEN
      RETURN NULL;
    END IF;

    IF EXISTS (
      SELECT 1 FROM public.whatsapp_mensagens m
       WHERE m.conversa_id = NEW.conversa_id
         AND m.id <> NEW.id
         AND m.direcao = 'SAIDA'
         AND m.status = 'ENVIADO'
         AND lower(m.enviado_por_email) = v_op
         AND m.criado_em >= v_desde
    ) THEN
      RETURN NULL;
    END IF;

    PERFORM public.fila_receptivo_registrar_atendimento(v_op, NEW.conversa_id);

  EXCEPTION WHEN OTHERS THEN
    RAISE WARNING 'whatsapp_receptivo_atendimento_na_resposta: atendimento nao contado (conversa %, sqlstate %)',
      NEW.conversa_id, SQLSTATE;
  END;
  RETURN NULL;
END;
$function$;

REVOKE ALL ON FUNCTION public.whatsapp_receptivo_atendimento_na_resposta() FROM PUBLIC;
REVOKE ALL ON FUNCTION public.whatsapp_receptivo_atendimento_na_resposta() FROM anon;
REVOKE ALL ON FUNCTION public.whatsapp_receptivo_atendimento_na_resposta() FROM authenticated;

DROP TRIGGER IF EXISTS trg_whatsapp_a0_receptivo_atendimento ON public.whatsapp_mensagens;
CREATE TRIGGER trg_whatsapp_a0_receptivo_atendimento
  AFTER INSERT ON public.whatsapp_mensagens
  FOR EACH ROW
  WHEN (NEW.direcao = 'SAIDA'
        AND NEW.status = 'ENVIADO'
        AND NEW.enviado_por_email IS NOT NULL
        AND NEW.origem = 'TEMPO_REAL')
  EXECUTE FUNCTION public.whatsapp_receptivo_atendimento_na_resposta();

-- ---------------------------------------------------------------------
-- 7. Verificação final: falha fechado se o estado não ficou como esperado
-- ---------------------------------------------------------------------
DO $verifica$
DECLARE
  v_teto  integer;
  v_resp  integer;
  v_fora  integer;
  v_src   text;
  v_trg   boolean;
  v_ordem text[];
BEGIN
  SELECT teto_abordagens_operador, resposta_janela_horas INTO v_teto, v_resp
    FROM public.whatsapp_config LIMIT 1;
  IF v_teto IS DISTINCT FROM 10 THEN
    RAISE EXCEPTION 'teto_abordagens_operador = %, esperado 10', v_teto USING ERRCODE = '22023';
  END IF;
  IF v_resp IS DISTINCT FROM 24 THEN
    RAISE EXCEPTION 'resposta_janela_horas deveria seguir 24 e esta %', v_resp USING ERRCODE = '22023';
  END IF;

  SELECT count(*) INTO v_fora FROM public.whatsapp_canais
   WHERE limite_abordagens_operador IS DISTINCT FROM 10;
  IF v_fora > 0 THEN
    RAISE EXCEPTION '% canais fora do limite 10', v_fora USING ERRCODE = '22023';
  END IF;

  SELECT p.prosrc INTO v_src
    FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
   WHERE n.nspname = 'public' AND p.proname = 'whatsapp_cadencia_checar';
  IF v_src NOT ILIKE '%CONTINUIDADE%' OR v_src NOT ILIKE '%whatsapp_cadencia_sem_limite_individual%' THEN
    RAISE EXCEPTION 'checar sem CONTINUIDADE ou sem a regra por perfil' USING ERRCODE = '22023';
  END IF;

  SELECT tgenabled <> 'D' INTO v_trg FROM pg_trigger
   WHERE tgname = 'trg_whatsapp_a0_receptivo_atendimento'
     AND tgrelid = 'public.whatsapp_mensagens'::regclass;
  IF NOT COALESCE(v_trg, false) THEN
    RAISE EXCEPTION 'trigger do atendimento receptivo ausente ou desligado' USING ERRCODE = '22023';
  END IF;

  -- O trigger tem de disparar ANTES de trg_whatsapp_aguardando.
  SELECT array_agg(tgname::text ORDER BY tgname) INTO v_ordem FROM pg_trigger
   WHERE tgrelid = 'public.whatsapp_mensagens'::regclass AND NOT tgisinternal
     AND tgname IN ('trg_whatsapp_a0_receptivo_atendimento', 'trg_whatsapp_aguardando');
  IF array_length(v_ordem, 1) = 2 AND v_ordem[1] <> 'trg_whatsapp_a0_receptivo_atendimento' THEN
    RAISE EXCEPTION 'ordem dos gatilhos errada: %', v_ordem USING ERRCODE = '22023';
  END IF;

  -- Grants: o que produção tinha antes, nem mais nem menos.
  IF has_function_privilege('authenticated', 'public.whatsapp_cadencia_checar(uuid, uuid, text)', 'EXECUTE')
     OR has_function_privilege('anon', 'public.whatsapp_cadencia_checar(uuid, uuid, text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'whatsapp_cadencia_checar executavel por authenticated/anon' USING ERRCODE = '42501';
  END IF;
  IF has_function_privilege('authenticated', 'public.whatsapp_cadencia_sem_limite_individual(text)', 'EXECUTE')
     OR has_function_privilege('anon', 'public.whatsapp_cadencia_sem_limite_individual(text)', 'EXECUTE')
     OR has_function_privilege('authenticated', 'public.fila_receptivo_registrar_atendimento(text, uuid)', 'EXECUTE')
     OR has_function_privilege('anon', 'public.fila_receptivo_registrar_atendimento(text, uuid)', 'EXECUTE') THEN
    RAISE EXCEPTION 'funcao interna executavel por authenticated/anon' USING ERRCODE = '42501';
  END IF;
  IF NOT has_function_privilege('authenticated', 'public.whatsapp_cadencia_consumo()', 'EXECUTE')
     OR has_function_privilege('anon', 'public.whatsapp_cadencia_consumo()', 'EXECUTE')
     OR NOT has_function_privilege('authenticated', 'public.fila_receptivo_marcar_atendido(text, uuid, text)', 'EXECUTE')
     OR has_function_privilege('anon', 'public.fila_receptivo_marcar_atendido(text, uuid, text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'grants de consumo / marcar_atendido fora do estado de producao' USING ERRCODE = '42501';
  END IF;

  RAISE NOTICE 'cota 10 ATIVA + receptivo na fila: teto=%, canais=10, CONTINUIDADE preservada, trigger ligado', v_teto;
END $verifica$;
