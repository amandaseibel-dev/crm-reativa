-- OTIMIZACAO DO UNIVERSO (custo), empilhada sobre a #941 (f6424128). Separada das regras de elegibilidade.
-- Ordem de implantacao: 1) migration da #941 (20261112235500); 2) esta.
-- Mudancas, todas por patch ancorado:
--   (a) aluno_movimentacoes (mov) passa a ser lida so para os alunos de pop;
--   (b) a funcao de tipo (tc) passa a receber os ids de pop em vez de v_ids (NULL = base inteira);
--   (c) mov e tc passam a ser calculadas depois de pop (pop nao usa mov nem tc: sem circularidade);
--   (d) o predicado de cobertura de tipo (funcao IMMUTABLE com SET search_path, nao inlinavel: uma
--       chamada por linha, sem uso de indice em tipo) e substituido pela mesma lista literal, que o
--       planejador pode usar com o indice (tipo, registrado_em). Equivalencia: corpo da funcao, testado.
-- Equivalencia: mov e tc entram so por LEFT JOIN em cls, por aluno_id de pop.
BEGIN;

DO $g$
BEGIN
  IF (SELECT md5(pg_get_functiondef(p.oid)) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'public' AND p.proname = 'acoes_massivas_universo') IS DISTINCT FROM '52f8ca6c4e4428e9dc5d0912e2b9751a' THEN
    RAISE EXCEPTION 'Universo nao esta na versao da #941 (esperado 52f8ca6c...). Nada aplicado.';
  END IF;
END $g$;

SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a1$  tc as materialized (
    select t.aluno_id, t.tem_mensalidade, t.tem_acordo_vencido
      from public.acoes_massivas_tipo_cobranca_alunos(v_ids) t
  ),
$a1$, '  -- tc: calculada depois de pop (otimizacao de custo)
', 1);
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a2$  mov as materialized (
    select m.aluno_id,
           max(m.registrado_em) as ult,
           bool_or(m.registrado_em >= v_mes_ini) as mes,
           bool_or(m.registrado_em >= v_hoje_ini) as hoje,
           max(m.registrado_em) filter (where m.tipo = any(v_tipos_massivo)) as ult_mass
      from public.aluno_movimentacoes m
     where public.acoes_massivas_tipo_cobertura(m.tipo)
       and (v_ids_txt is null or m.aluno_id = any(v_ids_txt))
       and not exists (
         select 1 from public.acoes_desfazer ad
          where ad.movimentacao_id = m.id and ad.desfeito_em is not null)
     group by m.aluno_id
  ),
$a2$, '  -- mov: calculada depois de pop (otimizacao de custo)
', 1);
SELECT internal.patch_funcao_ancorada('public', 'acoes_massivas_universo',
$a3$  cls as materialized ($a3$,
$n3$  mov as materialized (
    select m.aluno_id,
           max(m.registrado_em) as ult,
           bool_or(m.registrado_em >= v_mes_ini) as mes,
           bool_or(m.registrado_em >= v_hoje_ini) as hoje,
           max(m.registrado_em) filter (where m.tipo = any(v_tipos_massivo)) as ult_mass
      from public.aluno_movimentacoes m
     where coalesce(m.tipo, '') in ('FINALIZACAO_ATENDIMENTO', 'FINALIZACAO', 'CONTATO', 'LINK_ENVIADO_AO_ALUNO', 'SOLICITACAO_LINK_PAGAMENTO', 'ACAO_MASSIVA_EXTERNA', 'ACAO_MASSIVA_EXTERNA_EMAIL')
       and (v_ids_txt is null or m.aluno_id = any(v_ids_txt))
       and m.aluno_id in (select p0.id::text from pop p0)
       and not exists (
         select 1 from public.acoes_desfazer ad
          where ad.movimentacao_id = m.id and ad.desfeito_em is not null)
     group by m.aluno_id
  ),
  tc as materialized (
    select t.aluno_id, t.tem_mensalidade, t.tem_acordo_vencido
      from public.acoes_massivas_tipo_cobranca_alunos(array(select p0.id from pop p0)) t
  ),
  cls as materialized ($n3$, 1);

-- Reconfirmacao de ACL (CREATE OR REPLACE nao garante o ACL publicado): so authenticated e service_role.
REVOKE ALL ON FUNCTION public.acoes_massivas_universo(jsonb) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.acoes_massivas_universo(jsonb) TO authenticated, service_role;

DO $m$
BEGIN
  IF (SELECT md5(pg_get_functiondef(p.oid)) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'public' AND p.proname = 'acoes_massivas_universo') IS DISTINCT FROM '941a3de82f87d03e08d4f14043f907fb' THEN
    RAISE EXCEPTION 'MD5 final otimizado diferente do validado.';
  END IF;
END $m$;

COMMIT;
