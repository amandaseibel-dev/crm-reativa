-- ASSUMIR CASO COM FIDELIZACAO VENCIDA + RECUPERACAO POR OPERACAO.
--
-- STATUS: PENDENTE. Nao aplicar sem autorizacao especifica e executor unico
-- (sessao principal). Esta migration NAO altera internal.pode_alterar_responsavel,
-- alterar_responsavel_aluno, assumir_caso_livre, nem nenhuma policy ou grant existente.
--
-- PRE-CONDICOES (a migration FALHA se qualquer uma faltar; nao aplica pela metade):
--   P1. gatilho trg_acionamento_nao_volta_para_nulo em public.alunos, com a funcao
--       public._acionamento_nao_volta_para_nulo (migration 20260828010000).
--       Sem ele, trocar o responsavel zera data_ultimo_acionamento e status_acionamento.
--   P2. public.aluno_retorno_operador_vigente(uuid), entregue pela PR #936 (migration
--       20261112210000). Esta RPC NAO copia essa regra: chama a mesma funcao. Por isso
--       esta migration so pode ser aplicada DEPOIS da #936.
--   P3. internal.operador_pode_receber_caso(text) e internal.pode_alterar_responsavel().
--
-- QUEM PODE: somente usuario ativo, com perfil = 'operador' e recebe_novos_casos = true.
-- Contas de gestao NAO usam esta acao; continuam no fluxo administrativo existente.
--
-- ELEGIBILIDADE (mesma base da liberacao automatica, lida DEPOIS do lock):
--   * ultimo acionamento valido = maior entre alunos.data_ultimo_acionamento e
--     casos.data_ultimo_acionamento; nulo ou com mais de 10 dias;
--   * responsavel do aluno sem troca nos ultimos 10 dias (impede repasses sucessivos:
--     quem recebeu o caso tem o prazo inteiro para atender);
--   * sem retorno agendado vigente pelo operador (aluno_retorno_operador_vigente, P2);
--   * caso nao protegido, nao encerrado, nao congelado; saldo em aberto > 0;
--   * caso de giro vigente fica FORA nesta entrega (documentado na tela e na PR);
--   * dono atual precisa ser operador ativo (senao o caso segue a regra da carteira livre);
--   * responsavel do aluno e dono do caso devem ser a mesma pessoa (ambiguidade).
--
-- ATOMICIDADE: trava aluno e depois caso (ordem dos caminhos de acionamento). Um
-- acionamento que grava so em alunos OU so em casos entra na leitura feita depois do lock.
-- Teto: pg_advisory_xact_lock por operador antes de contar.
--
-- RECUSAS: mensagem unica. Quem nao e o dono nao aprende nada sobre o caso.
--
-- RECUPERACAO: cada tomada gera uma linha em public.assumir_fidelizacao_operacoes com id.
-- A reversao (reverter_assumir_fidelizacao) so volta a tomada se o caso ainda estiver
-- com o novo responsavel E ele nao tiver acionado nem movimentado o aluno depois da
-- tomada. Nunca apaga historico: marca a operacao como revertida e registra a reversao.

-- ---------------------------------------------------------------------------
-- P1-P3: falha cedo, com mensagem clara
-- ---------------------------------------------------------------------------
do $pre$
begin
  if not exists (select 1 from pg_trigger t join pg_class c on c.oid = t.tgrelid
                  where c.relname = 'alunos' and t.tgname = 'trg_acionamento_nao_volta_para_nulo' and not t.tgisinternal) then
    raise exception 'PRE-CONDICAO P1 ausente: trigger trg_acionamento_nao_volta_para_nulo em public.alunos (migration 20260828010000).';
  end if;
  -- P1 DIVERGENTE: o corpo da funcao tem de ser o de producao (md5 do prosrc).
  if coalesce((select md5(p.prosrc) from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                where n.nspname = 'public' and p.proname = '_acionamento_nao_volta_para_nulo'), '') <> 'ccbc6aea6bb27b7497b008abb53bb58a' then
    raise exception 'PRE-CONDICAO P1 divergente: public._acionamento_nao_volta_para_nulo nao confere com producao (md5 ccbc6aea...).';
  end if;
  if not exists (select 1 from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                  where n.nspname = 'public' and p.proname = 'aluno_retorno_operador_vigente') then
    raise exception 'PRE-CONDICAO P2 ausente: public.aluno_retorno_operador_vigente(uuid). Aplicar a PR #936 antes.';
  end if;
  -- P2 DIVERGENTE: tem de ser o corpo da #936 (md5 25412bfe...), nao outra versao.
  if coalesce((select md5(p.prosrc) from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                where n.nspname = 'public' and p.proname = 'aluno_retorno_operador_vigente'), '') <> '25412bfe933b6abcf9194a216a2e6fcd' then
    raise exception 'PRE-CONDICAO P2 divergente: aluno_retorno_operador_vigente nao confere com a PR #936 (md5 25412bfe...).';
  end if;
  if not exists (select 1 from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                  where n.nspname = 'internal' and p.proname = 'operador_pode_receber_caso')
     or not exists (select 1 from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                  where n.nspname = 'internal' and p.proname = 'pode_alterar_responsavel') then
    raise exception 'PRE-CONDICAO P3 ausente: internal.operador_pode_receber_caso e internal.pode_alterar_responsavel.';
  end if;
end
$pre$;

-- ---------------------------------------------------------------------------
-- Tabela de operacoes (historico proprio; sem acesso direto do cliente)
-- ---------------------------------------------------------------------------
create table if not exists public.assumir_fidelizacao_operacoes (
  id uuid primary key default gen_random_uuid(),
  criado_em timestamptz not null default now(),
  aluno_id uuid not null,
  caso_id uuid not null,
  responsavel_anterior_email text,
  responsavel_anterior_nome text,
  responsavel_novo_email text not null,
  responsavel_novo_nome text,
  data_ultimo_acionamento_antes date,
  -- BACKUP por operacao, gravado ANTES da troca: linha do caso e do aluno como estavam.
  snapshot_caso jsonb,
  snapshot_aluno jsonb,
  -- estado de origem que a troca de dono zera (proxima_acao, data_retorno, hora_retorno)
  estado_anterior jsonb not null default '{}'::jsonb,
  -- estado DEPOIS da tomada: a reversao so volta se tudo isso ainda for verdade
  estado_pos jsonb,
  motivo text not null,
  autor_email text not null,
  revertida_em timestamptz,
  revertida_por text,
  motivo_reversao text
);
alter table public.assumir_fidelizacao_operacoes enable row level security;
revoke all on public.assumir_fidelizacao_operacoes from public, anon, authenticated;
comment on table public.assumir_fidelizacao_operacoes is
  'Operacoes de assumir caso com fidelizacao vencida. Sem acesso direto; so pelas RPCs. Nunca apagar linhas.';

-- ---------------------------------------------------------------------------
-- RPC: assumir
-- ---------------------------------------------------------------------------
create or replace function public.assumir_caso_fidelizacao_vencida(p_aluno_id uuid, p_motivo text)
returns table(sucesso boolean, mensagem text, operacao_id uuid)
language plpgsql
security definer
set search_path to 'public'
as $fn$
declare
  v_email text;
  v_nome text;
  v_motivo text;
  v_al record;
  v_c record;
  v_ultimo date;
  v_ant_email text;
  v_ant_nome text;
  v_teto int;
  v_count int;
  v_op uuid;
  v_msg constant text := 'Este caso nao esta disponivel para assumir.';
begin
  v_email := lower(coalesce(auth.jwt() ->> 'email', ''));
  if v_email = '' then
    return query select false, 'Usuario nao identificado. Faca login novamente.', null::uuid; return;
  end if;

  -- QUEM PODE (R5): operador ativo, perfil operador, recebendo casos.
  if not exists (select 1 from public.usuarios u
                  where lower(u.email) = v_email and u.ativo and u.perfil = 'operador'
                    and coalesce(u.recebe_novos_casos, false)) then
    return query select false, 'Esta acao e exclusiva de operadores ativos habilitados a receber casos.', null::uuid; return;
  end if;
  v_nome := public.nome_operador_por_email(v_email);
  if v_nome is null or not internal.operador_pode_receber_caso(v_email) then
    return query select false, 'Esta acao e exclusiva de operadores ativos habilitados a receber casos.', null::uuid; return;
  end if;

  v_motivo := nullif(btrim(coalesce(p_motivo, '')), '');
  if v_motivo is null then
    return query select false, 'Informe o motivo da assuncao.', null::uuid; return;
  end if;

  -- TRAVA: aluno primeiro, depois caso (mesma ordem dos caminhos de acionamento).
  select a.id, a.responsavel_atual_email, a.responsavel_atual_em, a.data_ultimo_acionamento
    into v_al
    from public.alunos a where a.id = p_aluno_id for update;
  if not found then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- Um aluno pode ter um caso encerrado e outro aberto (indice parcial): escolhe o aberto.
  select c.*, public.saldo_titulos_aberto(c.cpf_limpo) as _saldo into v_c
    from public.casos c
   where c.aluno_id = p_aluno_id
     and not public.caso_encerrado_operacional(c.cpf_limpo, c.status_atual, c.status_acionamento,
           c.status_financeiro, c.status_jornada)
   for update;
  if not found then
    return query select false, v_msg, null::uuid; return;
  end if;

  if coalesce(v_c.operador_email, '') = '' or lower(v_c.operador_email) = v_email then
    return query select false, v_msg, null::uuid; return;
  end if;
  if lower(v_c.operador_email) = internal.carteira_geral_email()
     or not exists (select 1 from public.usuarios u
                     where lower(u.email) = lower(v_c.operador_email) and u.ativo and u.perfil = 'operador') then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- AMBIGUIDADE: responsavel do aluno e dono do caso sao a mesma pessoa.
  -- Sem responsavel ou sem data da troca nao da para provar o prazo de 10 dias: recusa.
  if v_al.responsavel_atual_email is null or v_al.responsavel_atual_em is null
     or lower(v_al.responsavel_atual_email) <> lower(v_c.operador_email) then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- GIRO: fora desta entrega (ver PR).
  if public.caso_em_giro_fidelizacao(v_c.giro_fidelizacao_ate) then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- PRAZO: ultimo acionamento valido entre aluno e caso, lido depois do lock.
  -- alunos.data_ultimo_acionamento e timestamptz: vira data de Brasilia. casos.data_ultimo_acionamento
  -- e DATE: usa direto (converter date via timezone() passa por timestamptz em UTC e recua um dia).
  v_ultimo := greatest(
    (v_al.data_ultimo_acionamento at time zone 'America/Sao_Paulo')::date,
    v_c.data_ultimo_acionamento);
  -- Prazo em DATA DE BRASILIA explicita (a sessao do banco esta em UTC).
  if v_ultimo is not null and v_ultimo + 10 >= (now() at time zone 'America/Sao_Paulo')::date then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- R2: quem recebeu o caso ha menos de 10 dias nao perde o caso.
  if (v_al.responsavel_atual_em at time zone 'America/Sao_Paulo')::date
       > (now() at time zone 'America/Sao_Paulo')::date - 10 then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- RETORNO vigente pelo operador (regra da #936, P2).
  if public.aluno_retorno_operador_vigente(p_aluno_id) then
    return query select false, v_msg, null::uuid; return;
  end if;

  if public.caso_protegido_redistribuicao(v_c.cpf_limpo, v_c.status_acionamento, v_c.nao_acionar,
       v_c.status_financeiro, v_c.valor_pago, v_c.quitado_em, v_c.valor_quitado)
     or public.caso_encerrado_operacional(v_c.cpf_limpo, v_c.status_atual, v_c.status_acionamento,
       v_c.status_financeiro, v_c.status_jornada)
     or public.caso_encerramento_congelado(v_c.id)
     or coalesce(v_c._saldo, 0) <= 0 then
    return query select false, v_msg, null::uuid; return;
  end if;

  -- TETO: serializado por operador; conta a mesma base do trigger de teto.
  perform pg_advisory_xact_lock(hashtext('assumir_teto:' || v_email));
  v_teto := public.calibragem_teto_operador(v_email);
  v_count := (select count(*) from public.casos c where c.operador_email = v_email
                 and not public.caso_protegido_redistribuicao(c.cpf_limpo, c.status_acionamento, c.nao_acionar,
                       c.status_financeiro, c.valor_pago, c.quitado_em, c.valor_quitado)
                 and not public.caso_encerrado_operacional(c.cpf_limpo, c.status_atual, c.status_acionamento,
                       c.status_financeiro, c.status_jornada));
  if v_count >= v_teto then
    return query select false, v_msg, null::uuid; return;
  end if;

  v_ant_email := lower(v_c.operador_email);
  v_ant_nome := coalesce(v_c.operador_nome, v_c.operador_email);

  -- Operacao gravada ANTES da troca, para a reversao ter o estado de origem.
  insert into public.assumir_fidelizacao_operacoes
    (aluno_id, caso_id, responsavel_anterior_email, responsavel_anterior_nome,
     responsavel_novo_email, responsavel_novo_nome, data_ultimo_acionamento_antes,
     snapshot_caso, snapshot_aluno, estado_anterior, motivo, autor_email)
  select p_aluno_id, v_c.id, v_ant_email, v_ant_nome, v_email, v_nome, v_ultimo,
         jsonb_build_object('id', v_c.id, 'operador_email', v_c.operador_email, 'operador_nome', v_c.operador_nome,
                            'operador', v_c.operador, 'data_ultimo_acionamento', v_c.data_ultimo_acionamento,
                            'status_acionamento', v_c.status_acionamento, 'caso_atualizado_em', v_c.caso_atualizado_em),
         jsonb_build_object('id', a.id, 'responsavel_atual_email', a.responsavel_atual_email,
                            'responsavel_atual_nome', a.responsavel_atual_nome, 'responsavel_atual_em', a.responsavel_atual_em,
                            'data_ultimo_acionamento', a.data_ultimo_acionamento, 'status_acionamento', a.status_acionamento,
                            'proxima_acao', a.proxima_acao, 'data_retorno', a.data_retorno, 'hora_retorno', a.hora_retorno),
         jsonb_build_object('proxima_acao', a.proxima_acao, 'data_retorno', a.data_retorno, 'hora_retorno', a.hora_retorno),
         v_motivo, v_email
    from public.alunos a where a.id = p_aluno_id
  returning id into v_op;

  perform internal.set_resp_aluno(p_aluno_id, v_email, v_nome, 'ASSUMIR_FIDELIZACAO_VENCIDA',
    'Assumido de '||v_ant_nome||' (fidelizacao vencida; ultimo acionamento '||coalesce(v_ultimo::text,'nunca')||
    '). Operacao '||v_op::text||'. Motivo: '||v_motivo, v_email, v_nome);

  update public.casos set operador_email = v_email, operador_nome = v_nome, operador = upper(v_nome),
    caso_atualizado_por = v_email, caso_atualizado_em = now()
  where id = v_c.id;

  insert into public.historico_operadores_alunos
    (chave_unificacao, nome_aluno, cpf_referencia, acao,
     operador_anterior_nome, operador_anterior_email, operador_nome, operador_email, observacao, criado_em)
  values (v_c.chave_unificacao, v_c.nome, v_c.cpf, 'ASSUMIR_FIDELIZACAO_VENCIDA',
     v_ant_nome, v_ant_email, v_nome, v_email,
     'Operacao '||v_op::text||'. Responsavel anterior: '||v_ant_email||'. Novo: '||v_email||
     '. Data: '||now()::text||'. Autor: '||v_email||'. Motivo: '||v_motivo||'.', now());

  -- estado pos-tomada, para a reversao comparar com o que existe no momento de reverter
  update public.assumir_fidelizacao_operacoes
     set estado_pos = (select jsonb_build_object('caso_operador_email', v_email,
                                         'aluno_responsavel_email', v_email,
                                         'data_ultimo_acionamento', v_ultimo,
                                         'proxima_acao', a.proxima_acao,
                                         'data_retorno', a.data_retorno,
                                         'hora_retorno', a.hora_retorno)
                         from public.alunos a where a.id = p_aluno_id)
   where id = v_op;

  return query select true, 'Caso assumido. Ele fica com voce por 10 dias a partir de agora, sem repasse.', v_op;
end;
$fn$;

revoke all on function public.assumir_caso_fidelizacao_vencida(uuid, text) from public, anon;
grant execute on function public.assumir_caso_fidelizacao_vencida(uuid, text) to authenticated;

-- ---------------------------------------------------------------------------
-- RPC: reverter uma operacao (somente gestao, pelo flag existente)
-- ---------------------------------------------------------------------------
create or replace function public.reverter_assumir_fidelizacao(p_operacao_id uuid, p_motivo text)
returns table(sucesso boolean, mensagem text)
language plpgsql
security definer
set search_path to 'public'
as $fn$
declare
  v_email text;
  v_nome text;
  v_op record;
  v_c record;
  v_ant_nome text;
  v_motivo text;
  v_al public.alunos;
  v_teto int;
  v_count int;
begin
  v_email := lower(coalesce(auth.jwt() ->> 'email', ''));
  if v_email = '' or not internal.pode_alterar_responsavel() then
    return query select false, 'Sem permissao para reverter.'; return;
  end if;
  v_motivo := nullif(btrim(coalesce(p_motivo, '')), '');
  if v_motivo is null then
    return query select false, 'Informe o motivo da reversao.'; return;
  end if;

  select o.* into v_op from public.assumir_fidelizacao_operacoes o
   where o.id = p_operacao_id for update;
  if not found then
    return query select false, 'Operacao nao encontrada.'; return;
  end if;
  if v_op.revertida_em is not null then
    return query select false, 'Esta operacao ja foi revertida.'; return;
  end if;

  select a.* into v_al from public.alunos a where a.id = v_op.aluno_id for update;
  select c.* into v_c from public.casos c where c.id = v_op.caso_id for update;
  if not found then
    return query select false, 'Caso da operacao nao existe mais.'; return;
  end if;

  -- Conflito 1: o caso mudou de dono depois da tomada. Decisao da gestao, nao automatica.
  if lower(coalesce(v_c.operador_email, '')) <> lower(v_op.responsavel_novo_email) then
    return query select false, 'Conflito: o caso mudou de responsavel depois desta operacao. Nao revertido.'; return;
  end if;

  -- Conflito 0: o estado atual nao e o estado que a propria tomada deixou (backup por operacao).
  if v_op.estado_pos is null
     or lower(coalesce(v_c.operador_email, '')) <> lower(v_op.estado_pos->>'caso_operador_email')
     or lower(coalesce(v_al.responsavel_atual_email, '')) <> lower(v_op.estado_pos->>'aluno_responsavel_email')
     or v_al.proxima_acao is distinct from v_op.estado_pos->>'proxima_acao'
     or v_al.data_retorno::text is distinct from nullif(v_op.estado_pos->>'data_retorno', '')
     or v_al.hora_retorno::text is distinct from nullif(v_op.estado_pos->>'hora_retorno', '') then
    return query select false, 'Conflito: o estado atual nao e o da tomada. Nao revertido.'; return;
  end if;

  -- Conflito 2: houve acionamento depois da tomada. O ultimo acionamento (aluno ou caso)
  -- tem de ser o mesmo que existia ANTES da tomada. Qualquer mudanca, de qualquer autor
  -- (inclusive data nula), conta como atendimento posterior.
  if greatest(
       (v_al.data_ultimo_acionamento at time zone 'America/Sao_Paulo')::date,
       v_c.data_ultimo_acionamento)
       is distinct from v_op.data_ultimo_acionamento_antes then
    return query select false, 'Conflito: houve atendimento depois desta tomada. Nao revertido.'; return;
  end if;
  -- Conflito 2b: qualquer movimentacao do aluno depois da tomada (de qualquer autor).
  if exists (select 1 from public.aluno_movimentacoes m
              where m.aluno_id = v_op.aluno_id::text and m.registrado_em > v_op.criado_em) then
    return query select false, 'Conflito: houve movimentacao do aluno depois desta tomada. Nao revertido.'; return;
  end if;

  -- Conflito 3: o anterior nao pode receber o caso de volta (ativo, perfil operador,
  -- recebendo casos e com vaga no teto vigente).
  if v_op.responsavel_anterior_email is null
     or not exists (select 1 from public.usuarios u
                     where lower(u.email) = lower(v_op.responsavel_anterior_email) and u.ativo
                       and u.perfil = 'operador' and coalesce(u.recebe_novos_casos, false)) then
    return query select false, 'Conflito: o responsavel anterior nao pode receber o caso. Decisao da gestao.'; return;
  end if;
  -- Mesma serializacao do teto da tomada, por operador (evita duas reversoes/tomadas furarem o teto).
  perform pg_advisory_xact_lock(hashtext('assumir_teto:' || lower(v_op.responsavel_anterior_email)));
  v_teto := public.calibragem_teto_operador(lower(v_op.responsavel_anterior_email));
  v_count := (select count(*) from public.casos c where c.operador_email = lower(v_op.responsavel_anterior_email)
                 and not public.caso_protegido_redistribuicao(c.cpf_limpo, c.status_acionamento, c.nao_acionar,
                       c.status_financeiro, c.valor_pago, c.quitado_em, c.valor_quitado)
                 and not public.caso_encerrado_operacional(c.cpf_limpo, c.status_atual, c.status_acionamento,
                       c.status_financeiro, c.status_jornada));
  if v_count >= v_teto then
    return query select false, 'Conflito: o responsavel anterior esta no limite de casos. Decisao da gestao.'; return;
  end if;

  v_nome := public.nome_operador_por_email(v_email);
  v_ant_nome := coalesce(v_op.responsavel_anterior_nome, v_op.responsavel_anterior_email);

  perform internal.set_resp_aluno(v_op.aluno_id, v_op.responsavel_anterior_email, v_ant_nome,
    'REVERTER_ASSUMIR_FIDELIZACAO', 'Reversao da operacao '||v_op.id::text||'. Motivo: '||v_motivo,
    v_email, v_nome);

  -- Restaura o que a troca de dono zerou (retorno e proxima acao do operador de origem).
  update public.alunos a
     set proxima_acao = r.proxima_acao, data_retorno = r.data_retorno, hora_retorno = r.hora_retorno
    from jsonb_populate_record(null::public.alunos, v_op.estado_anterior) r
   where a.id = v_op.aluno_id;

  update public.casos set operador_email = lower(v_op.responsavel_anterior_email), operador_nome = v_ant_nome,
    operador = upper(v_ant_nome), caso_atualizado_por = v_email, caso_atualizado_em = now()
  where id = v_op.caso_id;

  update public.assumir_fidelizacao_operacoes
     set revertida_em = now(), revertida_por = v_email, motivo_reversao = v_motivo
   where id = v_op.id;

  insert into public.historico_operadores_alunos
    (chave_unificacao, nome_aluno, cpf_referencia, acao,
     operador_anterior_nome, operador_anterior_email, operador_nome, operador_email, observacao, criado_em)
  select c.chave_unificacao, c.nome, c.cpf, 'REVERTER_ASSUMIR_FIDELIZACAO',
     v_op.responsavel_novo_nome, v_op.responsavel_novo_email, v_ant_nome, lower(v_op.responsavel_anterior_email),
     'Reversao da operacao '||v_op.id::text||'. Autor: '||v_email||'. Motivo: '||v_motivo||'.', now()
    from public.casos c where c.id = v_op.caso_id;

  return query select true, 'Operacao revertida. Caso devolvido a '||v_ant_nome||'.';
end;
$fn$;

revoke all on function public.reverter_assumir_fidelizacao(uuid, text) from public, anon;
grant execute on function public.reverter_assumir_fidelizacao(uuid, text) to authenticated;
