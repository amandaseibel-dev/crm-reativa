-- ---------------------------------------------------------------------------
-- 1) GUARDS. Qualquer divergencia entre o que foi validado e o que esta no
--    banco AGORA aborta a transacao inteira.
-- ---------------------------------------------------------------------------
do $$
declare
  v_qtd int; v_soma numeric; v_falha int; v_txt text;
begin
  -- 1.1 a lista chegou inteira
  select count(*) into v_qtd from _g1_lista;
  if v_qtd <> 65 then
    raise exception 'ABORTA: lista com % linhas, esperado 65', v_qtd;
  end if;

  -- 1.2 todo titulo da lista existe
  select count(*) into v_falha from _g1_lista l
   where not exists (select 1 from public.acordos_titulos t where t.id = l.titulo_id);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) da lista nao existem mais', v_falha;
  end if;

  -- 1.3 estado anterior esperado: NEGOCIADO / vinculada
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where upper(coalesce(t.situacao,'')) <> 'NEGOCIADO'
      or lower(coalesce(t.status,'')) <> 'vinculada';
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) nao estao mais NEGOCIADO/vinculada', v_falha;
  end if;

  -- 1.4 acordo_id ainda e o mesmo da validacao
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.acordo_id is distinct from l.acordo_id;
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) trocaram de acordo desde a validacao', v_falha;
  end if;

  -- 1.5 vinculo vivo apontando para o MESMO acordo
  select count(*) into v_falha
    from _g1_lista l
   where not exists (select 1 from public.acordo_titulo_vinculo v
                      where v.titulo_id = l.titulo_id and v.acordo_id = l.acordo_id
                        and coalesce(v.ativo, true));
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) perderam o vinculo ativo com o acordo', v_falha;
  end if;

  -- 1.6 o acordo continua QUITADO
  select count(*) into v_falha
    from (select distinct acordo_id from _g1_lista) x
    join public.acordos a on a.id = x.acordo_id
   where upper(coalesce(a.status,'')) <> 'QUITADO';
  if v_falha > 0 then
    raise exception 'ABORTA: % acordo(s) nao estao mais QUITADO', v_falha;
  end if;

  -- 1.7 quitado DE VERDADE: nenhuma parcela viva (mesmo predicado de titulo_reavaliar)
  select count(*) into v_falha
    from (select distinct acordo_id from _g1_lista) x
   where exists (select 1 from public.parcelas p
                  where p.acordo_id = x.acordo_id
                    and upper(coalesce(p.status,'')) not in ('PAGO','CANCELADA','RENEGOCIADA'));
  if v_falha > 0 then
    raise exception 'ABORTA: % acordo(s) voltaram a ter parcela viva', v_falha;
  end if;

  -- 1.8 nenhum e o boleto do proprio acordo
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where coalesce(t.tipo_boleto,'') = 'Acordo';
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) sao boleto do proprio acordo', v_falha;
  end if;

  -- 1.9 nenhuma marca terminal que os gatilhos de protecao fossem sequestrar
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.origem_liquidacao is not null or t.origem_encerramento is not null;
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) ganharam origem_liquidacao/origem_encerramento', v_falha;
  end if;

  -- 1.10 soma financeira identica a validada
  select round(sum(coalesce(t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0)), 2)
    into v_soma
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id;
  if v_soma <> 41642.41 then
    raise exception 'ABORTA: soma % diferente da validada 41642.41', v_soma;
  end if;

  -- 1.11 valor por titulo identico ao validado
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where round(coalesce(t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0), 2)
         <> round(l.valor_esperado, 2);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) mudaram de valor desde a validacao', v_falha;
  end if;

  raise notice 'GUARDS OK: 65 titulos, R$ 41.642,41, 44 acordos QUITADO sem parcela viva';
end $$;

-- ---------------------------------------------------------------------------
-- 2) BACKUP POR ID -- registro completo antes, vinculos, acordo, motivo
-- ---------------------------------------------------------------------------
create table if not exists public._backup_saneamento_g1_20260924 (
  titulo_id uuid primary key,
  registro_anterior jsonb not null,
  vinculos_anteriores jsonb not null,
  acordo_id uuid,
  acordo_numero text,
  acordo_status_no_backup text,
  situacao_anterior text,
  status_anterior text,
  acordo_id_anterior uuid,
  origem_liquidacao_anterior text,
  origem_liquidacao_ref_anterior text,
  origem_liquidacao_em_anterior timestamptz,
  origem_encerramento_anterior text,
  quitacao_origem_anterior text,
  quitacao_origem_acordo_id_anterior uuid,
  motivo_ajuste_anterior text,
  motivo_correcao text not null,
  feito_em timestamptz not null default now()
);

insert into public._backup_saneamento_g1_20260924 (
  titulo_id, registro_anterior, vinculos_anteriores, acordo_id, acordo_numero,
  acordo_status_no_backup, situacao_anterior, status_anterior, acordo_id_anterior,
  origem_liquidacao_anterior, origem_liquidacao_ref_anterior, origem_liquidacao_em_anterior,
  origem_encerramento_anterior, quitacao_origem_anterior, quitacao_origem_acordo_id_anterior,
  motivo_ajuste_anterior, motivo_correcao)
select t.id, to_jsonb(t),
       coalesce((select jsonb_agg(to_jsonb(v)) from public.acordo_titulo_vinculo v where v.titulo_id = t.id), '[]'::jsonb),
       a.id, a.numero_acordo::text, a.status,
       t.situacao, t.status, t.acordo_id,
       t.origem_liquidacao, t.origem_liquidacao_ref, t.origem_liquidacao_em,
       t.origem_encerramento, t.quitacao_origem, t.quitacao_origem_acordo_id,
       t.motivo_ajuste,
       'G1 24/09/2026: mensalidade NEGOCIADO em acordo QUITADO de verdade (todas as parcelas PAGO). Reavaliada pelo motor oficial titulo_reavaliar para PAGO/quitada.'
  from _g1_lista l
  join public.acordos_titulos t on t.id = l.titulo_id
  join public.acordos a on a.id = l.acordo_id
on conflict (titulo_id) do nothing;

do $$
declare v_qtd int;
begin
  select count(*) into v_qtd from public._backup_saneamento_g1_20260924;
  if v_qtd <> 65 then
    raise exception 'ABORTA: backup com % linhas, esperado 65', v_qtd;
  end if;
end $$;

-- ---------------------------------------------------------------------------
-- 3) A CORRECAO -- motor oficial, um titulo por vez
-- ---------------------------------------------------------------------------
do $$
declare v_id uuid; v_n int := 0;
begin
  for v_id in select titulo_id from _g1_lista order by titulo_id loop
    perform public.titulo_reavaliar(v_id);
    v_n := v_n + 1;
  end loop;
  raise notice 'titulo_reavaliar executado em % titulos', v_n;
end $$;

-- ---------------------------------------------------------------------------
-- 4) VALIDACAO AUTOMATICA -- se nao ficou como esperado, a transacao cai
-- ---------------------------------------------------------------------------
do $$
declare v_falha int; v_ok int;
begin
  -- 4.1 os 65 ficaram PAGO/quitada
  select count(*) into v_ok
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where upper(coalesce(t.situacao,'')) = 'PAGO' and lower(coalesce(t.status,'')) = 'quitada';
  if v_ok <> 65 then
    raise exception 'ABORTA: % de 65 ficaram PAGO/quitada', v_ok;
  end if;

  -- 4.2 continuam vinculados ao MESMO acordo, na coluna e na tabela de vinculo
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where t.acordo_id is distinct from l.acordo_id;
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) perderam o acordo_id', v_falha;
  end if;

  select count(*) into v_falha
    from _g1_lista l
   where not exists (select 1 from public.acordo_titulo_vinculo v
                      where v.titulo_id = l.titulo_id and v.acordo_id = l.acordo_id
                        and coalesce(v.ativo, true));
  if v_falha > 0 then
    raise exception 'ABORTA: % vinculo(s) sumiram', v_falha;
  end if;

  -- 4.3 proveniencia gravada (so vale se o arquivo 1 ja tiver sido aplicado)
  if exists (select 1 from information_schema.columns
              where table_schema='public' and table_name='acordos_titulos'
                and column_name='quitacao_origem') then
    select count(*) into v_falha
      from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
     where coalesce(t.quitacao_origem,'') <> 'ACORDO'
        or t.quitacao_origem_acordo_id is distinct from l.acordo_id;
    if v_falha > 0 then
      raise exception 'ABORTA: % titulo(s) sem proveniencia ACORDO gravada (o arquivo 1 rodou?)', v_falha;
    end if;
  end if;

  -- 4.4 nenhum valor foi mexido
  select count(*) into v_falha
    from _g1_lista l join public.acordos_titulos t on t.id = l.titulo_id
   where round(coalesce(t.saldo_corrigido, t.valor_em_aberto, t.valor_original, 0), 2)
         <> round(l.valor_esperado, 2);
  if v_falha > 0 then
    raise exception 'ABORTA: % titulo(s) tiveram valor alterado', v_falha;
  end if;

  -- 4.5 nenhuma parcela dos 44 acordos foi tocada
  select count(*) into v_falha
    from (select distinct acordo_id from _g1_lista) x
    join public.parcelas p on p.acordo_id = x.acordo_id
   where upper(coalesce(p.status,'')) <> 'PAGO';
  if v_falha > 0 then
    raise exception 'ABORTA: % parcela(s) deixaram de estar PAGO', v_falha;
  end if;

  -- 4.6 nenhum acordo mudou de status
  select count(*) into v_falha
    from (select distinct acordo_id from _g1_lista) x
    join public.acordos a on a.id = x.acordo_id
   where upper(coalesce(a.status,'')) <> 'QUITADO';
  if v_falha > 0 then
    raise exception 'ABORTA: % acordo(s) mudaram de status', v_falha;
  end if;

  raise notice 'VALIDACAO OK: 65 PAGO/quitada, vinculos e valores intactos, parcelas e acordos inalterados';
end $$;

commit;
