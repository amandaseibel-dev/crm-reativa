-- REAGENDAMENTO EXPLICITO E PORTAO DO RECALCULO
-- ==============================================================================
-- NAO APLICADO. Pacote para aprovacao final. Ordem de aplicacao:
--   1. 20261113120000_retorno_tratado_nao_herda_selo_do_operador.sql.pendente
--      (parte 1: a origem nao herda o selo; corpo 41475103b8b7ad363dfdc76c4170c5a8 -> 03dacc0abb23490a8e060c4f86e0df94)
--   2. este arquivo (corpo 03dacc0abb23490a8e060c4f86e0df94 -> 42e9ddf7d9393d12e6d4078c14a6a2f1).
--
-- O QUE FAZ
--   A. BACKUP POR ID: copia data_retorno, hora_retorno, retorno_origem,
--      retorno_confirmado_em e retorno_prioritario das linhas com retorno, ANTES
--      de qualquer troca. E a evidencia para reconstruir o que a virada mudou.
--   B. RPC public.agenda_reagendar_retorno: UNICO caminho que zera
--      retorno_confirmado_em por reagendamento humano. Exige sessao; so o dono
--      atual do caso ou a gestao chama. Trava a linha (for update).
--   C. PORTAO em public.recalcular_situacao_aluno: com sessao de usuario so
--      recalcula o aluno dele ou se for gestao. Sem sessao (cron da virada 06:00
--      UTC, triggers de backend, service_role) passa como antes.
--
-- O QUE NAO FAZ: nao altera gatilho; nao escreve retorno em aluno nenhum; nao
-- reconstroi confirmacao alguma.
--
-- CONSUMIDORES DO RECALCULO A CONFIRMAR ANTES DE APLICAR:
--   * cron 3, recalcular_situacao_virada_diaria (sem sessao) -- passa;
--   * triggers de acionamento, vinculo, pagamento, conferencia Prime, acordo
--     (rodam na sessao de quem grava) -- passam se quem grava e o dono ou gestao;
--   * RPCs de gestao (encerramento, troca de dono) -- gestao passa.
--   Operador que grava em caso de OUTRO operador, sem ser gestao, passa a
--   receber "Sem permissao". E o efeito pretendido, mas precisa de confirmacao.
--
-- ROLLBACK: 20261114120000_agenda_reagendar_retorno_e_portao_recalculo.rollback.sql

begin;

-- A. BACKUP POR ID -------------------------------------------------------------
create table if not exists public.retorno_backup_20261114 (
  id                    bigint generated by default as identity primary key,
  capturado_em          timestamptz not null default now(),
  motivo                text not null,
  aluno_id              uuid not null,
  data_retorno          date,
  hora_retorno          text,
  retorno_origem        text,
  retorno_confirmado_em timestamptz,
  retorno_prioritario   boolean
);
revoke all on table public.retorno_backup_20261114 from public, anon, authenticated;

insert into public.retorno_backup_20261114
  (motivo, aluno_id, data_retorno, hora_retorno, retorno_origem, retorno_confirmado_em, retorno_prioritario)
select 'pre_20261114', id, data_retorno, hora_retorno, retorno_origem, retorno_confirmado_em, retorno_prioritario
  from public.alunos
 where data_retorno is not null or retorno_confirmado_em is not null;

-- B. RPC DE REAGENDAMENTO EXPLICITO --------------------------------------------
create or replace function public.agenda_reagendar_retorno(
  p_aluno_id uuid,
  p_data date,
  p_hora text default null,
  p_prioritario boolean default false
)
 returns timestamptz
 language plpgsql
 security definer
 set search_path to 'public', 'auth'
as $function$
declare
  v_email text := lower(coalesce(auth.email(), ''));
  v_dono text;
  v_gestao text[] := array['amanda.seibel@aelbra.com.br','cobranca04@aelbra.com.br'];
begin
  if auth.uid() is null or v_email = '' then
    raise exception 'Sem sessao autenticada';
  end if;
  if p_data is null then
    raise exception 'Informe a data do retorno';
  end if;
  select lower(responsavel_atual_email) into v_dono
    from public.alunos where id = p_aluno_id for update;
  if not found then
    raise exception 'Aluno nao encontrado';
  end if;
  if not (v_email = coalesce(v_dono, '') or v_email = any(v_gestao)) then
    raise exception 'Sem permissao para reagendar o retorno deste aluno';
  end if;
  update public.alunos
     set data_retorno = p_data,
         hora_retorno = nullif(p_hora, ''),
         retorno_origem = 'OPERADOR',
         retorno_prioritario = coalesce(p_prioritario, false),
         retorno_confirmado_em = null
   where id = p_aluno_id;
  return now();
end $function$;

revoke all on function public.agenda_reagendar_retorno(uuid, date, text, boolean) from public, anon;
grant execute on function public.agenda_reagendar_retorno(uuid, date, text, boolean) to authenticated;

-- C. PORTAO DO RECALCULO -------------------------------------------------------
do $portao$
declare
  v_assin constant text := 'public.recalcular_situacao_aluno(uuid,text)';
  v_ancora constant text := $a$  if p_aluno_id is null then return jsonb_build_object('erro','sem_aluno'); end if;$a$;
  v_troca constant text := $n$  if p_aluno_id is null then return jsonb_build_object('erro','sem_aluno'); end if;
  -- PORTAO (14/11/2026): com sessao de usuario so recalcula o aluno dele, ou se for gestao.
  -- Sem sessao (cron da virada, triggers de backend, service_role) passa como antes.
  if auth.uid() is not null
     and lower(coalesce(auth.email(), '')) <> all (array['amanda.seibel@aelbra.com.br','cobranca04@aelbra.com.br'])
     and lower(coalesce(auth.email(), '')) is distinct from (select lower(responsavel_atual_email) from public.alunos where id = p_aluno_id) then
    raise exception 'Sem permissao para recalcular a situacao deste aluno';
  end if;$n$;
  v_oid oid := to_regprocedure(v_assin);
  v_def text; v_nova text; v_md5_antes text; v_md5_depois text;
  v_guarda_antes text; v_guarda_depois text; v_n int;
begin
  if v_oid is null then raise exception 'FUNCAO AUSENTE: %', v_assin; end if;
  v_def := pg_get_functiondef(v_oid);
  select md5(p.prosrc),
         concat_ws('|', p.proowner::text, p.prosecdef::text, coalesce(p.proconfig::text, ''), coalesce(p.proacl::text, ''))
    into v_md5_antes, v_guarda_antes from pg_proc p where p.oid = v_oid;

  if v_md5_antes = '42e9ddf7d9393d12e6d4078c14a6a2f1' then
    raise notice 'portao do recalculo: ja aplicado, nada a fazer.';
    return;
  end if;
  if v_md5_antes <> '03dacc0abb23490a8e060c4f86e0df94' then
    raise exception 'CORPO INESPERADO em %: md5(prosrc) e %, esperado 03dacc0abb23490a8e060c4f86e0df94 (corpo depois da parte 1). Aplicar a parte 1 antes, ou reconferir.', v_assin, v_md5_antes;
  end if;

  v_n := (length(v_def) - length(replace(v_def, v_ancora, ''))) / length(v_ancora);
  if v_n <> 1 then
    raise exception 'ANCORA NAO BATE em %: % ocorrencia(s), esperado 1.', v_assin, v_n;
  end if;

  v_nova := replace(v_def, v_ancora, v_troca);
  execute v_nova;

  select md5(p.prosrc),
         concat_ws('|', p.proowner::text, p.prosecdef::text, coalesce(p.proconfig::text, ''), coalesce(p.proacl::text, ''))
    into v_md5_depois, v_guarda_depois from pg_proc p where p.oid = v_oid;
  if v_guarda_depois is distinct from v_guarda_antes then
    raise exception 'DONO/DEFINER/CONFIG/GRANTS mudaram em %', v_assin;
  end if;
  if v_md5_depois <> '42e9ddf7d9393d12e6d4078c14a6a2f1' then
    raise exception 'RESULTADO INESPERADO em %: md5(prosrc) ficou %, previsto 42e9ddf7d9393d12e6d4078c14a6a2f1', v_assin, v_md5_depois;
  end if;
end $portao$;

commit;
