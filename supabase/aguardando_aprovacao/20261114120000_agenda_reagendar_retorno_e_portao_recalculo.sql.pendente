-- REAGENDAMENTO HUMANO EXPLICITO, BACKUP POR ID E FIM DO GATILHO DE ZERAGEM
-- ==============================================================================
-- NAO APLICADO. Pacote para aprovacao final. Ordem:
--   1. 20261113120000_retorno_tratado_nao_herda_selo_do_operador.sql.pendente
--      (parte 1: corpo de recalcular 41475103 -> 03dacc0a)
--   2. este arquivo (muda o corpo de recalcular so na leitura travada, secao D:
--      03dacc0a -> c3e38ac0; ACL e gatilho como descrito abaixo).
--
-- O QUE FAZ
--   A. BACKUP POR ID dos campos de retorno, antes de qualquer troca. Tabela com
--      RLS ligada e SEM politica (deny-all), sem grant para anon/authenticated.
--      Gravacao idempotente: so grava se ainda nao houver snapshot desta
--      migration. A restauracao por id NAO faz parte deste pacote executavel (proposta
--      em docs/seguranca/propostas-nao-executaveis/, nao aplicada).
--   B. Remove o gatilho trg_aluno_reset_retorno_confirmado. Nenhuma mudanca de
--      data por gravacao comum ou automatica zera "Ja falei".
--   C. RPC public.agenda_reagendar_retorno: UNICO caminho de agendamento humano
--      que zera retorno_confirmado_em. Vale mesmo com data e hora iguais.
--      Autorizacao por operacao: sessao + usuario ativo + (dono atual do caso
--      OU public.usuario_e_gestao(), gate ja existente). Nada de lista nova.
--   D. Recalcular_situacao_aluno: NAO recebe portao de dono no corpo. ACL MEDIDA
--      em producao (catalogo, 15/11/2026, so leitura): dono postgres; EXECUTE para
--      authenticated e service_role; public e anon SEM EXECUTE. Logo o revoke de
--      public/anon e no-op medido. O revoke de authenticated (secao E) e o efeito
--      real, e preserva service_role e os caminhos internos (chamadores SECURITY
--      DEFINER de dono postgres; nenhum chamada a funcao por RPC no front).
--
-- TRAVAS: md5(prosrc) de recalcular antes = 03dacc0a... (parte 1) e depois =
-- c3e38ac0... (secao D). A mudanca de ACL (secao E) nao altera md5(prosrc).
--
-- CONTRATO DE "JA FALEI" (confirmado no pacote, sem bloquear toda mudanca de data):
--   * gravacoes AUTOMATICAS (tabulacao, lote, virada diaria) podem mudar
--     data_retorno e NAO zeram retorno_confirmado_em. Nenhum gatilho de banco
--     zera "Ja falei" por mudanca de data (trg_aluno_reset_retorno_confirmado sai).
--   * somente o REAGENDAMENTO EXPLICITO, pela RPC agenda_reagendar_retorno,
--     zera retorno_confirmado_em (mesmo com data e hora iguais).
--   * mudanca comum de data/hora NAO e recusada (nem na tela nem no banco) e NAO
--     zera "Ja falei": o banco nao tem gatilho que zere, e a gravacao comum nao
--     envia retorno_confirmado_em. Provado no banco por UPDATE direto como
--     authenticated (supabase/tests/reagendamento_explicito_comportamento.test.js).
--   * reagendamento humano explicito (PainelCarteira e checkbox da Aluno) usa so a RPC:
--     a RPC e a unica escritora de data/hora/origem/prioridade nesse caminho.
--
-- MEDICAO DE PRODUCAO (catalogo, leitura, 15/11/2026): recalcular_situacao_aluno
--   md5 41475103 (corpo ainda o anterior; parte 1 nao aplicada); ACL: authenticated
--   e service_role com EXECUTE; anon e PUBLIC SEM EXECUTE. agenda_reagendar_retorno
--   NAO existe em producao (pacote nao aplicado). usuario_e_gestao(): lista literal
--   de tres e-mails, search_path=public.
--
-- ACHADO PREEXISTENTE, SEPARADO DESTE PACOTE: na troca de responsavel
--   (alterarOperadorResponsavel, Aluno.jsx) o resultado do update da tabulacao
--   nao e checado; uma falha ali segue para o alerta de sucesso. Nao corrigido aqui.

-- ROLLBACK: 20261114120000_agenda_reagendar_retorno_e_portao_recalculo.rollback.sql

begin;

-- A. BACKUP POR ID -------------------------------------------------------------
create table if not exists public.retorno_backup_20261114 (
  id                    bigint generated by default as identity primary key,
  capturado_em          timestamptz not null default now(),
  motivo                text not null,
  aluno_id              uuid not null,
  data_retorno          date,
  hora_retorno          text,
  retorno_origem        text,
  retorno_confirmado_em timestamptz,
  retorno_prioritario   boolean
);
alter table public.retorno_backup_20261114 enable row level security;
-- sem politica alguma: RLS ligada = deny-all para anon e authenticated
revoke all on table public.retorno_backup_20261114 from public, anon, authenticated;

-- Idempotencia por MARCADOR de execucao (linha 'run_20261114'), gravado sempre
-- que o bloco roda, inclusive quando nao ha alunos para copiar.
do $backup$
begin
  if exists (select 1 from public.retorno_backup_20261114 where motivo = 'run_20261114') then
    raise notice 'backup 20261114 ja foi executado: nao grava de novo (idempotente).';
  else
    insert into public.retorno_backup_20261114
      (motivo, aluno_id, data_retorno, hora_retorno, retorno_origem, retorno_confirmado_em, retorno_prioritario)
    select 'pre_20261114', id, data_retorno, hora_retorno, retorno_origem, retorno_confirmado_em, retorno_prioritario
      from public.alunos
     where data_retorno is not null or retorno_confirmado_em is not null;
    insert into public.retorno_backup_20261114 (motivo, aluno_id)
    values ('run_20261114', '00000000-0000-0000-0000-000000000000');
  end if;
end $backup$;

-- B. SEM GATILHO DE ZERAGEM POR DATA --------------------------------------------
drop trigger if exists trg_aluno_reset_retorno_confirmado on public.alunos;

-- B2. "JA FALEI" ZERA SO POR ACAO EXPLICITA AUTORIZADA (IMPOSTO NO BANCO) -------
-- A policy alunos_update deixa o responsavel atual alterar qualquer coluna. Sem a
-- trava, um UPDATE direto zerava retorno_confirmado_em. A trava recusa nao-nulo ->
-- nulo quando o PAPEL ATUAL e authenticated ou anon. Dentro de funcao SECURITY DEFINER
-- (dono postgres) o papel atual e o dono: passam as RPCs agenda_confirmar_retorno
-- (confirmar e desfazer), agenda_reagendar_retorno e atendimento_reagendar_com_status,
-- cada uma com a propria autorizacao. Nao usa GUC: GUC e controlavel pelo cliente.
create or replace function public.tg_alunos_confirmacao_so_reagendamento()
returns trigger
language plpgsql
as $f$
begin
  if current_user in ('authenticated', 'anon') then
    raise exception 'Ja falei so zera por acao explicita autorizada (confirmar, desfazer ou reagendar)'
      using errcode = '42501';
  end if;
  return new;
end
$f$;

drop trigger if exists trg_alunos_confirmacao_so_reagendamento on public.alunos;
create trigger trg_alunos_confirmacao_so_reagendamento
  before update of retorno_confirmado_em on public.alunos
  for each row
  when (old.retorno_confirmado_em is not null and new.retorno_confirmado_em is null)
  execute function public.tg_alunos_confirmacao_so_reagendamento();

-- C. RPC DE REAGENDAMENTO HUMANO EXPLICITO -------------------------------------
create or replace function public.agenda_reagendar_retorno(
  p_aluno_id uuid,
  p_data date,
  p_hora text default null,
  p_prioritario boolean default false
)
 returns timestamptz
 language plpgsql
 security definer
 set search_path to 'public', 'auth'
as $function$
declare
  v_email text := lower(coalesce(auth.email(), ''));
  v_dono text;
begin
  if auth.uid() is null or v_email = '' then
    raise exception 'Sem sessao autenticada' using errcode = '42501';
  end if;
  if not exists (select 1 from public.usuarios u where lower(u.email) = v_email and u.ativo is true) then
    raise exception 'Sem permissao: usuario inativo ou sem cadastro' using errcode = '42501';
  end if;
  if p_data is null then
    raise exception 'Informe a data do retorno';
  end if;
  select lower(responsavel_atual_email) into v_dono
    from public.alunos where id = p_aluno_id for update;
  if not found then
    raise exception 'Aluno nao encontrado';
  end if;
  if not (v_email = coalesce(v_dono, '') or public.usuario_e_gestao()) then
    raise exception 'Sem permissao para reagendar o retorno deste aluno' using errcode = '42501';
  end if;
  update public.alunos
     set data_retorno = p_data,
         hora_retorno = nullif(p_hora, ''),
         retorno_origem = 'OPERADOR',
         retorno_prioritario = coalesce(p_prioritario, false),
         retorno_confirmado_em = null
   where id = p_aluno_id;
  return now();
end $function$;

revoke all on function public.agenda_reagendar_retorno(uuid, date, text, boolean) from public, anon;
grant execute on function public.agenda_reagendar_retorno(uuid, date, text, boolean) to authenticated;

-- B3. CONFIRMAR/DESFAZER: GATE COM USUARIO ATIVO E E-MAIL (fecha fail-open) ----
-- Corpo igual ao da migration 20260808150000, com duas correcoes de autorizacao:
-- (a) exige usuario ativo em usuarios; (b) recusa sessao sem e-mail (antes,
-- '' = coalesce(dono,'') autorizava aluno sem responsavel). Lista de gestao NAO muda.
create or replace function public.agenda_confirmar_retorno(
  p_aluno_id uuid,
  p_confirmar boolean default true
)
 returns timestamptz
 language plpgsql
 security definer
 set search_path to 'public', 'auth'
as $function$
declare
  v_email text := lower(coalesce(auth.email(), ''));
  v_gestao text[] := array['amanda.seibel@aelbra.com.br','cobranca04@aelbra.com.br'];
  v_dono text;
  v_novo timestamptz;
begin
  if v_email = '' then
    raise exception 'Sem sessao autenticada com e-mail' using errcode = '42501';
  end if;
  if not exists (select 1 from public.usuarios u where lower(u.email) = v_email and u.ativo is true) then
    raise exception 'Sem permissao: usuario inativo ou sem cadastro' using errcode = '42501';
  end if;
  select lower(responsavel_atual_email) into v_dono
    from public.alunos where id = p_aluno_id;
  if not found then
    raise exception 'Aluno nao encontrado';
  end if;
  if not (v_email = coalesce(v_dono, '') or v_email = any(v_gestao)) then
    raise exception 'Sem permissao para confirmar o retorno deste aluno' using errcode = '42501';
  end if;
  v_novo := case when p_confirmar then now() else null end;
  update public.alunos
    set retorno_confirmado_em = v_novo
    where id = p_aluno_id;
  return v_novo;
end
$function$;

revoke all on function public.agenda_confirmar_retorno(uuid, boolean) from public, anon;
grant execute on function public.agenda_confirmar_retorno(uuid, boolean) to authenticated, service_role;

-- C2. REAGENDAMENTO + STATUS DO ATENDIMENTO EM UMA TRANSACAO -------------------
-- Antes, a tela chamava a RPC e depois fazia UPDATE de status: duas transacoes. Esta
-- funcao roda as duas na mesma transacao: se a escrita de status falhar, o
-- reagendamento tambem e desfeito. Autorizacao: a da RPC interna (sessao, usuario
-- ativo, dono ou gestao). Campos de status: lista fixa abaixo.
create or replace function public.atendimento_reagendar_com_status(
  p_aluno_id uuid,
  p_data date,
  p_hora text default null,
  p_prioritario boolean default false,
  p_status jsonb default '{}'::jsonb
)
 returns timestamptz
 language plpgsql
 security definer
 set search_path to 'public', 'auth'
as $function$
declare
  v_ret timestamptz;
begin
  v_ret := public.agenda_reagendar_retorno(p_aluno_id, p_data, p_hora, p_prioritario);
  update public.alunos
     set status_jornada = coalesce(p_status->>'status_jornada', status_jornada),
         status_atual = coalesce(p_status->>'status_atual', status_atual),
         proxima_acao = coalesce(p_status->>'proxima_acao', proxima_acao),
         data_ultimo_acionamento = coalesce((p_status->>'data_ultimo_acionamento')::timestamptz, data_ultimo_acionamento),
         ultimo_contato = coalesce((p_status->>'ultimo_contato')::timestamptz, ultimo_contato),
         registrado_por_nome = coalesce((select u.nome from public.usuarios u where lower(u.email) = lower(coalesce(auth.email(), ''))), registrado_por_nome),
         registrado_por_email = lower(coalesce(auth.email(), '')),
         registrado_em = coalesce((p_status->>'registrado_em')::timestamptz, registrado_em),
         observacao = coalesce(p_status->>'observacao', observacao)
   where id = p_aluno_id;
  return v_ret;
end
$function$;

revoke all on function public.atendimento_reagendar_com_status(uuid, date, text, boolean, jsonb) from public, anon;
grant execute on function public.atendimento_reagendar_com_status(uuid, date, text, boolean, jsonb) to authenticated;

-- D. LEITURA TRAVADA NO RECALCULO (correcao do D5) -----------------------------
-- A leitura inicial do recalculo passa a travar a linha do aluno (for update).
-- Sem isso, um reagendamento confirmado entre a leitura e a escrita e sobrescrito
-- (reproduzido em Postgres 17.6 com duas conexoes: tests/concorrencia/).
-- Ordem de locks resultante dentro do recalculo: alunos -> casos. E a mesma do
-- gatilho de acionamento (trg_sync_acionamento_alunos_para_casos). A lista de
-- caminhos conferidos e cobertos esta na descricao da PR, nao em garantia geral.
-- Travas: md5 antes 03dacc0a (parte 1), md5 depois c3e38ac0.
do $locka$
declare
  v_assin constant text := 'public.recalcular_situacao_aluno(uuid,text)';
  v_ancora constant text := $a$from public.alunos where id=p_aluno_id;$a$;
  v_troca constant text := $n$from public.alunos where id=p_aluno_id for update;$n$;
  v_oid oid := to_regprocedure(v_assin);
  v_def text; v_nova text; v_md5_antes text; v_md5_depois text;
  v_guarda_antes text; v_guarda_depois text; v_n int;
begin
  if v_oid is null then raise exception 'FUNCAO AUSENTE: %', v_assin; end if;
  v_def := pg_get_functiondef(v_oid);
  select md5(p.prosrc),
         concat_ws('|', p.proowner::text, p.prosecdef::text, coalesce(p.proconfig::text, ''), coalesce(p.proacl::text, ''))
    into v_md5_antes, v_guarda_antes from pg_proc p where p.oid = v_oid;
  if v_md5_antes = 'c3e38ac06719b886297369e1f0e507aa' then
    raise notice 'leitura travada: ja aplicada, nada a fazer.';
    return;
  end if;
  if v_md5_antes <> '03dacc0abb23490a8e060c4f86e0df94' then
    raise exception 'CORPO INESPERADO em %: md5(prosrc) e %, esperado 03dacc0a (corpo da parte 1).', v_assin, v_md5_antes;
  end if;
  v_n := (length(v_def) - length(replace(v_def, v_ancora, ''))) / length(v_ancora);
  if v_n <> 1 then raise exception 'ANCORA NAO BATE: % ocorrencia(s), esperado 1.', v_n; end if;
  v_nova := replace(v_def, v_ancora, v_troca);
  execute v_nova;
  select md5(p.prosrc),
         concat_ws('|', p.proowner::text, p.prosecdef::text, coalesce(p.proconfig::text, ''), coalesce(p.proacl::text, ''))
    into v_md5_depois, v_guarda_depois from pg_proc p where p.oid = v_oid;
  if v_guarda_depois is distinct from v_guarda_antes then
    raise exception 'DONO/DEFINER/CONFIG/ACL mudaram em %', v_assin;
  end if;
  if v_md5_depois <> 'c3e38ac06719b886297369e1f0e507aa' then
    raise exception 'RESULTADO INESPERADO: md5 %, previsto c3e38ac0', v_md5_depois;
  end if;
end $locka$;

-- E. RECALCULO SEM EXECUCAO DIRETA DE AUTHENTICATED ----------------------------
-- ACL de origem medida (ver cabecalho D): authenticated e service_role com EXECUTE.
-- Chamadores internos sao SECURITY DEFINER de dono postgres (medido), que nao
-- dependem do EXECUTE de authenticated. Sem chamada por RPC no front.
-- Revoga public, anon e authenticated; service_role permanece (explicito abaixo).
revoke all on function public.recalcular_situacao_aluno(uuid, text) from public, anon, authenticated;
grant execute on function public.recalcular_situacao_aluno(uuid, text) to service_role;

commit;
