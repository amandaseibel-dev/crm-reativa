{
  "description": "Guardião do ReATIVA One: bloqueia, no instante da chamada, o que reescreve produção, publica, mescla, mexe na branch principal, edita o ledger, despeja segredo ou sai do escopo declarado. Cobre Bash, Edit/Write, os MCPs (por sufixo do nome da ferramenta), o terminal do app e o navegador. Ao fim da sessão, avisa se a camada de permissões foi alterada.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guardiao.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guardiao.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guardiao.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guardiao.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guardiao.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guardiao.sh\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/aviso-final.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
