+// Status de importação: duas grafias convivem em `importacoes.status` e as duas
+// são verdade.
+//
+// `public.importar_acordos` grava 'Concluída' (acentuado, caixa de frase);
+// borderô, projeção e os demais tipos gravam 'CONCLUIDO'. Medido em produção
+// em 07/11/2026: ACORDOS/Concluída=157, BORDERO/CONCLUIDO=159,
+// PROJECAO_DIARIA/CONCLUIDO=338. A divergência é segregada por tipo -- não há
+// mistura dentro de um mesmo tipo.
+//
+// Hoje nenhum filtro erra por causa disso: todo consumidor é recortado por
+// `tipo` na origem (`relatorio_importacoes_bordero` tem where tipo='BORDERO';
+// `importacao_conferencia_arquivos` tem where tipo in ('PROJECAO_DIARIA',
+// 'PROJECAO_RETROATIVA')). Este util existe para que a primeira leitura SEM
+// esse recorte não nasça errada.
+//
+// Não normaliza o dado gravado. Normaliza a LEITURA.
+
+const CONCLUIDOS = new Set(["CONCLUIDO", "CONCLUIDA"]);
+
+/** Remove acento e sobe a caixa, para 'Concluída' e 'CONCLUIDO' caírem no mesmo lugar. */
+export function normalizarStatusImportacao(status) {
+  if (status === null || status === undefined) return "";
+  return String(status)
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .trim()
+    .toUpperCase();
+}
+
+/** true para 'CONCLUIDO', 'Concluída', 'CONCLUÍDA', 'concluido'. */
+export function ehImportacaoConcluida(status) {
+  return CONCLUIDOS.has(normalizarStatusImportacao(status));
+}
+
+/** O inverso, para quem lê "ainda não terminou" -- status ausente NÃO é travado. */
+export function ehImportacaoTravada(status) {
+  const s = normalizarStatusImportacao(status);
+  if (s === "") return false;
+  return !CONCLUIDOS.has(s);
+}
--- /dev/null
+++ b/src/utils/statusImportacao.test.js
@@ -0,0 +1,41 @@
+import { describe, it, expect } from "vitest";
+import {
+  normalizarStatusImportacao,
+  ehImportacaoConcluida,
+  ehImportacaoTravada,
+} from "./statusImportacao";
+
+describe("statusImportacao", () => {
+  it("aceita as duas grafias que existem em producao", () => {
+    // ACORDOS (157 linhas) e BORDERO/PROJECAO (499 linhas), medido 07/11/2026
+    expect(ehImportacaoConcluida("Concluída")).toBe(true);
+    expect(ehImportacaoConcluida("CONCLUIDO")).toBe(true);
+  });
+
+  it("aceita variacoes de caixa e acento sem inventar status novo", () => {
+    expect(ehImportacaoConcluida("CONCLUÍDA")).toBe(true);
+    expect(ehImportacaoConcluida("concluido")).toBe(true);
+    expect(ehImportacaoConcluida(" Concluída ")).toBe(true);
+  });
+
+  it("nao confunde os outros status reais da tabela", () => {
+    expect(ehImportacaoConcluida("PROCESSANDO")).toBe(false);
+    expect(ehImportacaoConcluida("SUBSTITUIDA")).toBe(false);
+    expect(ehImportacaoConcluida("EXCLUIDA")).toBe(false);
+  });
+
+  it("status ausente nao e concluido NEM travado", () => {
+    // a aba de acordos nao expoe status; ausencia nao e defeito
+    expect(ehImportacaoConcluida(null)).toBe(false);
+    expect(ehImportacaoTravada(null)).toBe(false);
+    expect(ehImportacaoTravada(undefined)).toBe(false);
+    expect(ehImportacaoTravada("")).toBe(false);
+  });
+
+  it("travada e o complemento, para os status que existem", () => {
+    expect(ehImportacaoTravada("PROCESSANDO")).toBe(true);
+    expect(ehImportacaoTravada("Concluída")).toBe(false);
+  });
+
+  it("normalizar nao muda o dado, so a leitura", () => {
+    expect(normalizarStatusImportacao("Concluída")).toBe("CONCLUIDA");
+    expect(normalizarStatusImportacao("CONCLUIDO")).toBe("CONCLUIDO");
+  });
+});

