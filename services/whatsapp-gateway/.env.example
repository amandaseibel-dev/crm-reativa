# ---------------------------------------------------------------------------
# Espelho do WhatsApp — variáveis de ambiente
#
# NENHUMA credencial de banco mora aqui. Se esta máquina for invadida, o
# atacante NÃO ganha acesso ao Supabase: ele só consegue falar com as Edge
# Functions do WhatsApp, e apenas com o segredo abaixo.
# ---------------------------------------------------------------------------

# Base das Edge Functions do projeto (produção).
CRM_URL=https://ahattpqrjmhkzsmnbdzs.functions.supabase.co

# Segredo compartilhado com as Edge Functions (HMAC-SHA256).
# Gere com:  openssl rand -hex 32
# O MESMO valor vai no secret WHATSAPP_GATEWAY_SEGREDO do Supabase.
CRM_SEGREDO=troque-por-um-segredo-de-64-hex

# Token que as Edge Functions usam para MANDAR comando neste serviço
# (enviar mensagem, conectar, desconectar). Gere outro, diferente do de cima.
# O MESMO valor vai no secret WHATSAPP_GATEWAY_TOKEN do Supabase.
GATEWAY_TOKEN=troque-por-outro-segredo

# Os 2 números. A `chave` precisa ser IDÊNTICA à coluna sessao_chave da tabela
# whatsapp_canais — é ela que amarra a sessão ao canal no CRM.
# Comece com UM só (o de menor volume) e ligue o segundo depois.
SESSOES=cobranca,comercial

PORTA=3000
DADOS_DIR=/dados

# De quanto em quanto tempo o serviço avisa ao CRM que está vivo.
# O CRM considera o canal fora do ar se este sinal parar (ver whatsapp_config).
HEARTBEAT_SEG=30

# Tempo sem novo lote de histórico para considerar a sincronização inicial
# encerrada. O WhatsApp não avisa de forma confiável que acabou.
SYNC_INATIVIDADE_SEG=180
