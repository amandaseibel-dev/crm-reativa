<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gateway do WhatsApp (Baileys) — piloto no Mac da Amanda.

  POR QUE ESTE AGENTE EXISTE: sem ele, qualquer queda do processo (reboot,
  kill, crash) deixa o numero da empresa FORA DO AR ate alguem perceber. O
  vigia no banco avisa a gestao, mas nao conserta. Aqui o launchd reergue.

  KeepAlive=true e proposital: sobe de novo mesmo em saida limpa (exit 0).
  O proprio servico encerra com exit(1) quando a porta ja esta ocupada; com
  ThrottleInterval de 10s o launchd tenta de novo ate a porta liberar, em vez
  de entrar em loop apertado.

  RunAtLoad=true faz subir no login. Nao ha "boot sem login" aqui: LaunchAgent
  roda na sessao do usuario. Se a maquina reiniciar e ninguem logar, o gateway
  NAO sobe -- limitacao conhecida do piloto em Mac.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>br.com.aelbra.whatsapp-gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--env-file=.env</string>
    <string>src/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/amandapradoseibel/Documents/crm-reativa-atual/services/whatsapp-gateway</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/amandapradoseibel/Library/Logs/whatsapp-gateway/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/amandapradoseibel/Library/Logs/whatsapp-gateway/gateway.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
