# Exemplo de variáveis de ambiente. NÃO coloque valores reais aqui.
# Copie para `.env` (ignorado pelo git) e preencha localmente.

# --- Frontend (Vite) — apenas chaves PÚBLICAS/publishable ---
# A anon/publishable key é segura para o navegador (respeita RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Somente server-side (scripts .cjs / ambiente do servidor) ---
# NUNCA exponha a service_role no frontend nem em variáveis VITE_*.
# A Edge Function recebe a service_role automaticamente pelo ambiente do
# Supabase (não precisa ser definida aqui).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
